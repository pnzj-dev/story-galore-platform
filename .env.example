# Credentials for the self-hosted Appwrite instance (MCP server "appwrite-vps").
# Copy to .env and fill in real values. .env is git-ignored.
# Values are read by mcp-server-appwrite via load_dotenv() from the project root.

# Appwrite project ID on the VPS instance
APPWRITE_PROJECT_ID=

# Appwrite API key (scoped narrowly) for the VPS instance
APPWRITE_API_KEY=

# Appwrite API endpoint for the VPS instance (trailing /v1)
# Example: https://appwrite.example.com/v1
APPWRITE_ENDPOINT=

# Public Appwrite config for the web app (browser-visible; NOT secret)
PUBLIC_APPWRITE_ENDPOINT=
PUBLIC_APPWRITE_PROJECT_ID=
