  "role_definitions": {
    "PLATFORM_ADMIN": "Privileged platform administration; still subject to explicit capability, scope, risk, approval, audit and data projection controls.",
    "SUPPORT": "Customer support operations; no automatic finance, moderation, security or global configuration access.",
    "MODERATOR": "Content and community moderation; no finance or infrastructure access.",
    "FINANCE": "Financial reporting and registered finance operations; high-risk changes require approval.",
    "ANALYTICS": "Aggregate analytics and reporting; no mutation or raw private content by default.",
    "SRE_OPS": "Reliability and infrastructure operations; no business-content decision authority by default.",
    "DISCOVERY": "Discovery and indexing operations.",
    "AI_OPERATIONS": "AI provider and job operations; no plaintext secrets or BYOK credentials.",
    "SECURITY_ABUSE": "Security and abuse investigation within explicitly approved scope.",
    "COMMUNITY": "Community operations and aggregate community analytics.",
    "CREATOR_SUPPORT": "Scoped creator assistance and support context."
  },
  "route_registry_complete": true,
  "route_registry_semantics": "Complete for all admin route paths currently declared in the V1 documentation. Any newly introduced /admin route must add an exact entry before implementation; dynamic parameters are canonicalized as :parameter. This registry does not imply that route files or runtime enforcement have been implemented.",
  "required_fields": [
    "route",
    "capability",
    "roles",
    "scope",
    "risk",
    "approval",
    "projection"
  ],
  "app_split": {
    "non_destructive_app": "apps/web",
    "non_destructive_surface": "/admin",
    "destructive_app": "apps/admin",
    "destructive_hosting": "fly_io_initial_then_private_intranet",
    "classification_contract": "contracts/admin/destructive-operations.yaml",
    "destructive_registry": "contracts/permissions/admin-rbac-admin-app.json",
    "selection_rule": "risk IN [HIGH, CRITICAL] AND approval == REQUIRED",
    "default": "NON_DESTRUCTIVE",
    "non_destructive_count": 45,
    "destructive_count": 8,
    "adr": "docs/adr/0018-admin-app-split.md"
  },
