---
import MinimalLayout from "@/layouts/MinimalLayout.astro";
import { actions } from "astro:actions";
import { getTranslations } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

const { t } = getTranslations(Astro.currentLocale);

const result = Astro.getActionResult(actions.forgotPassword);
const sent = Boolean(result?.data?.ok);
---

<MinimalLayout title={`${t("auth.resetPassword")} — StoryGalore`}>
  <div class="flex min-h-screen items-center justify-center px-4">
    <main class="w-full max-w-sm rounded-md border border-border bg-surface/60 p-8 shadow-xl">
      <a href="/" class="mb-6 inline-block text-lg font-bold tracking-tight">
        <span class="text-link">Story</span>Galore
      </a>
      <h1 class="font-serif text-2xl font-bold">{t("auth.resetPassword")}</h1>
      <p class="mt-1 text-sm text-foreground-muted">{t("auth.enterEmail")}</p>

      {
        sent ? (
          <p class="mt-6 rounded-sm border border-success bg-success/15 px-3 py-2 text-sm text-success">
            {t("auth.resetLinkSent")}
          </p>
        ) : (
          <form method="POST" action={actions.forgotPassword} class="mt-6 space-y-4">
            <div>
              <label for="email" class="mb-1 block text-sm text-foreground-muted">{t("auth.email")}</label>
              <input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            <button
              type="submit"
              class="w-full rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              {t("auth.sendResetLink")}
            </button>
          </form>
        )
      }

      <p class="mt-6 text-center text-sm text-foreground-muted">
        <a href={getRelativeLocaleUrl(Astro.currentLocale!, "auth/login")} class="text-link hover:text-link">{t("auth.backToSignIn")}</a>
      </p>
    </main>
  </div>
</MinimalLayout>
