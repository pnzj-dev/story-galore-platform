---
import MinimalLayout from "../../layouts/MinimalLayout.astro";
import { actions } from "astro:actions";

const userId = Astro.url.searchParams.get("userId") ?? "";
const secret = Astro.url.searchParams.get("secret") ?? "";

const result = Astro.getActionResult(actions.resetPassword);
const done = Boolean(result?.data?.ok);
const error = result?.error?.message;
---

<MinimalLayout title="Set new password — StoryGalore">
  <div class="flex min-h-screen items-center justify-center px-4">
    <main class="w-full max-w-sm rounded-md border border-border bg-surface/60 p-8 shadow-xl">
      <h1 class="font-serif text-2xl font-bold">Set a new password</h1>

      {
        done ? (
          <p class="mt-6 rounded-sm border border-success bg-success/15 px-3 py-2 text-sm text-success">
            Password updated. <a href="/auth/login" class="text-link">Sign in</a> with your new password.
          </p>
        ) : (
          <form method="POST" action={actions.resetPassword} class="mt-6 space-y-4">
            <input type="hidden" name="userId" value={userId} />
            <input type="hidden" name="secret" value={secret} />
            <div>
              <label for="password" class="mb-1 block text-sm text-foreground-muted">New password</label>
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                required
                minlength="8"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            {error && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {error}
              </p>
            )}
            <button
              type="submit"
              class="w-full rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              Update password
            </button>
          </form>
        )
      }
    </main>
  </div>
</MinimalLayout>
