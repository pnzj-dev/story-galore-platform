---
import Layout from "@/layouts/Layout.astro";
import { actions } from "astro:actions";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/auth/login");
}

const result = Astro.getActionResult(actions.createSupportTicket);
const submitted = Boolean(result?.data?.ok);
const error = result?.error?.message;
---

<Layout title={t("support.newRequest")}>
  <main class="mx-auto max-w-2xl px-12 py-12">
    <h1 class="font-serif text-3xl font-bold">{t("support.contact")}</h1>
    <p class="mt-2 text-foreground-muted">{t("support.tellUs")}</p>

    {
      submitted ? (
        <p class="mt-6 rounded-md border border-success bg-success/15 px-4 py-3 text-sm text-success">
          {t("support.submitted")}
        </p>
      ) : (
        <form method="POST" action={actions.createSupportTicket} class="mt-6 max-w-lg space-y-4">
          <div>
            <label for="subject" class="mb-1 block text-sm text-foreground-muted">{t("support.subject")}</label>
            <input
              id="subject"
              name="subject"
              type="text"
              required
              maxlength="255"
              class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
            />
          </div>
          <div>
            <label for="message" class="mb-1 block text-sm text-foreground-muted">{t("support.message")}</label>
            <textarea
              id="message"
              name="message"
              required
              maxlength="10000"
              rows="6"
              class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
            ></textarea>
          </div>
          {error && (
            <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
              {error}
            </p>
          )}
          <button
            type="submit"
            class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
          >
            {t("support.submit")}
          </button>
        </form>
      )
    }
  </main>
</Layout>
