---
import Layout from "@/layouts/Layout.astro";
import { fetchSupportTickets } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/auth/login");
}

const tickets = await fetchSupportTickets(user.$id);
---

<Layout title={t("support.requests")}>
  <main class="mx-auto max-w-2xl px-12 py-12">
    <div class="flex items-baseline justify-between">
      <h1 class="font-serif text-3xl font-bold">{t("support.requests")}</h1>
      <a
        href="/support/new"
        class="rounded-sm bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
      >
        {t("support.new")}
      </a>
    </div>

    {
      tickets.length > 0 ? (
        <ul class="mt-8 space-y-3">
          {tickets.map((tk) => (
            <li>
              <a
                href={`/support/tickets/${tk.$id}`}
                class="block rounded-md border border-border bg-surface p-4 transition hover:border-foreground-muted"
              >
                <div class="flex items-center justify-between gap-3">
                  <p class="font-semibold">{tk.subject}</p>
                  <span class="text-xs uppercase tracking-wide text-foreground-muted">{tk.status}</span>
                </div>
                {tk.createdAt && (
                  <p class="mt-1 text-xs text-foreground-tertiary">{new Date(tk.createdAt).toLocaleDateString()}</p>
                )}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-8 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
          {t("support.noRequests")}
        </p>
      )
    }
  </main>
</Layout>
