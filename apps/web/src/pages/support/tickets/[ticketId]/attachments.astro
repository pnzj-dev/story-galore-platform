---
import Layout from "@/layouts/Layout.astro";
import { fetchSupportTicket } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/auth/login");
}

const ticketId = Astro.params.ticketId ?? "";
const ticket = await fetchSupportTicket(user.$id, ticketId);
if (!ticket) {
  Astro.response.status = 404;
}
---

<Layout title={ticket ? `${t("support.attachments")} — ${ticket.subject}` : t("support.attachments")}>
  {
    ticket ? (
      <main class="mx-auto max-w-2xl px-6 py-12">
        <a href={`/support/tickets/${ticketId}`} class="text-sm text-link hover:text-link">{t("support.backToRequest")}</a>
        <h1 class="mt-4 font-serif text-3xl font-bold">{t("support.attachments")}</h1>
        <p class="mt-1 text-sm text-foreground-muted">
          {t("support.attachmentsDesc")} “{ticket.subject}”.
        </p>

        <section class="mt-8">
          <h2 class="text-xl font-semibold">{t("support.files")}</h2>
          <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
            {t("support.noAttachments")}
          </p>
        </section>
      </main>
    ) : (
      <main class="mx-auto max-w-3xl px-6 py-24 text-center">
        <h1 class="text-3xl font-bold">{t("support.notFound")}</h1>
        <a href="/support/tickets" class="mt-6 inline-block text-link">{t("support.backToSupport")}</a>
      </main>
    )
  }
</Layout>
