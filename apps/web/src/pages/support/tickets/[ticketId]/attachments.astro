---
import Layout from "@/layouts/Layout.astro";
import { fetchSupportTicket } from "@/lib/gateway";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/auth/login");
}

const ticketId = Astro.params.ticketId ?? "";
const ticket = await fetchSupportTicket(user.$id, ticketId);
if (!ticket) {
  Astro.response.status = 404;
}
---

<Layout title={ticket ? `Attachments — ${ticket.subject}` : "Attachments"}>
  {
    ticket ? (
      <main class="mx-auto max-w-2xl px-6 py-12">
        <a href={`/support/tickets/${ticketId}`} class="text-sm text-link hover:text-link">← Back to request</a>
        <h1 class="mt-4 font-serif text-3xl font-bold">Attachments</h1>
        <p class="mt-1 text-sm text-foreground-muted">
          Files attached to request “{ticket.subject}”.
        </p>

        <section class="mt-8">
          <h2 class="text-xl font-semibold">Files</h2>
          <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
            No attachments yet. Attachments for support requests are not enabled for this release.
          </p>
        </section>
      </main>
    ) : (
      <main class="mx-auto max-w-3xl px-6 py-24 text-center">
        <h1 class="text-3xl font-bold">Request not found</h1>
        <a href="/support/tickets" class="mt-6 inline-block text-link">Back to support</a>
      </main>
    )
  }
</Layout>
