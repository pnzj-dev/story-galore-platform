---
import Layout from "@/layouts/Layout.astro";
import { MediaRail } from "@storygalore/ui";
import DownloadsList from "@/components/DownloadsList.svelte";
import { fetchContinueItems } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/auth/login");
}

const continueItems = await fetchContinueItems(user.$id);

const downloadLabels = {
  downloads: t("library.downloads"),
  downloadsDesc: t("library.downloadsDesc"),
  noDownloads: t("library.noDownloads"),
  remove: t("library.remove"),
  pages: t("story.pages"),
};
---

<Layout title={t("library.title")}>
  <main class="mx-auto max-w-[1400px] px-12 py-12">
    <h1 class="font-serif text-3xl font-bold">{t("library.title")}</h1>
    <p class="mt-2 text-foreground-muted">{t("library.desc")}</p>

    <div class="mt-8">
      <MediaRail
        client:load
        title={t("library.continue")}
        items={continueItems}
        emptyHint={t("library.emptyHint")}
      />
    </div>

    <DownloadsList client:load labels={downloadLabels} />
  </main>
</Layout>
