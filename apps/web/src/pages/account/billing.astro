---
import Layout from "@/layouts/Layout.astro";
import { actions } from "astro:actions";
import { fetchPlans, fetchSubscriptions } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/auth/login");
}

const plans = await fetchPlans(user.$id);
const subscriptions = await fetchSubscriptions(user.$id);
---

<Layout title={t("account.billingTitle")}>
  <main class="mx-auto max-w-4xl px-6 py-12">
    <h1 class="font-serif text-3xl font-bold">{t("account.billingTitle")}</h1>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">{t("account.plans")}</h2>
      {
        plans.length === 0 ? (
          <p class="mt-2 text-sm text-foreground-muted">{t("account.noPlans")}</p>
        ) : (
          <div class="mt-4 flex flex-wrap gap-4">
            {plans.map((plan) => (
              <div class="flex min-w-0 flex-1 flex-col rounded-sm border border-border bg-surface p-4">
                <h3 class="font-semibold">{plan.name}</h3>
                {plan.description && <p class="mt-1 text-sm text-foreground-muted">{plan.description}</p>}
                <p class="mt-2 text-lg font-bold">
                  {((plan.amount ?? 0) / 100).toFixed(2)} {plan.currency}
                  <span class="text-sm font-normal text-foreground-muted">
                    {" "}
                    / {(plan.billingInterval ?? "month").toLowerCase()}
                  </span>
                </p>

                <form method="POST" action={actions.subscribe} class="mt-auto space-y-3 pt-4">
                  <input type="hidden" name="planId" value={plan.$id} />
                  <div>
                    <label for={`provider-${plan.$id}`} class="mb-1 block text-sm text-foreground-muted">
                      {t("account.payWith")}
                    </label>
                    <select
                      name="provider"
                      id={`provider-${plan.$id}`}
                      class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
                    >
                      <option value="STRIPE">{t("account.cardStripe")}</option>
                      <option value="NOWPAYMENTS">{t("account.cryptoNowPayments")}</option>
                    </select>
                  </div>
                  <button
                    type="submit"
                    class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
                  >
                    {t("account.subscribe")}
                  </button>
                </form>
              </div>
            ))}
          </div>
        )
      }
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">{t("account.yourSubscriptions")}</h2>
      {
        subscriptions.length === 0 ? (
          <p class="mt-2 text-sm text-foreground-muted">{t("account.noSubscriptions")}</p>
        ) : (
          <ul class="mt-4 space-y-3">
            {subscriptions.map((sub) => (
              <li class="rounded-sm border border-border bg-surface p-4">
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <div>
                    <p class="font-semibold">{sub.planId}</p>
                    <p class="text-sm text-foreground-muted">
                      {sub.provider} · {sub.billingStrategy} ·{" "}
                      <span class="font-medium">{sub.status}</span>
                    </p>
                  </div>
                  <div class="flex gap-2">
                    {sub.status === "ACTIVE" && (
                      <form method="POST" action={actions.pauseSubscription}>
                        <input type="hidden" name="subscriptionId" value={sub.$id} />
                        <button
                          type="submit"
                          class="rounded-sm border border-border px-3 py-1.5 text-sm transition hover:opacity-90"
                        >
                          {t("account.pause")}
                        </button>
                      </form>
                    )}
                    {sub.status === "PAUSED" && (
                      <form method="POST" action={actions.resumeSubscription}>
                        <input type="hidden" name="subscriptionId" value={sub.$id} />
                        <button
                          type="submit"
                          class="rounded-sm border border-border px-3 py-1.5 text-sm transition hover:opacity-90"
                        >
                          {t("account.resume")}
                        </button>
                      </form>
                    )}
                    {sub.status !== "CANCELLED" && sub.status !== "EXPIRED" && (
                      <form method="POST" action={actions.cancelSubscription}>
                        <input type="hidden" name="subscriptionId" value={sub.$id} />
                        <button
                          type="submit"
                          class="rounded-sm border border-danger px-3 py-1.5 text-sm text-danger transition hover:opacity-90"
                        >
                          {t("account.cancel")}
                        </button>
                      </form>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ul>
        )
      }
    </section>
  </main>
</Layout>
