---
import Layout from '../layouts/Layout.astro';

Astro.response.status = 404;
---

<Layout title="Not found">
  <main class="mx-auto max-w-3xl px-6 py-24 text-center">
    <h1 class="font-serif text-3xl font-bold">Not found</h1>
    <p class="mt-2 text-foreground-muted">This page could not be found.</p>
    <a href="/" class="mt-6 inline-block text-link">Back home</a>
  </main>
</Layout>
