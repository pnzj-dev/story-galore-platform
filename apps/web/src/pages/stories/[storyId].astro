---
import Layout from "@/layouts/Layout.astro";
import MediaDetail from "@/components/MediaDetail.astro";
import Comments from "@/components/Comments.svelte";
import { fetchPublication, fetchComments } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const storyId = Astro.params.storyId ?? "";
const actorId = Astro.locals.user?.$id ?? "";
const detail = storyId ? await fetchPublication(storyId, actorId) : null;
if (!detail) {
  Astro.response.status = 404;
}

const pub = detail?.publication;
const type = pub?.type ?? "BOOK";
const isBook = type === "BOOK";

const rating =
  pub?.contentRating && pub.contentRating !== "ALL_AGES"
    ? pub.contentRating === "ADULT_18_PLUS"
      ? t("studio.editor.rating.adult")
      : t("studio.editor.rating.teen")
    : null;

const comments = pub ? await fetchComments(actorId, "PUBLICATION", storyId) : [];
const commentLabels = {
  title: t("comments.title"),
  placeholder: t("comments.placeholder"),
  post: t("comments.post"),
  reply: t("comments.reply"),
  replyTo: t("comments.replyTo"),
  cancel: t("comments.cancel"),
  signIn: t("comments.signIn"),
  empty: t("comments.empty"),
  pending: t("comments.pending"),
};

function kindFor(t: string): "video" | "audio" | "post" {
  if (t === "VIDEO") return "video";
  if (t === "AUDIO") return "audio";
  return "post";
}
---

{
  isBook ? (
    <Layout title={pub?.title ?? "Story"}>
      {
        detail ? (
          <main>
            <div class="relative h-[340px] overflow-hidden">
              {detail.coverUrl && (
                <img src={detail.coverUrl} alt="" draggable="false" class="h-full w-full select-none object-cover" style="-webkit-user-drag: none;" />
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-transparent"></div>
            </div>

            <div class="mx-auto max-w-[1400px] px-12">
              <div class="-mt-24 grid gap-6 md:grid-cols-[200px_1fr]">
                <div class="hidden aspect-[2/3] overflow-hidden rounded-md border border-border shadow-lg md:block">
                  {detail.coverUrl ? (
                    <img src={detail.coverUrl} alt={pub!.title ?? ""} draggable="false" class="h-full w-full select-none object-cover" style="-webkit-user-drag: none;" />
                  ) : (
                    <div class="flex h-full items-center justify-center bg-surface text-3xl font-bold text-foreground-muted">
                      {(pub!.title ?? "?").charAt(0)}
                    </div>
                  )}
                </div>

                <div class="pt-28">
                  <h1 class="font-serif text-4xl font-bold leading-tight tracking-tight">{pub!.title}</h1>

                  <div class="mt-3 flex flex-wrap items-center gap-2 text-[13px] text-foreground-muted">
                    {rating && (
                      <span class="rounded-full border border-success px-2.5 py-0.5 text-[11px] font-semibold text-success">
                        {rating}
                      </span>
                    )}
                    {pub!.format && (
                      <span class="rounded-full border border-border bg-surface px-2.5 py-0.5 text-[11px] font-semibold">
                        {pub!.format.replace(/_/g, " ")}
                      </span>
                    )}
                    {detail.creatorName && <span>{detail.creatorName}</span>}
                  </div>

                  {pub!.description && (
                    <p class="mt-4 max-w-2xl text-sm leading-7 text-foreground-muted">{pub!.description}</p>
                  )}

                  <div class="mt-6">
                    {
                      detail.entitled ? (
                        <a
                          href={`/read/${storyId}`}
                          class="inline-flex items-center gap-2 rounded-sm bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
                        >
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M8 5v14l11-7z"></path>
                          </svg>
                          {t("media.readNow")}
                        </a>
                      ) : (
                        <div class="rounded-md border border-dashed border-border px-6 py-10 text-center">
                          <p class="text-lg font-semibold">{t("media.locked")}</p>
                          <a
                            href="/account/billing"
                            class="mt-4 inline-block rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
                          >
                            {t("media.viewPlans")}
                          </a>
                        </div>
                      )
                    }
                  </div>
                </div>
              </div>
            </div>

            <div class="mx-auto max-w-[1400px] px-12">
              <Comments
                client:load
                targetType="PUBLICATION"
                targetId={storyId}
                initialComments={comments}
                signedIn={Boolean(actorId)}
                labels={commentLabels}
              />
            </div>
          </main>
        ) : (
          <main class="mx-auto max-w-3xl px-6 py-24 text-center">
            <h1 class="text-3xl font-bold">{t("story.notFound")}</h1>
            <a href="/" class="mt-6 inline-block text-link">{t("story.backHome")}</a>
          </main>
        )
      }
    </Layout>
  ) : (
    <MediaDetail detail={detail} kind={kindFor(type)} title="Story" />
  )
}
