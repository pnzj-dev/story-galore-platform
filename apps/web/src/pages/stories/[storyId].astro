---
import Layout from "@/layouts/Layout.astro";
import MediaDetail from "@/components/MediaDetail.astro";
import Reader from "@/components/Reader.svelte";
import Comments from "@/components/Comments.svelte";
import { fetchPublication, fetchReaderManifest, fetchReadingPosition, fetchComments } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const storyId = Astro.params.storyId ?? "";
const actorId = Astro.locals.user?.$id ?? "";
const detail = storyId ? await fetchPublication(storyId, actorId) : null;
if (!detail) {
  Astro.response.status = 404;
}

const pub = detail?.publication;
const type = pub?.type ?? "BOOK";
const isBook = type === "BOOK";

// Books render the reader; everything else delegates to the media detail
// renderer for its type (video / audio / post+image).
const manifest = isBook && pub ? await fetchReaderManifest(storyId, actorId) : null;
const user = Astro.locals.user;
const initialPosition = user && manifest ? await fetchReadingPosition(user.$id, storyId) : 0;
const pages = (manifest?.pages ?? []).map((p) => ({
  url: p.url,
  text: p.text,
  position: p.position ?? 0,
}));

const comments = manifest ? await fetchComments(actorId, "PUBLICATION", storyId) : [];
const commentLabels = {
  title: t("comments.title"),
  placeholder: t("comments.placeholder"),
  post: t("comments.post"),
  reply: t("comments.reply"),
  replyTo: t("comments.replyTo"),
  cancel: t("comments.cancel"),
  signIn: t("comments.signIn"),
  empty: t("comments.empty"),
  pending: t("comments.pending"),
};

function kindFor(t: string): "video" | "audio" | "post" {
  if (t === "VIDEO") return "video";
  if (t === "AUDIO") return "audio";
  return "post";
}
---

{
  isBook ? (
    <Layout title={pub?.title ?? "Story"}>
      {
        manifest ? (
          <main class="mx-auto max-w-4xl px-6 py-12">
            <h1 class="font-serif text-4xl font-bold leading-tight tracking-tight">{pub!.title}</h1>
            <p class="mt-2 text-foreground-muted">
              {pub!.format ?? t("studio.type.book")} · {manifest.publication.readingFormat ?? t("story.readingFormat")} · {manifest.pages.length} {t("story.pages")}
            </p>
            {pages.length > 0 ? (
              <div class="mt-8">
                <Reader
                  client:load
                  publicationId={storyId}
                  pages={pages}
                  initialPosition={initialPosition}
                  canSync={Boolean(user)}
                />
              </div>
            ) : (
              <p class="mt-8 rounded-xl border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
                {t("story.noPages")}
              </p>
            )}

            <Comments
              client:load
              targetType="PUBLICATION"
              targetId={storyId}
              initialComments={comments}
              signedIn={Boolean(user)}
              labels={commentLabels}
            />
          </main>
        ) : (
          <main class="mx-auto max-w-3xl px-6 py-24 text-center">
            <h1 class="text-3xl font-bold">{t("story.notFound")}</h1>
            <a href="/" class="mt-6 inline-block text-link">{t("story.backHome")}</a>
          </main>
        )
      }
    </Layout>
  ) : (
    <MediaDetail detail={detail} kind={kindFor(type)} title="Story" />
  )
}
