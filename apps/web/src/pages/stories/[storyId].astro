---
import MediaDetail from "@/components/MediaDetail.astro";
import { fetchPublication } from "@/lib/gateway";

const storyId = Astro.params.storyId ?? "";
const detail = storyId ? await fetchPublication(storyId, Astro.locals.user?.$id ?? "") : null;
if (!detail) {
  Astro.response.status = 404;
}

function kindFor(t?: string): "video" | "audio" | "post" | "book" {
  if (t === "VIDEO") return "video";
  if (t === "AUDIO") return "audio";
  if (t === "BOOK") return "book";
  return "post";
}
---

<MediaDetail detail={detail} kind={kindFor(detail?.publication?.type)} title="Story" />
