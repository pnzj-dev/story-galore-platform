---
import Layout from "@/layouts/Layout.astro";
import ShortsPlayer from "@/components/ShortsPlayer.svelte";
import { fetchMediaByType } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const { items: shorts } = await fetchMediaByType("VIDEO", { format: "SHORT_FILM", limit: 100 });
const id = Astro.params.id ?? "";
---

<Layout title={t("media.shorts")}>
  {
    shorts.length > 0 ? (
      <ShortsPlayer client:load shorts={shorts} initialId={id} />
    ) : (
      <main class="px-6 py-24 text-center">
        <h1 class="text-2xl font-bold">{t("media.noShorts")}</h1>
        <a href="/" class="mt-4 inline-block text-link">{t("story.backHome")}</a>
      </main>
    )
  }
</Layout>
