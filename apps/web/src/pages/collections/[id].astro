---
import Layout from "@/layouts/Layout.astro";
import { MediaCard, mediaHref } from "@storygalore/ui";
import { fetchCollection, fetchCollectionItems } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const collectionId = Astro.params.id ?? "";
const actorId = Astro.locals.user?.$id ?? "";
const collection = collectionId ? await fetchCollection(actorId, collectionId) : null;
if (!collection) {
  Astro.response.status = 404;
}
const items = collection ? await fetchCollectionItems(actorId, collection) : [];
---

<Layout title={collection?.title ?? t("library.collections")}>
  {
    collection ? (
      <main class="mx-auto max-w-[1400px] px-12 py-12">
        <h1 class="font-serif text-3xl font-bold">{collection.title}</h1>
        {collection.description && (
          <p class="mt-2 max-w-2xl text-foreground-muted">{collection.description}</p>
        )}

        {
          items.length > 0 ? (
            <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
              {items.map((item) => (
                <MediaCard publication={item} href={mediaHref(item)} />
              ))}
            </div>
          ) : (
            <p class="mt-8 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
              {t("library.emptyCollection")}
            </p>
          )
        }
      </main>
    ) : (
      <main class="mx-auto max-w-3xl px-6 py-24 text-center">
        <h1 class="text-3xl font-bold">{t("story.notFound")}</h1>
        <a href="/" class="mt-6 inline-block text-link">{t("story.backHome")}</a>
      </main>
    )
  }
</Layout>
