---
import Layout from "../layouts/Layout.astro";
import { MediaRail, CreatorRail, GenreRail } from "@storygalore/ui";
import { fetchContinueItems, fetchPublications, fetchCreators, fetchAd } from "../lib/gateway";
import { GENRES } from "../lib/genres";

const title = "StoryGalore";
const description =
  "Read, watch, and listen to serialized stories from independent creators — books first, and every other medium too.";

const user = Astro.locals.user;
const continueItems = user ? await fetchContinueItems(user.$id) : [];
const continueEmptyHint = user
  ? "You have nothing in progress yet."
  : "Sign in to pick up right where you left off across all your devices.";

const trendingItems = await fetchPublications("trending");
const newItems = await fetchPublications("new");
const creatorItems = await fetchCreators();
const homeAd = await fetchAd("HOME_FEED_BETWEEN_RAILS", user?.$id ?? "");

function hrefFor(item: { id: string; type: string }): string {
  switch (item.type) {
    case "VIDEO":
      return `/watch/${item.id}`;
    case "AUDIO":
      return `/listen/${item.id}`;
    case "POST":
      return `/posts/${item.id}`;
    default:
      return `/read/${item.id}`;
  }
}

const featured = trendingItems.find((i) => i.type === "VIDEO") ?? trendingItems[0];
const featuredHref = featured ? hrefFor(featured) : "/discover";
const featuredRating =
  featured && featured.contentRating && featured.contentRating !== "ALL_AGES"
    ? featured.contentRating
    : null;
---

<Layout title={`${title} — Read. Create. Discover.`} description={description}>
  <main>
    <!-- Cinematic hero billboard -->
    {
      featured ? (
        <section class="relative h-[420px] overflow-hidden">
          <div
            class="absolute inset-0 bg-cover bg-[center_30%]"
            style={`background-image:url('${featured.coverUrl}')`}
          ></div>
          <div class="absolute inset-0 bg-gradient-to-r from-background via-background/75 to-background/10"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-background via-background/60 to-transparent"></div>

          <div class="relative z-10 flex h-full max-w-[1400px] items-end px-7 pb-12">
            <div class="max-w-[620px]">
              <span
                class="mb-4 inline-flex items-center gap-2 rounded-full bg-brand-500/15 px-2.5 py-1 text-[11px] font-bold uppercase tracking-widest text-brand-400"
              >
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"></path>
                </svg>
                Featured {featured.type === "VIDEO" ? "Film" : "Story"}
              </span>

              <h1 class="font-serif text-5xl font-bold leading-[1.05] tracking-tight">{featured.title}</h1>

              <div class="mt-4 flex flex-wrap items-center gap-3 text-[13px] text-foreground-muted">
                {featuredRating && (
                  <span class="rounded border border-border-strong px-1.5 py-0.5 text-[11px] font-semibold">
                    {featuredRating === "ADULT_18_PLUS" ? "18+" : featuredRating === "TEEN" ? "Teen" : featuredRating}
                  </span>
                )}
                {featured.format && <span>{featured.format.replace(/_/g, " ")}</span>}
                {featured.creatorName && (
                  <>
                    <span class="h-0.5 w-0.5 rounded-full bg-foreground-tertiary"></span>
                    <span>{featured.creatorName}</span>
                  </>
                )}
              </div>

              <p class="mt-4 max-w-[520px] text-sm leading-6 text-foreground-muted">{description}</p>

              <div class="mt-5 flex gap-3">
                <a
                  href={featuredHref}
                  class="inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 text-[13px] font-semibold text-primary-foreground transition hover:opacity-90"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"></path>
                  </svg>
                  Play
                </a>
                <a
                  href="/library"
                  class="inline-flex items-center gap-2 rounded-lg border border-border-strong bg-surface-raised px-5 py-3 text-[13px] font-semibold text-foreground transition hover:bg-surface"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12h14"></path>
                  </svg>
                  My List
                </a>
              </div>
            </div>
          </div>
        </section>
      ) : (
        <section class="border-b border-border">
          <div class="mx-auto max-w-[1400px] px-7 py-16">
            <h1 class="font-serif text-4xl font-bold tracking-tight">Stories that pull you in.</h1>
            <p class="mt-3 text-foreground-muted">{description}</p>
          </div>
        </section>
      )
    }

    <!-- Continue (resume) rail -->
    <section class="mx-auto max-w-[1400px] px-7 py-10">
      <MediaRail
        client:load
        title="Continue Watching"
        items={continueItems}
        emptyHint={continueEmptyHint}
      />
    </section>

    <!-- Discovery rails -->
    <section class="mx-auto max-w-[1400px] space-y-12 px-7 py-12">
      <MediaRail client:load title="Trending Now" items={trendingItems} emptyHint="Trending stories will appear here." />
      {homeAd?.url && (
        <div class="rounded-xl border border-border bg-surface/40 p-4">
          <span class="block pb-2 text-xs uppercase tracking-widest text-foreground-muted">Sponsored</span>
          <a href="#" class="block overflow-hidden rounded-lg border border-border">
            <img src={homeAd.url} alt={homeAd.name ?? "Sponsored"} class="h-32 w-full object-cover" />
          </a>
        </div>
      )}
      <MediaRail client:load title="New Series" items={newItems} emptyHint="New series will appear here." />
      <CreatorRail client:load title="Discover Creators" items={creatorItems} emptyHint="Creators will appear here." />
      <GenreRail title="Browse Genres" items={GENRES} />
    </section>
  </main>
</Layout>
