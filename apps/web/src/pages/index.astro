---
import Layout from "../layouts/Layout.astro";
import { MediaRail, ThemeToggle, CreatorRail, GenreRail } from "@storygalore/ui";
import { fetchContinueItems, fetchPublications, fetchCreators, fetchAd } from "../lib/gateway";
import { GENRES } from "../lib/genres";

const title = "StoryGalore";
const description =
  "Read, watch, and listen to serialized stories from independent creators — books first, and every other medium too.";

const user = Astro.locals.user;
const continueItems = user ? await fetchContinueItems(user.$id) : [];
const continueEmptyHint = user
  ? "You have nothing in progress yet."
  : "Sign in to pick up right where you left off across all your devices.";

const trendingItems = await fetchPublications("trending");
const newItems = await fetchPublications("new");
const creatorItems = await fetchCreators();
const homeAd = await fetchAd("HOME_FEED_BETWEEN_RAILS", user?.$id ?? "");
---

<Layout title={`${title} — Read. Create. Discover.`} description={description}>
  <!-- Global header -->
    <header class="sticky top-0 z-50 border-b border-border/60 bg-background/80 backdrop-blur">
      <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-6 py-4">
        <a href="/" class="text-lg font-bold tracking-tight">
          <span class="text-link">Story</span>Galore
        </a>
        <div class="hidden items-center gap-6 text-sm text-foreground-muted lg:flex">
          <a href="/" class="font-medium text-foreground" aria-current="page">For You</a>

          <details class="group relative">
            <summary class="cursor-pointer list-none transition hover:text-foreground">Books</summary>
            <div
              class="absolute start-0 top-full z-50 mt-2 w-48 rounded-lg border border-border bg-surface p-2 shadow-xl"
            >
              <a href="/books?format=comic" class="block rounded px-2 py-1.5 hover:bg-surface-elevated hover:text-foreground"
                >Comics</a
              >
              <a href="/books?format=manga" class="block rounded px-2 py-1.5 hover:bg-surface-elevated hover:text-foreground"
                >Manga</a
              >
              <a href="/books?format=manhwa" class="block rounded px-2 py-1.5 hover:bg-surface-elevated hover:text-foreground"
                >Manhwa</a
              >
              <a
                href="/books?format=bande-dessinee"
                class="block rounded px-2 py-1.5 hover:bg-surface-elevated hover:text-foreground">Bande Dessinée</a
              >
              <a href="/books?format=novel" class="block rounded px-2 py-1.5 hover:bg-surface-elevated hover:text-foreground"
                >Novels</a
              >
              <a
                href="/books"
                class="block rounded px-2 py-1.5 text-foreground-muted hover:bg-surface-elevated hover:text-foreground"
                >All books</a
              >
            </div>
          </details>

          <details class="group relative">
            <summary class="cursor-pointer list-none transition hover:text-foreground">Videos</summary>
            <div
              class="absolute start-0 top-full z-50 mt-2 w-48 rounded-lg border border-border bg-surface p-2 shadow-xl"
            >
              <a href="/videos?type=series" class="block rounded px-2 py-1.5 hover:bg-surface-elevated hover:text-foreground"
                >Series</a
              >
              <a href="/videos?type=movie" class="block rounded px-2 py-1.5 hover:bg-surface-elevated hover:text-foreground"
                >Movies</a
              >
              <a href="/shorts" class="block rounded px-2 py-1.5 hover:bg-surface-elevated hover:text-foreground">Shorts</a>
              <a
                href="/videos?type=documentary"
                class="block rounded px-2 py-1.5 hover:bg-surface-elevated hover:text-foreground">Documentaries</a
              >
              <a
                href="/videos"
                class="block rounded px-2 py-1.5 text-foreground-muted hover:bg-surface-elevated hover:text-foreground"
                >All videos</a
              >
            </div>
          </details>

          <a href="/images" class="transition hover:text-foreground">Art</a>
          <a href="/audio" class="transition hover:text-foreground">Audio</a>
          <a href="/creators" class="transition hover:text-foreground">Creators</a>
        </div>
        <div class="flex items-center gap-3">
          <ThemeToggle client:load />
          <a href="/auth/login" class="text-sm text-foreground-muted transition hover:text-foreground">Sign in</a>
          <a
            href="/auth/register"
            class="rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
          >
            Get started
          </a>
        </div>
      </nav>
    </header>

    <main>
      <!-- Cinematic featured hero -->
      <section class="relative overflow-hidden">
        <div class="mx-auto grid max-w-7xl items-center gap-12 px-6 py-20 md:grid-cols-2">
          <div class="space-y-6">
            <p class="text-sm font-medium uppercase tracking-widest text-link">Premium stories</p>
            <h1 class="text-4xl font-bold leading-tight tracking-tight md:text-6xl">
              Stories that pull you in.
            </h1>
            <p class="max-w-lg text-lg text-foreground-muted">{description}</p>
            <div class="flex flex-wrap gap-4">
              <a
                href="/auth/register"
                class="rounded-lg bg-primary px-6 py-3 font-semibold text-primary-foreground transition hover:opacity-90"
              >
                Start reading
              </a>
              <a
                href="/discover"
                class="rounded-lg border border-border px-6 py-3 font-semibold text-foreground transition hover:border-foreground-muted"
              >
                Explore
              </a>
            </div>
          </div>
          <div class="relative aspect-[4/5] overflow-hidden rounded-2xl border border-border bg-gradient-to-br from-primary/20 via-surface to-background">
            <div class="flex h-full items-center justify-center text-sm text-foreground-muted">Featured artwork</div>
          </div>
        </div>
      </section>

      <!-- Continue (resume) rail -->
      <section class="mx-auto max-w-7xl px-6 py-10">
        <MediaRail
          title="Continue where you left off"
          items={continueItems}
          emptyHint={continueEmptyHint}
        />
      </section>

      <!-- Value signals -->
      <section class="border-y border-border/60 bg-surface/40">
        <div class="mx-auto grid max-w-7xl gap-8 px-6 py-14 sm:grid-cols-2 md:grid-cols-4">
          <div>
            <h3 class="font-semibold text-foreground">Every medium</h3>
            <p class="mt-1 text-sm text-foreground-muted">Comics, art, video, and audio in one feed.</p>
          </div>
          <div>
            <h3 class="font-semibold text-foreground">Independent creators</h3>
            <p class="mt-1 text-sm text-foreground-muted">Support original worlds and voices.</p>
          </div>
          <div>
            <h3 class="font-semibold text-foreground">Read anywhere</h3>
            <p class="mt-1 text-sm text-foreground-muted">Web and offline, across devices.</p>
          </div>
          <div>
            <h3 class="font-semibold text-foreground">New worlds weekly</h3>
            <p class="mt-1 text-sm text-foreground-muted">Fresh series every week.</p>
          </div>
        </div>
      </section>

      <!-- Discovery rails -->
      <section class="mx-auto max-w-7xl space-y-12 px-6 py-12">
        <MediaRail title="Trending now" items={trendingItems} emptyHint="Trending stories will appear here." />
        {homeAd?.url && (
          <div class="rounded-xl border border-border bg-surface/40 p-4">
            <span class="block pb-2 text-xs uppercase tracking-widest text-foreground-muted">Sponsored</span>
            <a href="#" class="block overflow-hidden rounded-lg border border-border">
              <img src={homeAd.url} alt={homeAd.name ?? "Sponsored"} class="h-32 w-full object-cover" />
            </a>
          </div>
        )}
        <MediaRail title="New series" items={newItems} emptyHint="New series will appear here." />
        <CreatorRail title="Discover creators" items={creatorItems} emptyHint="Creators will appear here." />
        <GenreRail title="Browse genres" items={GENRES} />
      </section>
    </main>

    <!-- Footer -->
    <footer class="border-t border-border/60">
      <div
        class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-6 py-10 text-sm text-foreground-muted md:flex-row"
      >
        <p>© 2026 StoryGalore</p>
        <div class="flex gap-6">
          <a href="/help" class="transition hover:text-foreground-muted">Help</a>
          <a href="/support" class="transition hover:text-foreground-muted">Support</a>
          <a href="/settings" class="transition hover:text-foreground-muted">Settings</a>
        </div>
      </div>
    </footer>
</Layout>
