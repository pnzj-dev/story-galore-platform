---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Support">
  <main class="mx-auto max-w-3xl px-6 py-12">
    <h1 class="text-3xl font-bold">Support</h1>
    <p class="mt-2 text-foreground-muted">We&rsquo;re here to help.</p>

    <div class="mt-8 space-y-6">
      <p class="text-foreground-muted">
        For billing, account, or content questions, start with the
        <a href="/help" class="text-link">Help Center</a>. If you still need help, email us and
        include your account email and a short description.
      </p>

      <div class="rounded-xl border border-border bg-surface p-6">
        <p class="text-sm font-medium text-foreground-muted">Email support</p>
        <a
          href="mailto:support@story-galore.online"
          class="mt-1 inline-block text-lg font-semibold text-link"
        >
          support@story-galore.online
        </a>
      </div>

      <p class="text-sm text-foreground-muted">
        We typically reply within one business day. Support tickets are tracked in StoryGalore;
        engineering escalations map to tracked GitHub issues.
      </p>
    </div>
  </main>
</Layout>
