---
import Layout from "@/layouts/Layout.astro";
import { MediaCard } from "@storygalore/ui";
import type { MediaCardData } from "@storygalore/ui";
import { searchPublications } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);
const query = (Astro.url.searchParams.get("q") ?? "").trim();
const results = query ? await searchPublications(query) : [];

function hrefFor(item: MediaCardData): string {
  switch (item.type) {
    case "VIDEO":
      return `/watch/${item.id}`;
    case "AUDIO":
      return `/listen/${item.id}`;
    case "POST":
      return `/posts/${item.id}`;
    default:
      return `/read/${item.id}`;
  }
}
---

<Layout title={`${t("search.title")} — StoryGalore`}>
  <main class="mx-auto max-w-[1400px] px-12 py-12">
    <h1 class="font-serif text-3xl font-bold">{t("search.title")}</h1>
    <form method="GET" action="/search" class="mt-4 max-w-md">
      <input
        type="search"
        name="q"
        value={query}
        placeholder={t("search.placeholder")}
        class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
      />
    </form>

    {
      query ? (
        results.length > 0 ? (
          <>
            <p class="mt-6 text-sm text-foreground-muted">{t("search.resultsFor")} “{query}”.</p>
            <div class="mt-4 flex flex-wrap gap-4">
              {results.map((item) => (
                <MediaCard publication={item} href={hrefFor(item)} />
              ))}
            </div>
          </>
        ) : (
          <p class="mt-6 text-sm text-foreground-muted">{t("search.noResults")} “{query}”.</p>
        )
      ) : (
        <p class="mt-6 text-sm text-foreground-muted">{t("search.noQuery")}</p>
      )
    }
  </main>
</Layout>
