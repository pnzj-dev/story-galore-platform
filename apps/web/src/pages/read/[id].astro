---
import Layout from "@/layouts/Layout.astro";
import Reader from "@/components/Reader.svelte";
import { fetchReaderManifest, fetchReadingPosition } from "@/lib/gateway";

const publicationId = Astro.params.id ?? "";
const manifest = publicationId ? await fetchReaderManifest(publicationId, Astro.locals.user?.$id ?? "") : null;
if (!manifest) {
  Astro.response.status = 404;
}

const pub = manifest?.publication;
const user = Astro.locals.user;
const initialPosition = user && manifest ? await fetchReadingPosition(user.$id, publicationId) : 0;
const canSync = Boolean(user);
const pages = (manifest?.pages ?? []).map((p) => ({
  url: p.url,
  text: p.text,
  position: p.position ?? 0,
}));
---

<Layout title={pub?.title ?? "Reader"}>
  {manifest ? (
    <main class="mx-auto max-w-4xl px-6 py-12">
      <h1 class="font-serif text-4xl font-bold leading-tight tracking-tight">{pub!.title}</h1>
      <p class="mt-2 text-foreground-muted">
        {pub!.format ?? "Book"} · {pub!.readingFormat ?? "reading format"} · {manifest.pages.length} pages
      </p>

      {pages.length > 0 ? (
        <div class="mt-8">
          <Reader
            client:load
            publicationId={publicationId}
            pages={pages}
            initialPosition={initialPosition}
            canSync={canSync}
          />
        </div>
      ) : (
        <p class="mt-8 rounded-xl border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
          No pages yet.
        </p>
      )}
    </main>
  ) : (
    <main class="mx-auto max-w-3xl px-6 py-24 text-center">
      <h1 class="text-3xl font-bold">Publication not found</h1>
      <a href="/" class="mt-6 inline-block text-link">Back home</a>
    </main>
  )}
</Layout>
