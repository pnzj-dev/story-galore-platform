---
import Layout from "@/layouts/Layout.astro";
import Reader from "@/components/Reader.svelte";
import Comments from "@/components/Comments.svelte";
import { fetchReaderManifest, fetchReadingPosition, fetchComments, fetchDownloadPolicy } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const publicationId = Astro.params.id ?? "";
const manifest = publicationId ? await fetchReaderManifest(publicationId, Astro.locals.user?.$id ?? "") : null;
if (!manifest) {
  Astro.response.status = 404;
}

const pub = manifest?.publication;
const user = Astro.locals.user;
const initialPosition = user && manifest ? await fetchReadingPosition(user.$id, publicationId) : 0;
const canSync = Boolean(user);
const pages = (manifest?.pages ?? []).map((p) => ({
  url: p.url,
  text: p.text,
  position: p.position ?? 0,
}));

const comments = manifest
  ? await fetchComments(Astro.locals.user?.$id ?? "", "PUBLICATION", publicationId)
  : [];
const downloadPolicy = manifest
  ? await fetchDownloadPolicy(Astro.locals.user?.$id ?? "", publicationId)
  : null;
const commentLabels = {
  title: t("comments.title"),
  placeholder: t("comments.placeholder"),
  post: t("comments.post"),
  reply: t("comments.reply"),
  replyTo: t("comments.replyTo"),
  cancel: t("comments.cancel"),
  signIn: t("comments.signIn"),
  empty: t("comments.empty"),
  pending: t("comments.pending"),
};
---

<Layout title={pub?.title ?? t("media.reader")}>
  {manifest ? (
    <main class="mx-auto max-w-4xl px-6 py-12">
      <h1 class="font-serif text-4xl font-bold leading-tight tracking-tight">{pub!.title}</h1>
      <p class="mt-2 text-foreground-muted">
        {pub!.format ?? t("studio.type.book")} · {pub!.readingFormat ?? t("story.readingFormat")} · {manifest.pages.length} {t("story.pages")}
      </p>

      {pages.length > 0 ? (
        <div class="mt-8">
          <Reader
            client:load
            publicationId={publicationId}
            pages={pages}
            initialPosition={initialPosition}
            canSync={canSync}
            title={pub?.title ?? ""}
          />
        </div>
      ) : (
        <p class="mt-8 rounded-xl border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
          {t("story.noPages")}
        </p>
      )}

      {downloadPolicy?.canDownload && (
        <section class="mt-10">
          <h2 class="text-xl font-semibold">{t("download.title")}</h2>
          <p class="mt-1 text-sm text-foreground-muted">{t("download.desc")}</p>
          <div class="mt-4 flex flex-wrap gap-2">
            {downloadPolicy.formats?.includes("CBZ") && (
              <a
                href={`/export/${publicationId}/CBZ`}
                class="rounded-sm border border-border px-4 py-2 text-sm font-semibold transition hover:bg-surface"
              >
                {t("download.cbz")}
              </a>
            )}
            {downloadPolicy.formats?.includes("PDF") && (
              <a
                href={`/export/${publicationId}/PDF`}
                class="rounded-sm border border-border px-4 py-2 text-sm font-semibold transition hover:bg-surface"
              >
                {t("download.pdf")}
              </a>
            )}
          </div>
        </section>
      )}

      <Comments
        client:load
        targetType="PUBLICATION"
        targetId={publicationId}
        initialComments={comments}
        signedIn={canSync}
        labels={commentLabels}
      />
    </main>
  ) : (
    <main class="mx-auto max-w-3xl px-6 py-24 text-center">
      <h1 class="text-3xl font-bold">{t("story.notFound")}</h1>
      <a href="/" class="mt-6 inline-block text-link">{t("story.backHome")}</a>
    </main>
  )}
</Layout>
