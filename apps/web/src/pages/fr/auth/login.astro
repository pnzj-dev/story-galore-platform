---
import MinimalLayout from "@/layouts/MinimalLayout.astro";
import { ThemeToggle } from "@storygalore/ui";
import { actions } from "astro:actions";
import { safeReturnTo } from "@/lib/returnTo";
import { getTranslations } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

const { t } = getTranslations(Astro.currentLocale);

const returnTo = safeReturnTo(Astro.url.searchParams.get("returnTo"));
const result = Astro.getActionResult(actions.login);

if (result?.data?.ok) {
  return Astro.redirect(safeReturnTo(result.data.returnTo));
}

const error = result?.error?.message;
---

<MinimalLayout title={`${t("nav.signIn")} — StoryGalore`}>
  <div class="fixed end-4 top-4">
    <ThemeToggle client:load />
  </div>
  <div class="flex min-h-screen items-center justify-center px-4">
    <main class="w-full max-w-sm rounded-md border border-border bg-surface/60 p-8 shadow-xl">
      <a href="/" class="mb-6 inline-block text-lg font-bold tracking-tight">
        <span class="text-link">Story</span>Galore
      </a>
      <h1 class="font-serif text-2xl font-bold">{t("auth.welcomeBack")}</h1>
      <p class="mt-1 text-sm text-foreground-muted">{t("auth.signInPrompt")}</p>

      <form method="POST" action={actions.login} class="mt-6 space-y-4">
        <input type="hidden" name="returnTo" value={returnTo} />
        <div>
          <label for="email" class="mb-1 block text-sm text-foreground-muted">{t("auth.email")}</label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
          />
        </div>
        <div>
          <label for="password" class="mb-1 block text-sm text-foreground-muted">{t("auth.password")}</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="current-password"
            required
            minlength="8"
            class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
          />
        </div>

        {error && <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">{error}</p>}

        <button
          type="submit"
          class="w-full rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
        >
          {t("nav.signIn")}
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-foreground-muted">
        {t("auth.newHere")} <a href={getRelativeLocaleUrl(Astro.currentLocale!, "auth/register")} class="text-link hover:text-link">{t("auth.createAccount")}</a>
      </p>
    </main>
  </div>
</MinimalLayout>
