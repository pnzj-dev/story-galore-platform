---
import StudioLayout from "@/layouts/StudioLayout.astro";
import StudioProjectTabs from "@/components/StudioProjectTabs.astro";
import { actions } from "astro:actions";
import { fetchProject, fetchDocuments } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const user = Astro.locals.user;
const projectId = Astro.params.id ?? "";

if (!user) {
  return Astro.redirect("/login");
}

const project = await fetchProject(user.$id, projectId);
if (!project) {
  return Astro.redirect("/studio");
}

const documents = await fetchDocuments(user.$id, projectId);

const createResult = Astro.getActionResult(actions.createDocument);
if (createResult?.data?.ok) {
  return Astro.redirect(`/studio/projects/${projectId}`);
}
const createError = createResult?.error?.message;

const MEDIA_TYPES = [
  { value: "BOOK", label: t("studio.type.book") },
  { value: "POST", label: t("studio.type.post") },
  { value: "VIDEO", label: t("studio.type.video") },
  { value: "AUDIO", label: t("studio.type.audio") },
  { value: "MIXED", label: t("studio.type.mixed") },
];

const BOOK_FORMATS = [
  { value: "COMIC", label: t("studio.format.comic") },
  { value: "MANGA", label: t("studio.format.manga") },
  { value: "MANHWA", label: t("studio.format.manhwa") },
  { value: "MANHUA", label: t("studio.format.manhua") },
  { value: "BANDE_DESSINEE", label: t("studio.format.bandeDessinee") },
  { value: "GRAPHIC_NOVEL", label: t("studio.format.graphicNovel") },
  { value: "WEBTOON", label: t("studio.format.webtoon") },
  { value: "NOVEL", label: t("studio.format.novel") },
  { value: "LIGHT_NOVEL", label: t("studio.format.lightNovel") },
  { value: "NONFICTION", label: t("studio.format.nonfiction") },
  { value: "EDUCATIONAL", label: t("studio.format.educational") },
];
---

<StudioLayout title={project.name ?? t("studio.untitledProject")} active="projects">
  <main class="mx-auto max-w-5xl px-12 py-10">
    <a href="/studio/projects" class="text-sm text-foreground-muted transition hover:text-foreground">
      {t("studio.backToProjects")}
    </a>

    <header class="mt-4">
      <h1 class="text-3xl font-bold">{project.name ?? t("studio.untitledProject")}</h1>
      {project.description && <p class="mt-2 text-foreground-muted">{project.description}</p>}
      {project.status && <span class="mt-3 inline-block text-xs text-foreground-muted">{project.status}</span>}
    </header>

    <div class="mt-6">
      <StudioProjectTabs projectId={projectId} active="" />
    </div>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">{t("studio.newDocument")}</h2>
      <p class="mt-1 text-sm text-foreground-muted">
        {t("studio.newDocumentDesc")}
      </p>
      <form method="POST" action={actions.createDocument} class="mt-4 max-w-sm space-y-4">
        <input type="hidden" name="projectId" value={projectId} />
        <div>
          <label for="title" class="mb-1 block text-sm text-foreground-muted">{t("studio.field.title")}</label>
          <input
            id="title"
            name="title"
            type="text"
            required
            maxlength="200"
            class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
          />
        </div>
        <div>
          <label for="type" class="mb-1 block text-sm text-foreground-muted">{t("studio.field.type")}</label>
          <select
            id="type"
            name="type"
            class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
          >
            {MEDIA_TYPES.map((m) => <option value={m.value}>{m.label}</option>)}
          </select>
        </div>
        <div>
          <label for="format" class="mb-1 block text-sm text-foreground-muted">{t("studio.formatBooksOnly")}</label>
          <select
            id="format"
            name="format"
            class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
          >
            <option value="">—</option>
            {BOOK_FORMATS.map((f) => <option value={f.value}>{f.label}</option>)}
          </select>
        </div>

        {createError && (
          <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
            {createError}
          </p>
        )}

        <button
          type="submit"
          class="w-full rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
        >
          {t("studio.createDocument")}
        </button>
      </form>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">{t("studio.documents")}</h2>
      {documents.length > 0 ? (
        <ul class="mt-4 space-y-2">
          {documents.map((d) => (
            <li class="flex items-center justify-between rounded-sm border border-border bg-surface p-3">
              <a href={`/studio/projects/${projectId}/documents/${d.$id}`} class="min-w-0 flex-1">
                <p class="truncate font-medium text-foreground transition hover:text-primary">
                  {d.title || t("studio.untitled")}
                </p>
                {d.format && <p class="truncate text-sm text-foreground-muted">{d.format}</p>}
              </a>
              <span class="ml-4 shrink-0 text-xs text-foreground-muted">{d.type}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
          {t("studio.noDocuments")}
        </p>
      )}
    </section>
  </main>
</StudioLayout>
