---
import StudioLayout from "@/layouts/StudioLayout.astro";
import StudioProjectTabs from "@/components/StudioProjectTabs.astro";
import GenerationsList from "@/components/GenerationsList.svelte";
import { actions } from "astro:actions";
import { fetchProject, fetchStoryBible, fetchCharacters, fetchWorld, fetchAssets, fetchStudioPublications, fetchPromptTemplates, fetchGenerations, fetchCreatorAnalytics, fetchAiProviders, fetchDocuments } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/auth/login");
}

const projectId = Astro.params.id ?? "";
const tab = Astro.params.tab ?? "";

const project = await fetchProject(user.$id, projectId);
if (!project) {
  return Astro.redirect("/studio/projects");
}

const TITLES: Record<string, string> = {
  "story-bible": t("studio.tab.storyBible"),
  characters: t("studio.tab.characters"),
  world: t("studio.tab.world"),
  assets: t("studio.tab.assets"),
  prompts: t("studio.tab.prompts"),
  ai: t("studio.tab.ai"),
  drafts: t("studio.tab.drafts"),
  editor: t("studio.tab.editor"),
  publications: t("studio.tab.publications"),
  analytics: t("studio.tab.analytics"),
};

const title = TITLES[tab] ?? tab;

const storyBible = tab === "story-bible" ? await fetchStoryBible(user.$id, projectId) : null;
const characters = tab === "characters" ? await fetchCharacters(user.$id, projectId) : [];
const world = tab === "world" ? await fetchWorld(user.$id, projectId) : null;
const assets = tab === "assets" ? await fetchAssets(user.$id, projectId) : [];
const publications = tab === "publications" ? await fetchStudioPublications(user.$id, projectId) : [];
const promptTemplates = tab === "prompts" || tab === "ai" ? await fetchPromptTemplates(user.$id, projectId) : [];
const generations = tab === "ai" ? await fetchGenerations(user.$id, projectId) : [];
const analytics = tab === "analytics" ? await fetchCreatorAnalytics(user.$id) : null;
const providers = tab === "ai" ? await fetchAiProviders(user.$id) : [];
const creditProvider = providers.find((p) => p.creditEligible === true);
const documents = tab === "drafts" ? await fetchDocuments(user.$id, projectId) : [];

const bibleResult = Astro.getActionResult(actions.saveStoryBible);
if (bibleResult?.data?.ok) {
  return Astro.redirect(`/studio/projects/${projectId}/story-bible`);
}
const bibleError = bibleResult?.error?.message;

const characterResult = Astro.getActionResult(actions.createCharacter);
if (characterResult?.data?.ok) {
  return Astro.redirect(`/studio/projects/${projectId}/characters`);
}
const characterError = characterResult?.error?.message;

const worldResult = Astro.getActionResult(actions.saveWorld);
if (worldResult?.data?.ok) {
  return Astro.redirect(`/studio/projects/${projectId}/world`);
}
const worldError = worldResult?.error?.message;

const promptTemplateResult = Astro.getActionResult(actions.createPromptTemplate);
if (promptTemplateResult?.data?.ok) {
  return Astro.redirect(`/studio/projects/${projectId}/prompts`);
}
const promptTemplateError = promptTemplateResult?.error?.message;

const generationResult = Astro.getActionResult(actions.requestGeneration);
if (generationResult?.data?.ok) {
  return Astro.redirect(`/studio/projects/${projectId}/ai`);
}
const generationError = generationResult?.error?.message;

const documentResult = Astro.getActionResult(actions.createDocument);
if (documentResult?.data?.ok) {
  return Astro.redirect(`/studio/projects/${projectId}/drafts`);
}
const documentError = documentResult?.error?.message;
---

<StudioLayout title={`${project.name} — ${title}`} active="projects">
  <main class="mx-auto max-w-5xl px-12 py-10">
    <a href="/studio/projects" class="text-sm text-foreground-muted transition hover:text-foreground">
      {t("studio.backToProjects")}
    </a>
    <h1 class="mt-4 text-3xl font-bold">{project.name}</h1>

    <div class="mt-6">
      <StudioProjectTabs projectId={projectId} active={tab} />
    </div>

    {
      tab === "story-bible" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{t("studio.tab.storyBible")}</h2>
          <p class="mt-1 text-sm text-foreground-muted">
            {t("studio.bible.desc")}
          </p>
          <form method="POST" action={actions.saveStoryBible} class="mt-4 max-w-lg space-y-4">
            <input type="hidden" name="projectId" value={projectId} />
            <div>
              <label for="premise" class="mb-1 block text-sm text-foreground-muted">{t("studio.bible.premise")}</label>
              <textarea
                id="premise"
                name="premise"
                rows="3"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >{storyBible?.premise ?? ""}</textarea>
            </div>
            <div>
              <label for="themes" class="mb-1 block text-sm text-foreground-muted">{t("studio.bible.themes")}</label>
              <input
                id="themes"
                name="themes"
                type="text"
                value={storyBible?.themes ?? ""}
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            <div>
              <label for="tone" class="mb-1 block text-sm text-foreground-muted">{t("studio.bible.tone")}</label>
              <input
                id="tone"
                name="tone"
                type="text"
                value={storyBible?.tone ?? ""}
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            {bibleError && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {bibleError}
              </p>
            )}
            <button
              type="submit"
              class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              {t("studio.save")}
            </button>
          </form>
        </section>
      ) : tab === "characters" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{t("studio.tab.characters")}</h2>

          {
            characters.length > 0 ? (
              <ul class="mt-4 space-y-2">
                {characters.map((c) => (
                  <li class="rounded-md border border-border bg-surface p-4">
                    <p class="font-semibold">{c.name}</p>
                    {c.description && <p class="mt-1 text-sm text-foreground-muted">{c.description}</p>}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
                {t("studio.characters.none")}
              </p>
            )
          }

          <form method="POST" action={actions.createCharacter} class="mt-6 max-w-lg space-y-4">
            <input type="hidden" name="projectId" value={projectId} />
            <div>
              <label for="name" class="mb-1 block text-sm text-foreground-muted">{t("studio.field.name")}</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                maxlength="255"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            <div>
              <label for="description" class="mb-1 block text-sm text-foreground-muted">{t("studio.field.description")}</label>
              <textarea
                id="description"
                name="description"
                rows="3"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              ></textarea>
            </div>
            {characterError && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {characterError}
              </p>
            )}
            <button
              type="submit"
              class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              {t("studio.characters.add")}
            </button>
          </form>
        </section>
      ) : tab === "world" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{t("studio.tab.world")}</h2>
          <p class="mt-1 text-sm text-foreground-muted">{t("studio.world.desc")}</p>
          <form method="POST" action={actions.saveWorld} class="mt-4 max-w-lg space-y-4">
            <input type="hidden" name="projectId" value={projectId} />
            <div>
              <label for="wname" class="mb-1 block text-sm text-foreground-muted">{t("studio.field.name")}</label>
              <input
                id="wname"
                name="name"
                type="text"
                value={world?.name ?? ""}
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            <div>
              <label for="wdescription" class="mb-1 block text-sm text-foreground-muted">{t("studio.field.description")}</label>
              <textarea
                id="wdescription"
                name="description"
                rows="3"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >{world?.description ?? ""}</textarea>
            </div>
            <div>
              <label for="locations" class="mb-1 block text-sm text-foreground-muted">{t("studio.world.locations")}</label>
              <textarea
                id="locations"
                name="locations"
                rows="3"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >{world?.locations ?? ""}</textarea>
            </div>
            <div>
              <label for="rules" class="mb-1 block text-sm text-foreground-muted">{t("studio.world.rules")}</label>
              <textarea
                id="rules"
                name="rules"
                rows="3"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >{world?.rules ?? ""}</textarea>
            </div>
            {worldError && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {worldError}
              </p>
            )}
            <button
              type="submit"
              class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              {t("studio.save")}
            </button>
          </form>
        </section>
      ) : tab === "assets" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{t("studio.tab.assets")}</h2>
          {
            assets.length > 0 ? (
              <ul class="mt-4 space-y-2">
                {assets.map((a) => (
                  <li class="rounded-md border border-border bg-surface p-4">
                    <div class="flex items-center justify-between">
                      <p class="font-semibold">{a.label || a.role || t("studio.assets.default")}</p>
                      {a.role && <span class="text-xs text-foreground-muted">{a.role}</span>}
                    </div>
                    {a.mediaAssetId && <p class="mt-1 truncate text-xs text-foreground-tertiary">{a.mediaAssetId}</p>}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
                {t("studio.assets.none")}
              </p>
            )
          }
        </section>
      ) : tab === "publications" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{t("studio.tab.publications")}</h2>
          {
            publications.length > 0 ? (
              <ul class="mt-4 space-y-2">
                {publications.map((p) => (
                  <li class="flex items-center justify-between rounded-md border border-border bg-surface p-4">
                    <div class="min-w-0 flex-1">
                      <p class="truncate font-semibold">{p.title || t("studio.untitled")}</p>
                      {p.format && <p class="truncate text-sm text-foreground-muted">{p.format}</p>}
                    </div>
                    <span class="ml-4 shrink-0 text-xs text-foreground-muted">{p.status}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
                {t("studio.publications.none")}
              </p>
            )
          }
        </section>
      ) : tab === "prompts" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{t("studio.prompts.title")}</h2>
          <p class="mt-1 text-sm text-foreground-muted">{t("studio.prompts.desc")}</p>

          {
            promptTemplates.length > 0 ? (
              <ul class="mt-4 space-y-2">
                {promptTemplates.map((pt) => (
                  <li class="rounded-md border border-border bg-surface p-4">
                    <p class="font-semibold">{pt.name}</p>
                    <p class="mt-1 whitespace-pre-wrap text-sm text-foreground-muted">{pt.template}</p>
                    {pt.variables && pt.variables.length > 0 && (
                      <p class="mt-2 text-xs text-foreground-tertiary">{t("studio.prompts.variables")}: {pt.variables.join(", ")}</p>
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
                {t("studio.prompts.none")}
              </p>
            )
          }

          <form method="POST" action={actions.createPromptTemplate} class="mt-6 max-w-lg space-y-4">
            <input type="hidden" name="projectId" value={projectId} />
            <div>
              <label for="pname" class="mb-1 block text-sm text-foreground-muted">{t("studio.field.name")}</label>
              <input
                id="pname"
                name="name"
                type="text"
                required
                maxlength="255"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            <div>
              <label for="ptemplate" class="mb-1 block text-sm text-foreground-muted">{t("studio.prompts.template")}</label>
              <textarea
                id="ptemplate"
                name="template"
                rows="3"
                required
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              ></textarea>
            </div>
            <div>
              <label for="pvariables" class="mb-1 block text-sm text-foreground-muted">{t("studio.prompts.variablesField")}</label>
              <input
                id="pvariables"
                name="variables"
                type="text"
                placeholder="character, setting, tone"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            {promptTemplateError && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {promptTemplateError}
              </p>
            )}
            <button
              type="submit"
              class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              {t("studio.prompts.add")}
            </button>
          </form>
        </section>
      ) : tab === "ai" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{t("studio.tab.ai")}</h2>
          <p class="mt-1 text-sm text-foreground-muted">
            {t("studio.ai.desc")}
          </p>

          {creditProvider ? (
            <p class="mt-3 inline-block rounded-md border border-border bg-surface px-3 py-2 text-sm text-foreground-muted">
              {creditProvider.displayName ?? creditProvider.providerId}: {creditProvider.creditCost ?? 1} {t("studio.ai.creditsPerGen")}
            </p>
          ) : (
            <p class="mt-3 inline-block rounded-md border border-dashed border-border px-3 py-2 text-sm text-foreground-muted">
              {t("studio.ai.noProvider")}
            </p>
          )}

          <form method="POST" action={actions.requestGeneration} class="mt-4 max-w-lg space-y-4">
            <input type="hidden" name="projectId" value={projectId} />
            <div>
              <label for="gtarget" class="mb-1 block text-sm text-foreground-muted">{t("studio.ai.targetType")}</label>
              <select
                id="gtarget"
                name="targetType"
                required
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >
                <option value="PAGE">{t("studio.ai.target.page")}</option>
                <option value="PANEL">{t("studio.ai.target.panel")}</option>
                <option value="IMAGE">{t("studio.ai.target.image")}</option>
                <option value="CHARACTER">{t("studio.ai.target.character")}</option>
                <option value="BACKGROUND">{t("studio.ai.target.background")}</option>
                <option value="DIALOGUE">{t("studio.ai.target.dialogue")}</option>
                <option value="STORY_TEXT">{t("studio.ai.target.storyText")}</option>
                <option value="VIDEO">{t("studio.ai.target.video")}</option>
              </select>
            </div>
            <div>
              <label for="gbilling" class="mb-1 block text-sm text-foreground-muted">{t("studio.ai.billingMode")}</label>
              <select
                id="gbilling"
                name="billingMode"
                required
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >
                <option value="PLATFORM_CREDITS">{t("studio.ai.billing.platformCredits")}</option>
                <option value="BYOK">{t("studio.ai.billing.byok")}</option>
                <option value="USER_HOSTED">{t("studio.ai.billing.userHosted")}</option>
              </select>
            </div>
            <div>
              <label for="glocation" class="mb-1 block text-sm text-foreground-muted">{t("studio.ai.execLocation")}</label>
              <select
                id="glocation"
                name="executionLocation"
                required
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >
                <option value="CLOUD">{t("studio.ai.location.cloud")}</option>
                <option value="USER_HOSTED">{t("studio.ai.location.userHosted")}</option>
              </select>
            </div>
            <div>
              <label for="gprompt" class="mb-1 block text-sm text-foreground-muted">{t("studio.ai.prompt")}</label>
              <textarea
                id="gprompt"
                name="prompt"
                rows="4"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              ></textarea>
            </div>
            <div>
              <label for="gtemplate" class="mb-1 block text-sm text-foreground-muted">{t("studio.ai.promptTemplate")}</label>
              <select
                id="gtemplate"
                name="promptTemplateId"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >
                <option value="">{t("studio.none")}</option>
                {promptTemplates.map((t) => (
                  <option value={t.$id || t.id}>{t.name}</option>
                ))}
              </select>
            </div>
            <div>
              <p class="mb-2 text-xs font-semibold uppercase tracking-wide text-foreground-muted">{t("studio.ai.videoOptions")}</p>
              <div class="grid grid-cols-3 gap-3">
                <div>
                  <label for="gduration" class="mb-1 block text-sm text-foreground-muted">{t("studio.ai.duration")}</label>
                  <input
                    id="gduration"
                    name="duration"
                    type="number"
                    min="1"
                    max="15"
                    placeholder="5"
                    class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
                  />
                </div>
                <div>
                  <label for="gresolution" class="mb-1 block text-sm text-foreground-muted">{t("studio.ai.resolution")}</label>
                  <select
                    id="gresolution"
                    name="resolution"
                    class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
                  >
                    <option value="">—</option>
                    <option value="480p">480p</option>
                    <option value="720p">720p</option>
                  </select>
                </div>
                <div>
                  <label for="gaspect" class="mb-1 block text-sm text-foreground-muted">{t("studio.ai.aspect")}</label>
                  <select
                    id="gaspect"
                    name="aspectRatio"
                    class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
                  >
                    <option value="">—</option>
                    <option value="16:9">16:9</option>
                    <option value="9:16">9:16</option>
                    <option value="1:1">1:1</option>
                    <option value="4:3">4:3</option>
                    <option value="3:4">3:4</option>
                    <option value="3:2">3:2</option>
                    <option value="2:3">2:3</option>
                  </select>
                </div>
              </div>
            </div>
            {generationError && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {generationError}
              </p>
            )}
            <button
              type="submit"
              class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              {t("studio.ai.submit")}
            </button>
          </form>

          <h3 class="mt-10 text-lg font-semibold">{t("studio.ai.requests")}</h3>
          <GenerationsList
            client:load
            projectId={projectId}
            initial={generations}
            labels={{ none: t("studio.ai.none"), credits: t("studio.ai.credits"), ineligible: t("studio.ai.ineligible") }}
          />
        </section>
      ) : tab === "analytics" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{t("studio.tab.analytics")}</h2>
          <p class="mt-1 text-sm text-foreground-muted">{t("studio.analytics.desc")}</p>

          <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3">
            <div class="rounded-md border border-border bg-surface p-4">
              <p class="text-2xl font-bold">{analytics?.projects ?? 0}</p>
              <p class="text-sm text-foreground-muted">{t("studio.nav.projects")}</p>
            </div>
            <div class="rounded-md border border-border bg-surface p-4">
              <p class="text-2xl font-bold">{analytics?.documents ?? 0}</p>
              <p class="text-sm text-foreground-muted">{t("studio.documents")}</p>
            </div>
            <div class="rounded-md border border-border bg-surface p-4">
              <p class="text-2xl font-bold">{analytics?.promptTemplates ?? 0}</p>
              <p class="text-sm text-foreground-muted">{t("studio.prompts.title")}</p>
            </div>
            <div class="rounded-md border border-border bg-surface p-4">
              <p class="text-2xl font-bold">{analytics?.generationTotal ?? 0}</p>
              <p class="text-sm text-foreground-muted">{t("studio.analytics.generations")}</p>
            </div>
            <div class="rounded-md border border-border bg-surface p-4">
              <p class="text-2xl font-bold">{analytics?.generationCreditEligible ?? 0}</p>
              <p class="text-sm text-foreground-muted">{t("studio.analytics.creditEligible")}</p>
            </div>
          </div>

          {analytics?.generationsByBilling ? (
            <div class="mt-6">
              <h3 class="text-lg font-semibold">{t("studio.analytics.byBilling")}</h3>
              <ul class="mt-3 space-y-2">
                {Object.entries(analytics.generationsByBilling).map(([mode, count]) => (
                  <li class="flex items-center justify-between rounded-md border border-border bg-surface p-3">
                    <span class="text-sm">{mode}</span>
                    <span class="text-sm font-semibold">{count}</span>
                  </li>
                ))}
              </ul>
            </div>
          ) : null}
        </section>
      ) : tab === "drafts" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{t("studio.tab.drafts")}</h2>
          <p class="mt-1 text-sm text-foreground-muted">{t("studio.drafts.desc")}</p>

          {
            documents.length > 0 ? (
              <ul class="mt-4 space-y-2">
                {documents.map((d) => (
                  <li class="flex items-center justify-between rounded-md border border-border bg-surface p-4">
                    <div class="min-w-0 flex-1">
                      <p class="truncate font-semibold">{d.title || t("studio.untitled")}</p>
                      <p class="truncate text-sm text-foreground-muted">{d.type}{d.format ? ` · ${d.format}` : ""}</p>
                    </div>
                    <a
                      href={`/studio/projects/${projectId}/documents/${d.$id}`}
                      class="ml-4 shrink-0 rounded-sm border border-border px-3 py-1.5 text-sm transition hover:bg-surface"
                    >
                      {t("studio.drafts.openEditor")}
                    </a>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
                {t("studio.drafts.none")}
              </p>
            )
          }

          <form method="POST" action={actions.createDocument} class="mt-6 max-w-lg space-y-4">
            <input type="hidden" name="projectId" value={projectId} />
            <div>
              <label for="dtitle" class="mb-1 block text-sm text-foreground-muted">{t("studio.field.title")}</label>
              <input
                id="dtitle"
                name="title"
                type="text"
                maxlength="255"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            <div>
              <label for="dtype" class="mb-1 block text-sm text-foreground-muted">{t("studio.field.type")}</label>
              <select
                id="dtype"
                name="type"
                required
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >
                <option value="BOOK">{t("studio.type.book")}</option>
                <option value="POST">{t("studio.type.post")}</option>
                <option value="VIDEO">{t("studio.type.video")}</option>
                <option value="AUDIO">{t("studio.type.audio")}</option>
                <option value="MIXED">{t("studio.type.mixed")}</option>
              </select>
            </div>
            {documentError && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {documentError}
              </p>
            )}
            <button
              type="submit"
              class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              {t("studio.drafts.new")}
            </button>
          </form>
        </section>
      ) : (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{title}</h2>
          <p class="mt-4 rounded-md border border-dashed border-border px-6 py-10 text-sm text-foreground-muted">
            {t("studio.comingSoon")}
          </p>
        </section>
      )
    }
  </main>
</StudioLayout>
