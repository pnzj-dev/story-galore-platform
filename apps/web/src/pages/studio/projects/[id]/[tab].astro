---
import StudioLayout from "@/layouts/StudioLayout.astro";
import StudioProjectTabs from "@/components/StudioProjectTabs.astro";
import { actions } from "astro:actions";
import { fetchProject, fetchStoryBible, fetchCharacters, fetchWorld, fetchAssets, fetchStudioPublications, fetchPromptTemplates, fetchGenerations, fetchCreatorAnalytics, fetchAiProviders } from "@/lib/gateway";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/auth/login");
}

const projectId = Astro.params.id ?? "";
const tab = Astro.params.tab ?? "";

const project = await fetchProject(user.$id, projectId);
if (!project) {
  return Astro.redirect("/studio/projects");
}

const TITLES: Record<string, string> = {
  "story-bible": "Story Bible",
  characters: "Characters",
  world: "World",
  assets: "Assets",
  prompts: "Prompts",
  ai: "AI",
  drafts: "Drafts",
  editor: "Editor",
  publications: "Publications",
  analytics: "Analytics",
};

const title = TITLES[tab] ?? tab;

const storyBible = tab === "story-bible" ? await fetchStoryBible(user.$id, projectId) : null;
const characters = tab === "characters" ? await fetchCharacters(user.$id, projectId) : [];
const world = tab === "world" ? await fetchWorld(user.$id, projectId) : null;
const assets = tab === "assets" ? await fetchAssets(user.$id, projectId) : [];
const publications = tab === "publications" ? await fetchStudioPublications(user.$id, projectId) : [];
const promptTemplates = tab === "prompts" || tab === "ai" ? await fetchPromptTemplates(user.$id, projectId) : [];
const generations = tab === "ai" ? await fetchGenerations(user.$id, projectId) : [];
const analytics = tab === "analytics" ? await fetchCreatorAnalytics(user.$id) : null;
const providers = tab === "ai" ? await fetchAiProviders(user.$id) : [];
const creditProvider = providers.find((p) => p.creditEligible === true);

const bibleResult = Astro.getActionResult(actions.saveStoryBible);
if (bibleResult?.data?.ok) {
  return Astro.redirect(`/studio/projects/${projectId}/story-bible`);
}
const bibleError = bibleResult?.error?.message;

const characterResult = Astro.getActionResult(actions.createCharacter);
if (characterResult?.data?.ok) {
  return Astro.redirect(`/studio/projects/${projectId}/characters`);
}
const characterError = characterResult?.error?.message;

const worldResult = Astro.getActionResult(actions.saveWorld);
if (worldResult?.data?.ok) {
  return Astro.redirect(`/studio/projects/${projectId}/world`);
}
const worldError = worldResult?.error?.message;

const promptTemplateResult = Astro.getActionResult(actions.createPromptTemplate);
if (promptTemplateResult?.data?.ok) {
  return Astro.redirect(`/studio/projects/${projectId}/prompts`);
}
const promptTemplateError = promptTemplateResult?.error?.message;

const generationResult = Astro.getActionResult(actions.requestGeneration);
if (generationResult?.data?.ok) {
  return Astro.redirect(`/studio/projects/${projectId}/ai`);
}
const generationError = generationResult?.error?.message;
---

<StudioLayout title={`${project.name} — ${title}`} active="projects">
  <main class="mx-auto max-w-5xl px-12 py-10">
    <a href="/studio/projects" class="text-sm text-foreground-muted transition hover:text-foreground">
      &larr; Projects
    </a>
    <h1 class="mt-4 text-3xl font-bold">{project.name}</h1>

    <div class="mt-6">
      <StudioProjectTabs projectId={projectId} active={tab} />
    </div>

    {
      tab === "story-bible" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">Story Bible</h2>
          <p class="mt-1 text-sm text-foreground-muted">
            Capture the premise, themes, and tone that anchor this project.
          </p>
          <form method="POST" action={actions.saveStoryBible} class="mt-4 max-w-lg space-y-4">
            <input type="hidden" name="projectId" value={projectId} />
            <div>
              <label for="premise" class="mb-1 block text-sm text-foreground-muted">Premise</label>
              <textarea
                id="premise"
                name="premise"
                rows="3"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >{storyBible?.premise ?? ""}</textarea>
            </div>
            <div>
              <label for="themes" class="mb-1 block text-sm text-foreground-muted">Themes</label>
              <input
                id="themes"
                name="themes"
                type="text"
                value={storyBible?.themes ?? ""}
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            <div>
              <label for="tone" class="mb-1 block text-sm text-foreground-muted">Tone</label>
              <input
                id="tone"
                name="tone"
                type="text"
                value={storyBible?.tone ?? ""}
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            {bibleError && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {bibleError}
              </p>
            )}
            <button
              type="submit"
              class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              Save
            </button>
          </form>
        </section>
      ) : tab === "characters" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">Characters</h2>

          {
            characters.length > 0 ? (
              <ul class="mt-4 space-y-2">
                {characters.map((c) => (
                  <li class="rounded-md border border-border bg-surface p-4">
                    <p class="font-semibold">{c.name}</p>
                    {c.description && <p class="mt-1 text-sm text-foreground-muted">{c.description}</p>}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
                No characters yet.
              </p>
            )
          }

          <form method="POST" action={actions.createCharacter} class="mt-6 max-w-lg space-y-4">
            <input type="hidden" name="projectId" value={projectId} />
            <div>
              <label for="name" class="mb-1 block text-sm text-foreground-muted">Name</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                maxlength="255"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            <div>
              <label for="description" class="mb-1 block text-sm text-foreground-muted">Description</label>
              <textarea
                id="description"
                name="description"
                rows="3"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              ></textarea>
            </div>
            {characterError && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {characterError}
              </p>
            )}
            <button
              type="submit"
              class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              Add character
            </button>
          </form>
        </section>
      ) : tab === "world" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">World</h2>
          <p class="mt-1 text-sm text-foreground-muted">Describe the setting, locations, and rules of your world.</p>
          <form method="POST" action={actions.saveWorld} class="mt-4 max-w-lg space-y-4">
            <input type="hidden" name="projectId" value={projectId} />
            <div>
              <label for="wname" class="mb-1 block text-sm text-foreground-muted">Name</label>
              <input
                id="wname"
                name="name"
                type="text"
                value={world?.name ?? ""}
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            <div>
              <label for="wdescription" class="mb-1 block text-sm text-foreground-muted">Description</label>
              <textarea
                id="wdescription"
                name="description"
                rows="3"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >{world?.description ?? ""}</textarea>
            </div>
            <div>
              <label for="locations" class="mb-1 block text-sm text-foreground-muted">Locations</label>
              <textarea
                id="locations"
                name="locations"
                rows="3"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >{world?.locations ?? ""}</textarea>
            </div>
            <div>
              <label for="rules" class="mb-1 block text-sm text-foreground-muted">Rules</label>
              <textarea
                id="rules"
                name="rules"
                rows="3"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >{world?.rules ?? ""}</textarea>
            </div>
            {worldError && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {worldError}
              </p>
            )}
            <button
              type="submit"
              class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              Save
            </button>
          </form>
        </section>
      ) : tab === "assets" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">Assets</h2>
          {
            assets.length > 0 ? (
              <ul class="mt-4 space-y-2">
                {assets.map((a) => (
                  <li class="rounded-md border border-border bg-surface p-4">
                    <div class="flex items-center justify-between">
                      <p class="font-semibold">{a.label || a.role || "Asset"}</p>
                      {a.role && <span class="text-xs text-foreground-muted">{a.role}</span>}
                    </div>
                    {a.mediaAssetId && <p class="mt-1 truncate text-xs text-foreground-tertiary">{a.mediaAssetId}</p>}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
                No assets yet.
              </p>
            )
          }
        </section>
      ) : tab === "publications" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">Publications</h2>
          {
            publications.length > 0 ? (
              <ul class="mt-4 space-y-2">
                {publications.map((p) => (
                  <li class="flex items-center justify-between rounded-md border border-border bg-surface p-4">
                    <div class="min-w-0 flex-1">
                      <p class="truncate font-semibold">{p.title || "Untitled"}</p>
                      {p.format && <p class="truncate text-sm text-foreground-muted">{p.format}</p>}
                    </div>
                    <span class="ml-4 shrink-0 text-xs text-foreground-muted">{p.status}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
                No publications yet.
              </p>
            )
          }
        </section>
      ) : tab === "prompts" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">Prompt templates</h2>
          <p class="mt-1 text-sm text-foreground-muted">Reusable prompts for AI generation, scoped to this project.</p>

          {
            promptTemplates.length > 0 ? (
              <ul class="mt-4 space-y-2">
                {promptTemplates.map((t) => (
                  <li class="rounded-md border border-border bg-surface p-4">
                    <p class="font-semibold">{t.name}</p>
                    <p class="mt-1 whitespace-pre-wrap text-sm text-foreground-muted">{t.template}</p>
                    {t.variables && t.variables.length > 0 && (
                      <p class="mt-2 text-xs text-foreground-tertiary">Variables: {t.variables.join(", ")}</p>
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
                No prompt templates yet.
              </p>
            )
          }

          <form method="POST" action={actions.createPromptTemplate} class="mt-6 max-w-lg space-y-4">
            <input type="hidden" name="projectId" value={projectId} />
            <div>
              <label for="pname" class="mb-1 block text-sm text-foreground-muted">Name</label>
              <input
                id="pname"
                name="name"
                type="text"
                required
                maxlength="255"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            <div>
              <label for="ptemplate" class="mb-1 block text-sm text-foreground-muted">Template</label>
              <textarea
                id="ptemplate"
                name="template"
                rows="3"
                required
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              ></textarea>
            </div>
            <div>
              <label for="pvariables" class="mb-1 block text-sm text-foreground-muted">Variables (comma-separated)</label>
              <input
                id="pvariables"
                name="variables"
                type="text"
                placeholder="character, setting, tone"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            {promptTemplateError && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {promptTemplateError}
              </p>
            )}
            <button
              type="submit"
              class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              Add template
            </button>
          </form>
        </section>
      ) : tab === "ai" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">AI generation</h2>
          <p class="mt-1 text-sm text-foreground-muted">
            Submit a generation request. Credit eligibility is decided server-side; BYOK and user-hosted runs are never credit-eligible.
          </p>

          {creditProvider ? (
            <p class="mt-3 inline-block rounded-md border border-border bg-surface px-3 py-2 text-sm text-foreground-muted">
              {creditProvider.displayName ?? creditProvider.providerId}: {creditProvider.creditCost ?? 1} credit(s) per generation
            </p>
          ) : (
            <p class="mt-3 inline-block rounded-md border border-dashed border-border px-3 py-2 text-sm text-foreground-muted">
              No credit-eligible provider registered yet.
            </p>
          )}

          <form method="POST" action={actions.requestGeneration} class="mt-4 max-w-lg space-y-4">
            <input type="hidden" name="projectId" value={projectId} />
            <div>
              <label for="gtarget" class="mb-1 block text-sm text-foreground-muted">Target type</label>
              <select
                id="gtarget"
                name="targetType"
                required
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >
                <option value="PAGE">Page</option>
                <option value="PANEL">Panel</option>
                <option value="IMAGE">Image</option>
                <option value="CHARACTER">Character</option>
                <option value="BACKGROUND">Background</option>
                <option value="DIALOGUE">Dialogue</option>
                <option value="STORY_TEXT">Story text</option>
              </select>
            </div>
            <div>
              <label for="gbilling" class="mb-1 block text-sm text-foreground-muted">Billing mode</label>
              <select
                id="gbilling"
                name="billingMode"
                required
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >
                <option value="PLATFORM_CREDITS">StoryGalore credits</option>
                <option value="BYOK">BYOK</option>
                <option value="USER_HOSTED">User-hosted</option>
              </select>
            </div>
            <div>
              <label for="glocation" class="mb-1 block text-sm text-foreground-muted">Execution location</label>
              <select
                id="glocation"
                name="executionLocation"
                required
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >
                <option value="CLOUD">Cloud</option>
                <option value="USER_HOSTED">User-hosted</option>
              </select>
            </div>
            <div>
              <label for="gprompt" class="mb-1 block text-sm text-foreground-muted">Prompt</label>
              <textarea
                id="gprompt"
                name="prompt"
                rows="4"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              ></textarea>
            </div>
            <div>
              <label for="gtemplate" class="mb-1 block text-sm text-foreground-muted">Prompt template (optional)</label>
              <select
                id="gtemplate"
                name="promptTemplateId"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >
                <option value="">— none —</option>
                {promptTemplates.map((t) => (
                  <option value={t.$id || t.id}>{t.name}</option>
                ))}
              </select>
            </div>
            {generationError && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {generationError}
              </p>
            )}
            <button
              type="submit"
              class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              Submit request
            </button>
          </form>

          <h3 class="mt-10 text-lg font-semibold">Requests</h3>
          {
            generations.length > 0 ? (
              <ul class="mt-4 space-y-2">
                {generations.map((g) => (
                  <li class="flex items-center justify-between rounded-md border border-border bg-surface p-4">
                    <div class="min-w-0 flex-1">
                      <p class="font-semibold">{g.targetType}</p>
                      <p class="truncate text-sm text-foreground-muted">
                        {g.billingMode} · {g.executionLocation}
                      </p>
                    </div>
                    <div class="ml-4 flex shrink-0 items-center gap-3 text-xs text-foreground-muted">
                      <span class="rounded-full border border-border px-2 py-0.5">{g.status ?? "QUEUED"}</span>
                      <span>{g.creditEligible ? "credits" : (g.creditEligibilityReason ?? "ineligible")}</span>
                    </div>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
                No generation requests yet.
              </p>
            )
          }
        </section>
      ) : tab === "analytics" ? (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">Analytics</h2>
          <p class="mt-1 text-sm text-foreground-muted">Your workspace metrics, computed live from your projects.</p>

          <div class="mt-6 grid grid-cols-2 gap-4 md:grid-cols-3">
            <div class="rounded-md border border-border bg-surface p-4">
              <p class="text-2xl font-bold">{analytics?.projects ?? 0}</p>
              <p class="text-sm text-foreground-muted">Projects</p>
            </div>
            <div class="rounded-md border border-border bg-surface p-4">
              <p class="text-2xl font-bold">{analytics?.documents ?? 0}</p>
              <p class="text-sm text-foreground-muted">Documents</p>
            </div>
            <div class="rounded-md border border-border bg-surface p-4">
              <p class="text-2xl font-bold">{analytics?.promptTemplates ?? 0}</p>
              <p class="text-sm text-foreground-muted">Prompt templates</p>
            </div>
            <div class="rounded-md border border-border bg-surface p-4">
              <p class="text-2xl font-bold">{analytics?.generationTotal ?? 0}</p>
              <p class="text-sm text-foreground-muted">Generations</p>
            </div>
            <div class="rounded-md border border-border bg-surface p-4">
              <p class="text-2xl font-bold">{analytics?.generationCreditEligible ?? 0}</p>
              <p class="text-sm text-foreground-muted">Credit-eligible generations</p>
            </div>
          </div>

          {analytics?.generationsByBilling ? (
            <div class="mt-6">
              <h3 class="text-lg font-semibold">Generations by billing mode</h3>
              <ul class="mt-3 space-y-2">
                {Object.entries(analytics.generationsByBilling).map(([mode, count]) => (
                  <li class="flex items-center justify-between rounded-md border border-border bg-surface p-3">
                    <span class="text-sm">{mode}</span>
                    <span class="text-sm font-semibold">{count}</span>
                  </li>
                ))}
              </ul>
            </div>
          ) : null}
        </section>
      ) : (
        <section class="mt-8">
          <h2 class="text-xl font-semibold">{title}</h2>
          <p class="mt-4 rounded-md border border-dashed border-border px-6 py-10 text-sm text-foreground-muted">
            This section is coming soon.
          </p>
        </section>
      )
    }
  </main>
</StudioLayout>
