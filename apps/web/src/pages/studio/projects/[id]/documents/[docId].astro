---
import Layout from "@/layouts/Layout.astro";
import { actions } from "astro:actions";
import DocumentMeta from "@/components/DocumentMeta.svelte";
import { fetchDocument, fetchMediaAssets, fetchRevisions } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const labels = {
  title: t("studio.field.title"),
  format: t("studio.field.format"),
  saving: t("studio.meta.saving"),
  saved: t("studio.meta.saved"),
  error: t("studio.meta.error"),
  offline: t("studio.meta.offline"),
  autosave: t("studio.meta.autosave"),
};

const bookFormats = [
  { value: "", label: "—" },
  { value: "COMIC", label: t("studio.format.comic") },
  { value: "MANGA", label: t("studio.format.manga") },
  { value: "MANHWA", label: t("studio.format.manhwa") },
  { value: "MANHUA", label: t("studio.format.manhua") },
  { value: "BANDE_DESSINEE", label: t("studio.format.bandeDessinee") },
  { value: "GRAPHIC_NOVEL", label: t("studio.format.graphicNovel") },
  { value: "WEBTOON", label: t("studio.format.webtoon") },
  { value: "NOVEL", label: t("studio.format.novel") },
  { value: "LIGHT_NOVEL", label: t("studio.format.lightNovel") },
  { value: "NONFICTION", label: t("studio.format.nonfiction") },
  { value: "EDUCATIONAL", label: t("studio.format.educational") },
];

const user = Astro.locals.user;
const projectId = Astro.params.id ?? "";
const documentId = Astro.params.docId ?? "";

if (!user) {
  return Astro.redirect("/login");
}

const doc = await fetchDocument(user.$id, documentId);
if (!doc) {
  return Astro.redirect(`/studio/projects/${projectId}`);
}
const mediaAssets = await fetchMediaAssets(user.$id);
const revisions = await fetchRevisions(user.$id, documentId);

const addPageResult = Astro.getActionResult(actions.addPage);
const deletePageResult = Astro.getActionResult(actions.deletePage);
const addPanelResult = Astro.getActionResult(actions.addPanel);
const deletePanelResult = Astro.getActionResult(actions.deletePanel);
const updatePanelResult = Astro.getActionResult(actions.updatePanel);
const publishResult = Astro.getActionResult(actions.publishPublication);
const uploadResult = Astro.getActionResult(actions.uploadMedia);
const attachResult = Astro.getActionResult(actions.attachPageBackground);
const restoreResult = Astro.getActionResult(actions.restoreRevision);

if (publishResult?.data?.ok && publishResult.data.publicationId) {
  return Astro.redirect(`/read/${publishResult.data.publicationId}`);
}

const results = [addPageResult, deletePageResult, addPanelResult, deletePanelResult, updatePanelResult, uploadResult, attachResult];
if (results.some((r) => r?.data?.ok)) {
  return Astro.redirect(`/studio/projects/${projectId}/documents/${documentId}`);
}
if (restoreResult?.data?.ok) {
  return Astro.redirect(`/studio/projects/${projectId}/documents/${documentId}`);
}
const editError = results.find((r) => r?.error)?.error?.message;
const publishError = publishResult?.error?.message;

const SEQUENTIAL_FORMATS = new Set([
  "COMIC",
  "MANGA",
  "MANHWA",
  "MANHUA",
  "BANDE_DESSINEE",
  "GRAPHIC_NOVEL",
  "WEBTOON",
]);
const isSequentialArt =
  doc.document.type === "BOOK" && (!doc.document.format || SEQUENTIAL_FORMATS.has(doc.document.format));

function parseBounds(bounds?: string): { x: number; y: number; width: number; height: number } | null {
  if (!bounds) return null;
  try {
    const b = JSON.parse(bounds);
    return { x: b.x ?? 0, y: b.y ?? 0, width: b.width ?? 0, height: b.height ?? 0 };
  } catch {
    return null;
  }
}
---

<Layout title={doc.document.title ?? t("studio.untitledDocument")}>
  <main class="mx-auto max-w-4xl px-6 py-12">
    <a
      href={`/studio/projects/${projectId}`}
      class="text-sm text-foreground-muted transition hover:text-foreground"
    >
      {t("studio.backToProject")}
    </a>

    <header class="mt-4 flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-bold">{doc.document.title || t("studio.untitledDocument")}</h1>
      <span class="rounded-full border border-border px-2 py-0.5 text-xs text-foreground-muted">
        {doc.document.type}
      </span>
      {doc.document.format && (
        <span class="rounded-full border border-border px-2 py-0.5 text-xs text-foreground-muted">
          {doc.document.format}
        </span>
      )}
    </header>

    <section class="mt-6">
      <h2 class="text-xl font-semibold">{t("studio.editor.details")}</h2>
      <div class="mt-4">
        <DocumentMeta
          client:load
          documentId={documentId}
          initialTitle={doc.document.title ?? ""}
          initialFormat={doc.document.format ?? ""}
          showFormat={doc.document.type === "BOOK"}
          labels={labels}
          bookFormats={bookFormats}
        />
      </div>
    </section>

    {editError && (
      <p class="mt-6 rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
        {editError}
      </p>
    )}

    {isSequentialArt ? (
      <section class="mt-10">
        <h2 class="text-xl font-semibold">{t("studio.editor.pages")}</h2>
        <form method="POST" action={actions.addPage} class="mt-4 flex flex-wrap items-end gap-3">
          <input type="hidden" name="documentId" value={documentId} />
          <input type="hidden" name="position" value={doc.pages.length} />
          <div>
            <label for="width" class="mb-1 block text-sm text-foreground-muted">{t("studio.editor.width")}</label>
            <input
              id="width"
              name="width"
              type="number"
              min="1"
              placeholder="800"
              class="w-28 rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
            />
          </div>
          <div>
            <label for="height" class="mb-1 block text-sm text-foreground-muted">{t("studio.editor.height")}</label>
            <input
              id="height"
              name="height"
              type="number"
              min="1"
              placeholder="1200"
              class="w-28 rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
            />
          </div>
          <button
            type="submit"
            class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
          >
            {t("studio.editor.addPage")}
          </button>
        </form>

        {doc.pages.length > 0 ? (
          <ul class="mt-6 space-y-4">
            {doc.pages.map((page, i) => (
              <li class="rounded-md border border-border bg-surface p-4">
                <div class="flex items-center justify-between">
                  <div>
                    <p class="font-medium text-foreground">{t("studio.editor.pageLabel")} {i + 1}</p>
                    <p class="text-xs text-foreground-muted">
                      {page.width && page.height ? `${page.width} × ${page.height}px` : t("studio.editor.defaultDims")}
                    </p>
                  </div>
                  <form method="POST" action={actions.deletePage}>
                    <input type="hidden" name="pageId" value={page.$id} />
                    <button
                      type="submit"
                      class="rounded-sm border border-danger/40 px-3 py-1 text-xs text-danger transition hover:bg-danger/10"
                    >
                      {t("studio.editor.deletePage")}
                    </button>
                  </form>
                </div>

                {mediaAssets.length > 0 && (
                  <form method="POST" action={actions.attachPageBackground} class="mt-3 flex items-center gap-2">
                    <input type="hidden" name="pageId" value={page.$id} />
                    <select
                      name="backgroundAssetId"
                      class="rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
                    >
                      <option value="">{t("studio.editor.setBackground")}</option>
                      {mediaAssets.map((a) => (
                        <option value={a.$id}>
                          {a.mimeType}
                          {a.width && a.height ? ` ${a.width}×${a.height}` : ""}
                        </option>
                      ))}
                    </select>
                    <button
                      type="submit"
                      class="rounded-sm bg-primary px-3 py-2 text-xs font-semibold text-primary-foreground transition hover:opacity-90"
                    >
                      {t("studio.editor.set")}
                    </button>
                  </form>
                )}

                <div class="mt-3">
                  <p class="text-sm text-foreground-muted">{t("studio.editor.panels")}</p>
                  {(page.panels?.length ?? 0) > 0 ? (
                    <ul class="mt-2 space-y-2">
                      {page.panels!.map((panel, j) => {
                        const b = parseBounds(panel.bounds);
                        return (
                          <li class="rounded-sm border border-border/60 px-3 py-2">
                            <div class="flex items-center justify-between">
                              <span class="text-sm text-foreground">
                                {panel.shape ?? "RECTANGLE"}
                                {b ? ` · ${b.width}×${b.height}px` : ""}
                              </span>
                              <form method="POST" action={actions.deletePanel}>
                                <input type="hidden" name="panelId" value={panel.$id} />
                                <button
                                  type="submit"
                                  class="rounded-sm border border-danger/40 px-2 py-0.5 text-xs text-danger transition hover:bg-danger/10"
                                >
                                  {t("studio.editor.delete")}
                                </button>
                              </form>
                            </div>
                            <form method="POST" action={actions.updatePanel} class="mt-2 grid grid-cols-4 gap-2">
                              <input type="hidden" name="panelId" value={panel.$id} />
                              <input
                                type="number"
                                name="x"
                                value={b?.x ?? 0}
                                min="0"
                                placeholder="x"
                                class="rounded-md border border-border bg-surface px-2 py-1 text-xs outline-none focus:border-primary"
                              />
                              <input
                                type="number"
                                name="y"
                                value={b?.y ?? 0}
                                min="0"
                                placeholder="y"
                                class="rounded-md border border-border bg-surface px-2 py-1 text-xs outline-none focus:border-primary"
                              />
                              <input
                                type="number"
                                name="width"
                                value={b?.width ?? 800}
                                min="1"
                                placeholder="width"
                                class="rounded-md border border-border bg-surface px-2 py-1 text-xs outline-none focus:border-primary"
                              />
                              <input
                                type="number"
                                name="height"
                                value={b?.height ?? 1200}
                                min="1"
                                placeholder="height"
                                class="rounded-md border border-border bg-surface px-2 py-1 text-xs outline-none focus:border-primary"
                              />
                              <select
                                name="shape"
                                class="col-span-4 rounded-md border border-border bg-surface px-2 py-1 text-xs outline-none focus:border-primary"
                              >
                                <option value="RECTANGLE" selected={panel.shape === "RECTANGLE"}>{t("studio.editor.shape.rectangle")}</option>
                                <option value="ROUNDED" selected={panel.shape === "ROUNDED"}>{t("studio.editor.shape.rounded")}</option>
                                <option value="CIRCLE" selected={panel.shape === "CIRCLE"}>{t("studio.editor.shape.circle")}</option>
                                <option value="CUSTOM" selected={panel.shape === "CUSTOM"}>{t("studio.editor.shape.custom")}</option>
                              </select>
                              <button
                                type="submit"
                                class="col-span-4 rounded-md bg-primary px-2 py-1 text-xs font-semibold text-primary-foreground transition hover:opacity-90"
                              >
                                {t("studio.editor.updatePanel")}
                              </button>
                            </form>
                          </li>
                        );
                      })}
                    </ul>
                  ) : (
                    <p class="mt-2 text-sm text-foreground-muted">{t("studio.editor.noPanels")}</p>
                  )}

                  <form method="POST" action={actions.addPanel} class="mt-3 flex flex-wrap items-end gap-3">
                    <input type="hidden" name="pageId" value={page.$id} />
                    <input type="hidden" name="position" value={page.panels?.length ?? 0} />
                    <div>
                      <label for={`shape-${page.$id}`} class="mb-1 block text-sm text-foreground-muted">{t("studio.editor.shape")}</label>
                      <select
                        id={`shape-${page.$id}`}
                        name="shape"
                        class="rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
                      >
                        <option value="RECTANGLE">{t("studio.editor.shape.rectangle")}</option>
                        <option value="ROUNDED">{t("studio.editor.shape.rounded")}</option>
                        <option value="CIRCLE">{t("studio.editor.shape.circle")}</option>
                        <option value="CUSTOM">{t("studio.editor.shape.custom")}</option>
                      </select>
                    </div>
                    <button
                      type="submit"
                      class="rounded-sm bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
                    >
                      {t("studio.editor.addPanel")}
                    </button>
                  </form>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
            {t("studio.editor.noPages")}
          </p>
        )}
      </section>
    ) : (
      <section class="mt-10 rounded-md border border-dashed border-border px-6 py-10 text-sm text-foreground-muted">
        {t("studio.editor.comingSoon")}
      </section>
    )}

    <section class="mt-10">
      <h2 class="text-xl font-semibold">{t("studio.editor.mediaLibrary")}</h2>
      <p class="mt-1 text-sm text-foreground-muted">
        {t("studio.editor.mediaLibraryDesc")}
      </p>
      <form method="POST" action={actions.uploadMedia} enctype="multipart/form-data" class="mt-4 max-w-sm space-y-4">
        <input
          type="file"
          name="file"
          accept="image/*"
          required
          class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
        />
        <button
          type="submit"
          class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
        >
          {t("studio.editor.uploadImage")}
        </button>
      </form>

      {mediaAssets.length > 0 ? (
        <ul class="mt-4 space-y-1">
          {mediaAssets.map((a) => (
            <li class="text-sm text-foreground-muted">
              {a.mimeType}
              {a.width && a.height ? ` · ${a.width}×${a.height}px` : ""}
              <span class="ml-2 font-mono text-xs">{a.$id}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 text-sm text-foreground-muted">{t("studio.editor.noImages")}</p>
      )}
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">{t("studio.editor.revisions")}</h2>
      <p class="mt-1 text-sm text-foreground-muted">{t("studio.editor.revisionsDesc")}</p>

      {revisions.length > 0 ? (
        <ul class="mt-4 space-y-2">
          {revisions.map((r) => (
            <li class="flex items-center justify-between rounded-md border border-border bg-surface p-3">
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold">{t("studio.editor.revisionLabel")} {r.revision ?? "—"}</p>
                <p class="text-xs text-foreground-muted">{r.createdAt ?? ""}</p>
              </div>
              <form method="POST" action={actions.restoreRevision}>
                <input type="hidden" name="documentId" value={documentId} />
                <input type="hidden" name="targetRevisionId" value={r.$id} />
                <button
                  type="submit"
                  class="ml-4 shrink-0 rounded-sm border border-border px-3 py-1 text-xs transition hover:bg-surface"
                >
                  {t("studio.editor.restore")}
                </button>
              </form>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
          {t("studio.editor.noRevisions")}
        </p>
      )}
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">{t("studio.editor.publish")}</h2>
      <p class="mt-1 text-sm text-foreground-muted">
        {t("studio.editor.publishDesc")}
      </p>
      <form method="POST" action={actions.publishPublication} class="mt-4 max-w-sm space-y-4">
        <input type="hidden" name="documentId" value={documentId} />
        <div>
          <label for="pub-title" class="mb-1 block text-sm text-foreground-muted">{t("studio.field.title")}</label>
          <input
            id="pub-title"
            name="title"
            type="text"
            value={doc.document.title ?? ""}
            maxlength="200"
            class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
          />
        </div>
        <div>
          <label for="pub-description" class="mb-1 block text-sm text-foreground-muted">{t("studio.field.description")}</label>
          <textarea
            id="pub-description"
            name="description"
            class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
          ></textarea>
        </div>
        <div>
          <label for="pub-contentRating" class="mb-1 block text-sm text-foreground-muted">{t("studio.editor.contentRating")}</label>
          <select
            id="pub-contentRating"
            name="contentRating"
            class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
          >
            <option value="ALL_AGES">{t("studio.editor.rating.allAges")}</option>
            <option value="TEEN">{t("studio.editor.rating.teen")}</option>
            <option value="ADULT_18_PLUS">{t("studio.editor.rating.adult")}</option>
          </select>
        </div>
        <div>
          <label for="pub-contentOrigin" class="mb-1 block text-sm text-foreground-muted">{t("studio.editor.contentOrigin")}</label>
          <select
            id="pub-contentOrigin"
            name="contentOrigin"
            class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
          >
            <option value="HUMAN">{t("studio.editor.origin.human")}</option>
            <option value="AI_ASSISTED">{t("studio.editor.origin.aiAssisted")}</option>
            <option value="AI_GENERATED">{t("studio.editor.origin.aiGenerated")}</option>
            <option value="HYBRID">{t("studio.editor.origin.hybrid")}</option>
          </select>
        </div>
        <div>
          <label for="pub-accessClass" class="mb-1 block text-sm text-foreground-muted">{t("studio.editor.access")}</label>
          <select
            id="pub-accessClass"
            name="accessClass"
            class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
          >
            <option value="FREE">{t("studio.editor.access.free")}</option>
            <option value="SUBSCRIPTION">{t("studio.editor.access.subscription")}</option>
            <option value="PURCHASE">{t("studio.editor.access.purchase")}</option>
          </select>
        </div>
        {mediaAssets.length > 0 && (
          <div>
            <label for="pub-cover" class="mb-1 block text-sm text-foreground-muted">{t("studio.editor.cover")}</label>
            <select
              id="pub-cover"
              name="coverMediaAssetId"
              class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
            >
              <option value="">{t("studio.editor.noCover")}</option>
              {mediaAssets.map((a) => (
                <option value={a.$id}>
                  {a.mimeType}
                  {a.width && a.height ? ` ${a.width}×${a.height}` : ""}
                </option>
              ))}
            </select>
          </div>
        )}

        {publishError && (
          <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
            {publishError}
          </p>
        )}

        <button
          type="submit"
          class="w-full rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
        >
          {t("studio.editor.publish")}
        </button>
      </form>
    </section>
  </main>
</Layout>
