---
import StudioLayout from "@/layouts/StudioLayout.astro";
import { fetchProjects } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);
const user = Astro.locals.user;
const projects = user ? await fetchProjects(user.$id) : [];
---

<StudioLayout title={`${t("studio.brand")} — ${t("studio.nav.projects")}`} active="projects">
  <main class="mx-auto max-w-5xl px-12 py-10">
    <h1 class="text-3xl font-bold">{t("studio.nav.projects")}</h1>
    <p class="mt-2 text-foreground-muted">{t("studio.projects.wip")}</p>

    {
      projects.length > 0 ? (
        <ul class="mt-8 space-y-3">
          {projects.map((p) => (
            <li>
              <a
                href={`/studio/projects/${p.$id}`}
                class="block rounded-md border border-border bg-surface p-4 transition hover:border-foreground-muted"
              >
                <div class="flex items-center justify-between">
                  <p class="font-semibold">{p.name}</p>
                  {p.status && <span class="text-xs text-foreground-muted">{p.status}</span>}
                </div>
                {p.description && <p class="mt-1 text-sm text-foreground-muted">{p.description}</p>}
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-8 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
          {t("studio.projects.noProjects")}
        </p>
      )
    }
  </main>
</StudioLayout>
