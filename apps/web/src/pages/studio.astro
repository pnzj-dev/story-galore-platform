---
import Layout from "@/layouts/Layout.astro";
import { actions } from "astro:actions";
import { fetchCreator, fetchProjects, fetchMediaAssets } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const user = Astro.locals.user;
const creator = user ? await fetchCreator(user.$id) : null;
const projects = creator && user ? await fetchProjects(user.$id) : [];
const mediaAssets = user ? await fetchMediaAssets(user.$id) : [];

const becomeResult = Astro.getActionResult(actions.becomeCreator);
if (becomeResult?.data?.ok) {
  return Astro.redirect("/studio");
}
const projectResult = Astro.getActionResult(actions.createProject);
if (projectResult?.data?.ok) {
  return Astro.redirect("/studio");
}
const profileResult = Astro.getActionResult(actions.updateCreatorProfile);
if (profileResult?.data?.ok) {
  return Astro.redirect("/studio");
}
const becomeError = becomeResult?.error?.message;
const projectError = projectResult?.error?.message;
const profileError = profileResult?.error?.message;
---

<Layout title={t("studio.title")}>
  <main class="mx-auto max-w-4xl px-6 py-12">
    {creator ? (
      <>
        <h1 class="text-3xl font-bold">{t("studio.title")}</h1>
        <p class="mt-2 text-foreground-muted">@{creator.handle}</p>

        <section class="mt-8">
          <h2 class="text-xl font-semibold">{t("studio.profileImage")}</h2>
          <form method="POST" action={actions.updateCreatorProfile} class="mt-4 max-w-sm space-y-4">
            <div>
              <label for="avatarMediaAssetId" class="mb-1 block text-sm text-foreground-muted">{t("studio.avatar")}</label>
              <select
                id="avatarMediaAssetId"
                name="avatarMediaAssetId"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              >
                <option value="">{t("studio.none")}</option>
                {mediaAssets.map((a) => (
                  <option value={a.$id} selected={a.$id === creator.avatarMediaAssetId}>
                    {a.mimeType}
                    {a.width && a.height ? ` ${a.width}×${a.height}` : ""}
                  </option>
                ))}
              </select>
            </div>
            {profileError && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {profileError}
              </p>
            )}
            <button
              type="submit"
              class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              {t("studio.setAvatar")}
            </button>
          </form>
        </section>

        <section class="mt-8">
          <h2 class="text-xl font-semibold">{t("studio.newProject")}</h2>
          <form method="POST" action={actions.createProject} class="mt-4 max-w-sm space-y-4">
            <div>
              <label for="name" class="mb-1 block text-sm text-foreground-muted">{t("studio.name")}</label>
              <input
                id="name"
                name="name"
                type="text"
                required
                maxlength="200"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              />
            </div>
            <div>
              <label for="description" class="mb-1 block text-sm text-foreground-muted">{t("studio.description")}</label>
              <textarea
                id="description"
                name="description"
                class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
              ></textarea>
            </div>
            {projectError && (
              <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
                {projectError}
              </p>
            )}
            <button
              type="submit"
              class="w-full rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
            >
              {t("studio.createProject")}
            </button>
          </form>
        </section>

        <section class="mt-10">
          <h2 class="text-xl font-semibold">{t("studio.yourProjects")}</h2>
          {projects.length > 0 ? (
            <ul class="mt-4 space-y-2">
              {projects.map((p) => (
                <li class="flex items-center justify-between rounded-sm border border-border bg-surface p-3">
                  <a href={`/studio/projects/${p.$id}`} class="min-w-0 flex-1">
                    <p class="truncate font-medium text-foreground transition hover:text-primary">{p.name}</p>
                    {p.description && <p class="truncate text-sm text-foreground-muted">{p.description}</p>}
                  </a>
                  <span class="ml-4 shrink-0 text-xs text-foreground-muted">{p.status}</span>
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
              {t("studio.noProjects")}
            </p>
          )}
        </section>
      </>
    ) : (
      <>
        <h1 class="text-3xl font-bold">{t("studio.becomeCreator")}</h1>
        <p class="mt-2 text-foreground-muted">{t("studio.becomeCreatorDesc")}</p>

        <form method="POST" action={actions.becomeCreator} class="mt-6 max-w-sm space-y-4">
          <div>
            <label for="handle" class="mb-1 block text-sm text-foreground-muted">{t("studio.handle")}</label>
            <input
              id="handle"
              name="handle"
              type="text"
              required
              maxlength="255"
              class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
            />
          </div>
          <div>
            <label for="displayName" class="mb-1 block text-sm text-foreground-muted">{t("studio.displayName")}</label>
            <input
              id="displayName"
              name="displayName"
              type="text"
              required
              maxlength="255"
              class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
            />
          </div>
          <div>
            <label for="bio" class="mb-1 block text-sm text-foreground-muted">{t("studio.bio")}</label>
            <textarea
              id="bio"
              name="bio"
              class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
            ></textarea>
          </div>

          {becomeError && (
            <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
              {becomeError}
            </p>
          )}

          <button
            type="submit"
            class="w-full rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
          >
            {t("studio.becomeCreator")}
          </button>
        </form>
      </>
    )}
  </main>
</Layout>
