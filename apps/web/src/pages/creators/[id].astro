---
import Layout from "@/layouts/Layout.astro";
import { MediaCard } from "@storygalore/ui";
import type { MediaCardData } from "@storygalore/ui";
import { fetchCreator, fetchPublications } from "@/lib/gateway";

const actorId = Astro.params.id ?? "";
const creator = actorId ? await fetchCreator(actorId) : null;
if (!creator) {
  Astro.response.status = 404;
}
const publications = creator ? await fetchPublications("new", creator.actorId) : [];

function hrefFor(item: MediaCardData): string {
  switch (item.type) {
    case "VIDEO":
      return `/watch/${item.id}`;
    case "AUDIO":
      return `/listen/${item.id}`;
    case "POST":
      return `/posts/${item.id}`;
    default:
      return `/read/${item.id}`;
  }
}
---

<Layout title={creator ? creator.displayName : "Creator not found"}>
  {creator ? (
    <main class="mx-auto max-w-[1400px] px-12 py-12">
      <div class="flex items-center gap-6">
        <div
          class="flex h-20 w-20 shrink-0 items-center justify-center rounded-full bg-surface-elevated text-2xl font-bold text-foreground-muted"
        >
          {creator.displayName.charAt(0)}
        </div>
        <div>
          <h1 class="text-3xl font-bold">{creator.displayName}</h1>
          <p class="text-foreground-muted">@{creator.handle}</p>
          {creator.bio && <p class="mt-2 max-w-xl text-foreground-muted">{creator.bio}</p>}
        </div>
      </div>

      <h2 class="mt-10 text-xl font-semibold">Published stories</h2>
      {publications.length > 0 ? (
        <div class="mt-4 flex flex-wrap gap-4">
          {publications.map((item) => (
            <MediaCard publication={item} href={hrefFor(item)} />
          ))}
        </div>
      ) : (
        <p class="mt-4 rounded-xl border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
          No published stories yet.
        </p>
      )}
    </main>
  ) : (
    <main class="mx-auto max-w-3xl px-6 py-24 text-center">
      <h1 class="text-3xl font-bold">Creator not found</h1>
      <a href="/" class="mt-6 inline-block text-link">Back home</a>
    </main>
  )}
</Layout>
