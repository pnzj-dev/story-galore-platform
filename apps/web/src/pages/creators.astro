---
import Layout from "@/layouts/Layout.astro";
import { CreatorCard } from "@storygalore/ui";
import { fetchCreators } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);
const creators = await fetchCreators();
---

<Layout title={t("creators.title")}>
  <main class="mx-auto max-w-[1400px] px-12 py-12">
    <h1 class="text-3xl font-bold">{t("creators.title")}</h1>
    <p class="mt-2 text-foreground-muted">{t("creators.desc")}</p>

    {
      creators.length > 0 ? (
        <div class="mt-8 flex flex-wrap gap-4">
          {creators.map((c) => <CreatorCard creator={c} href={`/creators/${c.id}`} />)}
        </div>
      ) : (
        <p class="mt-8 rounded-xl border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
          {t("creators.none")}
        </p>
      )
    }
  </main>
</Layout>
