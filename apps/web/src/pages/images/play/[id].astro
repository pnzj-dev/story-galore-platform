---
import Layout from "@/layouts/Layout.astro";
import ImagesPlayer from "@/components/ImagesPlayer.svelte";
import { fetchMediaByType } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

const { items: images } = await fetchMediaByType("POST", { limit: 100 });
const id = Astro.params.id ?? "";
const signedIn = Boolean(Astro.locals.user?.$id);
const labels = {
  title: t("comments.title"),
  placeholder: t("comments.placeholder"),
  post: t("comments.post"),
  reply: t("comments.reply"),
  replyTo: t("comments.replyTo"),
  cancel: t("comments.cancel"),
  signIn: t("comments.signIn"),
  empty: t("comments.empty"),
  pending: t("comments.pending"),
};
---

<Layout title={t("nav.images")}>
  {
    images.length > 0 ? (
      <ImagesPlayer client:load images={images} initialId={id} signedIn={signedIn} labels={labels} />
    ) : (
      <main class="px-6 py-24 text-center">
        <h1 class="text-2xl font-bold">{t("browse.noContent")}</h1>
        <a href="/" class="mt-4 inline-block text-link">{t("story.backHome")}</a>
      </main>
    )
  }
</Layout>
