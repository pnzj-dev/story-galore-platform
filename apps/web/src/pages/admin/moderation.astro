---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { DataTable } from "@storygalore/ui";
import { fetchAdminList } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);
const user = Astro.locals.user;
const comments = user ? await fetchAdminList("admin_comment_list", user.$id) : [];

const columns = [
  { key: "targetType", label: t("admin.target") },
  { key: "status", label: t("admin.status") },
  { key: "body", label: t("admin.body") },
  { key: "createdAt", label: t("admin.created") },
];

const rows = comments.map((c) => ({
  $id: String(c.$id ?? ""),
  targetType: String(c.targetType ?? ""),
  status: String(c.status ?? ""),
  body: String(c.body ?? "").slice(0, 80),
  createdAt: String(c.createdAt ?? "").slice(0, 10),
}));
---

<AdminLayout title={`${t("admin.label")} — ${t("admin.moderation")}`}>
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <header>
      <h1 class="text-3xl font-bold">{t("admin.moderation")}</h1>
      <p class="mt-1 text-sm text-foreground-muted">{comments.length} {t("admin.count.comments")}.</p>
    </header>

    <div class="mt-8">
      <DataTable columns={columns} rows={rows} rowKey="$id" searchable />
    </div>
  </main>
</AdminLayout>
