---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { DataTable } from "@storygalore/ui";
import { fetchAdminList } from "@/lib/gateway";

const user = Astro.locals.user;
const pubs = user ? await fetchAdminList("admin_publication_list", user.$id) : [];

const columns = [
  { key: "title", label: "Title" },
  { key: "type", label: "Type" },
  { key: "status", label: "Status" },
  { key: "accessClass", label: "Access" },
  { key: "contentRating", label: "Rating" },
];

const rows = pubs.map((p) => ({
  $id: String(p.$id ?? ""),
  title: String(p.title ?? "Untitled"),
  type: String(p.type ?? ""),
  status: String(p.status ?? ""),
  accessClass: String(p.accessClass ?? "FREE"),
  contentRating: String(p.contentRating ?? ""),
}));
---

<AdminLayout title="Admin — Content">
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <header>
      <h1 class="text-3xl font-bold">Content</h1>
      <p class="mt-1 text-sm text-foreground-muted">{pubs.length} publication(s).</p>
    </header>

    <div class="mt-8">
      <DataTable columns={columns} rows={rows} rowKey="$id" searchable />
    </div>
  </main>
</AdminLayout>
