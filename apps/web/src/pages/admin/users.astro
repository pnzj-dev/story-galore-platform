---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { DataTable } from "@storygalore/ui";
import { fetchAdminUsers } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);
const user = Astro.locals.user;
const users = user ? await fetchAdminUsers(user.$id) : [];

const columns = [
  { key: "name", label: t("admin.name") },
  { key: "email", label: t("admin.email") },
  { key: "labels", label: t("admin.labels") },
  { key: "createdAt", label: t("admin.created") },
];

const rows = users.map((u) => ({
  $id: u.$id,
  name: u.name ?? "—",
  email: u.email ?? "—",
  labels: (u.labels ?? []).join(", ") || "—",
  createdAt: (u.createdAt ?? "").slice(0, 10),
}));
---

<AdminLayout title={`${t("admin.label")} — ${t("admin.users")}`}>
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <header>
      <h1 class="text-3xl font-bold">{t("admin.users")}</h1>
      <p class="mt-1 text-sm text-foreground-muted">{users.length} {t("admin.count.users")}.</p>
    </header>

    <div class="mt-8">
      <DataTable columns={columns} rows={rows} rowKey="$id" searchable />
    </div>
  </main>
</AdminLayout>
