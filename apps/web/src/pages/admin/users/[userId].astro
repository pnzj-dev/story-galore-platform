---
import AdminLayout from "@/layouts/AdminLayout.astro";
import AdminDetail from "@/components/AdminDetail.astro";
import { fetchAdminUser } from "@/lib/gateway";

const admin = Astro.locals.user;
const userId = Astro.params.userId ?? "";
const detail = admin ? await fetchAdminUser(admin.$id, userId) : null;
if (!detail) Astro.response.status = 404;
---

<AdminLayout title="Admin — User">
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <a href="/admin/users" class="text-sm text-foreground-muted transition hover:text-foreground">← Users</a>
    {detail ? (
      <>
        <h1 class="mt-4 text-3xl font-bold">{detail.name ?? detail.email ?? "User"}</h1>
        <div class="mt-6 max-w-2xl">
          <AdminDetail data={detail as unknown as Record<string, unknown>} />
        </div>
      </>
    ) : (
      <p class="mt-8 text-foreground-muted">User not found.</p>
    )}
  </main>
</AdminLayout>
