---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);
Astro.response.status = 404;
---

<AdminLayout title={`${t("admin.label")} — ${t("admin.notFound")}`}>
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <a href="/admin" class="text-sm text-foreground-muted transition hover:text-foreground">{t("admin.backToAdmin")}</a>
    <h1 class="mt-4 text-3xl font-bold">{t("admin.notFound")}</h1>
    <p class="mt-2 text-sm text-foreground-muted">{t("admin.notFoundDesc")}</p>
  </main>
</AdminLayout>
