---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { fetchAdminFunnel } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);
const user = Astro.locals.user;
const steps = user ? await fetchAdminFunnel(user.$id) : [];
---

<AdminLayout title={`${t("admin.label")} — ${t("admin.analytics.funnels")}`}>
  <main class="mx-auto max-w-4xl px-6 py-10">
    <a href="/admin/analytics" class="text-sm text-foreground-muted transition hover:text-foreground">
      {t("admin.backToAnalytics")}
    </a>
    <h1 class="mt-2 text-3xl font-bold">{t("admin.analytics.funnels")}</h1>
    <p class="mt-1 text-sm text-foreground-muted">
      {t("admin.funnelsDesc")}
    </p>

    {steps.length > 0 ? (
      <ol class="mt-6 space-y-2">
        {steps.map((s, i) => (
          <li class="flex items-center justify-between rounded-sm border border-border bg-surface px-4 py-3">
            <span class="text-sm text-foreground">{i + 1}. {s.step}</span>
            <span class="font-semibold tabular-nums">{s.actors}</span>
          </li>
        ))}
      </ol>
    ) : (
      <p class="mt-6 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
        {t("admin.noFunnel")}
      </p>
    )}
  </main>
</AdminLayout>
