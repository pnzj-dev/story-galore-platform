---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { fetchAdminRetention } from "@/lib/gateway";

const user = Astro.locals.user;
const r = user ? await fetchAdminRetention(user.$id) : null;
const rate = ((r?.returnRate ?? 0) * 100).toFixed(1);
---

<AdminLayout title="Admin — Retention">
  <main class="mx-auto max-w-4xl px-6 py-10">
    <a href="/admin/analytics" class="text-sm text-foreground-muted transition hover:text-foreground">
      &larr; Analytics
    </a>
    <h1 class="mt-2 text-3xl font-bold">Retention</h1>
    <p class="mt-1 text-sm text-foreground-muted">Actors with events on more than one distinct day.</p>

    {r ? (
      <div class="mt-6 grid gap-4 sm:grid-cols-3">
        <div class="rounded-md border border-border bg-surface p-4">
          <p class="text-xs uppercase tracking-widest text-foreground-muted">Total actors</p>
          <p class="mt-2 text-3xl font-bold tabular-nums">{r.totalActors ?? 0}</p>
        </div>
        <div class="rounded-md border border-border bg-surface p-4">
          <p class="text-xs uppercase tracking-widest text-foreground-muted">Returned actors</p>
          <p class="mt-2 text-3xl font-bold tabular-nums">{r.returnedActors ?? 0}</p>
        </div>
        <div class="rounded-md border border-border bg-surface p-4">
          <p class="text-xs uppercase tracking-widest text-foreground-muted">Return rate</p>
          <p class="mt-2 text-3xl font-bold tabular-nums">{rate}%</p>
        </div>
      </div>
    ) : (
      <p class="mt-6 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
        No retention data yet.
      </p>
    )}
  </main>
</AdminLayout>
