---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { TrendChart } from "@storygalore/ui";
import { fetchAdminAcquisition } from "../../../lib/gateway";

const user = Astro.locals.user;
const series = user ? await fetchAdminAcquisition(user.$id) : [];
---

<AdminLayout title="Admin — Acquisition">
  <main class="mx-auto max-w-4xl px-6 py-10">
    <a href="/admin/analytics" class="text-sm text-foreground-muted transition hover:text-foreground">
      &larr; Analytics
    </a>
    <h1 class="mt-2 text-3xl font-bold">Acquisition</h1>
    <p class="mt-1 text-sm text-foreground-muted">New actors per day (first-event date).</p>

    {series.length > 0 ? (
      <div class="mt-6 rounded-md border border-border bg-surface p-4">
        <TrendChart
          series={series.map((s) => ({ date: s.date, value: s.newActors }))}
          kind="bar"
          color="var(--color-chart-2)"
          heightClass="h-48"
        />
      </div>
    ) : (
      <p class="mt-6 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
        No acquisition data yet.
      </p>
    )}
  </main>
</AdminLayout>
