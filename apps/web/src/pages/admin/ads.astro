---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import { fetchAdCampaigns, fetchAdPlacements } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);
const user = Astro.locals.user;
const campaigns = await fetchAdCampaigns();
const placements = await fetchAdPlacements();

const createResult = Astro.getActionResult(actions.createAdCampaign);
const statusResult = Astro.getActionResult(actions.setAdCampaignStatus);
if (createResult?.data?.ok || statusResult?.data?.ok) {
  return Astro.redirect("/admin/ads");
}
const error = createResult?.error?.message ?? statusResult?.error?.message;

const PLACEMENT_KEYS = [
  "HOME_FEED_BETWEEN_RAILS",
  "DISCOVERY_FEED_BETWEEN_ITEMS",
  "SERIES_PAGE_BELOW_HERO",
  "SERIES_EPISODE_LIST_INLINE",
  "READER_BETWEEN_EPISODES",
  "READER_BELOW_COMIC",
  "GENRE_PAGE_INLINE",
];
---

<AdminLayout title={`${t("admin.label")} — ${t("admin.ads")}`}>
  <main class="mx-auto max-w-4xl px-6 py-12">
    <h1 class="text-3xl font-bold">{t("admin.ads")}</h1>
    <p class="mt-2 text-foreground-muted">{t("admin.adsDesc")}</p>

    <section class="mt-8">
      <h2 class="text-xl font-semibold">{t("admin.newCampaign")}</h2>
      <form method="POST" action={actions.createAdCampaign} class="mt-4 max-w-sm space-y-4">
        <div>
          <label for="name" class="mb-1 block text-sm text-foreground-muted">{t("admin.name")}</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            maxlength="255"
            class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
          />
        </div>
        <div>
          <label for="placementKeys" class="mb-1 block text-sm text-foreground-muted">
            {t("admin.placementsLabel")}
          </label>
          <input
            id="placementKeys"
            name="placementKeys"
            type="text"
            required
            placeholder="HOME_FEED_BETWEEN_RAILS,DISCOVERY_FEED_BETWEEN_ITEMS"
            class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
          />
          <p class="mt-1 text-xs text-foreground-muted">
            {t("admin.keys")}: {PLACEMENT_KEYS.join(", ")}
          </p>
        </div>
        <div>
          <label for="priority" class="mb-1 block text-sm text-foreground-muted">{t("admin.priority")}</label>
          <input
            id="priority"
            name="priority"
            type="number"
            min="0"
            value="0"
            class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
          />
        </div>

        {error && (
          <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">
            {error}
          </p>
        )}

        <button
          type="submit"
          class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
        >
          {t("admin.createCampaign")}
        </button>
      </form>
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">{t("admin.campaigns")}</h2>
      {campaigns.length > 0 ? (
        <ul class="mt-4 space-y-2">
          {campaigns.map((c) => (
            <li class="flex items-center justify-between rounded-sm border border-border bg-surface p-3">
              <div class="min-w-0">
                <p class="truncate font-medium text-foreground">{c.name}</p>
                <p class="truncate text-xs text-foreground-muted">
                  {c.placementIds?.join(", ") || ""}
                </p>
              </div>
              <div class="ml-4 flex shrink-0 items-center gap-2">
                <span class="text-xs text-foreground-muted">{c.status}</span>
                <form method="POST" action={actions.setAdCampaignStatus}>
                  <input type="hidden" name="campaignId" value={c.$id} />
                  <select
                    name="status"
                    class="rounded-md border border-border bg-surface px-2 py-1 text-xs outline-none focus:border-primary"
                  >
                    <option value="ACTIVE">{t("admin.activate")}</option>
                    <option value="PAUSED">{t("admin.pause")}</option>
                    <option value="COMPLETED">{t("admin.complete")}</option>
                    <option value="ARCHIVED">{t("admin.archive")}</option>
                  </select>
                  <button
                    type="submit"
                    class="ml-1 rounded-md bg-primary px-2 py-1 text-xs font-semibold text-primary-foreground"
                  >
                    {t("admin.set")}
                  </button>
                </form>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
          {t("admin.noCampaigns")}
        </p>
      )}
    </section>

    <section class="mt-10">
      <h2 class="text-xl font-semibold">{t("admin.placements")}</h2>
      <ul class="mt-4 space-y-1">
        {PLACEMENT_KEYS.map((k) => (
          <li class="text-sm text-foreground-muted">
            {k}
            {placements.some((p) => p.placementKey === k) ? "" : ` ${t("admin.notRegistered")}`}
          </li>
        ))}
      </ul>
    </section>
  </main>
</AdminLayout>
