---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { actions } from "astro:actions";
import { fetchAdminOperations, fetchIncidents, fetchAlerts } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);
const user = Astro.locals.user;
const ops = user ? await fetchAdminOperations(user.$id) : null;
const incidents = user ? await fetchIncidents(user.$id) : [];
const alerts = user ? await fetchAlerts(user.$id) : [];

const createIncidentResult = Astro.getActionResult(actions.createIncident);
const updateIncidentResult = Astro.getActionResult(actions.updateIncident);
const createAlertResult = Astro.getActionResult(actions.createAlert);
const updateAlertResult = Astro.getActionResult(actions.updateAlert);
const evaluateAlertsResult = Astro.getActionResult(actions.evaluateAlerts);
if (createIncidentResult?.data?.ok || updateIncidentResult?.data?.ok || createAlertResult?.data?.ok || updateAlertResult?.data?.ok || evaluateAlertsResult?.data?.ok) {
  return Astro.redirect("/admin/operations");
}
const incidentError = createIncidentResult?.error?.message ?? updateIncidentResult?.error?.message;
const alertError = createAlertResult?.error?.message ?? updateAlertResult?.error?.message;
---

<AdminLayout title={`${t("admin.label")} — ${t("admin.operations")}`}>
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <header>
      <h1 class="text-3xl font-bold">{t("admin.operations")}</h1>
      <p class="mt-1 text-sm text-foreground-muted">{t("admin.operationsDesc")}</p>
    </header>

    {ops ? (
      <>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 md:grid-cols-4">
          <div class="rounded-md border border-border bg-surface p-4">
            <p class="text-2xl font-bold tabular-nums">{ops.domainEvents ?? 0}</p>
            <p class="text-sm text-foreground-muted">{t("admin.domainEvents")}</p>
          </div>
          <div class="rounded-md border border-border bg-surface p-4">
            <p class="text-2xl font-bold tabular-nums">{ops.analyticsEvents ?? 0}</p>
            <p class="text-sm text-foreground-muted">{t("admin.analyticsEvents")}</p>
          </div>
          <div class="rounded-md border border-border bg-surface p-4">
            <p class="text-2xl font-bold tabular-nums">{ops.pendingGenerations ?? 0}</p>
            <p class="text-sm text-foreground-muted">{t("admin.pendingGenerations")}</p>
          </div>
          <div class="rounded-md border border-border bg-surface p-4">
            <p class="text-2xl font-bold tabular-nums">{ops.failedGenerations ?? 0}</p>
            <p class="text-sm text-foreground-muted">{t("admin.failedGenerations")}</p>
          </div>
        </div>

        {ops.generationsByStatus ? (
          <div class="mt-8 max-w-md">
            <div class="rounded-md border border-border bg-surface p-4">
              <h2 class="font-semibold">{t("admin.section.generationsByStatus")}</h2>
              <ul class="mt-3 space-y-1">
                {Object.entries(ops.generationsByStatus).map(([key, value]) => (
                  <li class="flex justify-between text-sm">
                    <span class="text-foreground-muted">{key}</span>
                    <span class="font-semibold tabular-nums">{value}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : null}
      </>
    ) : (
      <p class="mt-8 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
        {t("admin.noOperations")}
      </p>
    )}

    <section class="mt-10">
      <h2 class="text-2xl font-bold">{t("admin.incidents")}</h2>
      <p class="mt-1 text-sm text-foreground-muted">{t("admin.incidentsDesc")}</p>

      <form method="POST" action={actions.createIncident} class="mt-4 max-w-lg space-y-3 rounded-md border border-border bg-surface p-4">
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="inc-severity" class="mb-1 block text-sm text-foreground-muted">{t("admin.severity")}</label>
            <select id="inc-severity" name="severity" required class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary">
              <option value="LOW">{t("admin.severity.low")}</option>
              <option value="MEDIUM">{t("admin.severity.medium")}</option>
              <option value="HIGH">{t("admin.severity.high")}</option>
              <option value="CRITICAL">{t("admin.severity.critical")}</option>
            </select>
          </div>
          <div>
            <label for="inc-subsystem" class="mb-1 block text-sm text-foreground-muted">{t("admin.subsystem")}</label>
            <input id="inc-subsystem" name="subsystem" type="text" required placeholder="payments" class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary" />
          </div>
        </div>
        <div>
          <label for="inc-summary" class="mb-1 block text-sm text-foreground-muted">{t("admin.summary")}</label>
          <textarea id="inc-summary" name="summary" rows="2" required class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"></textarea>
        </div>
        <div>
          <label for="inc-owner" class="mb-1 block text-sm text-foreground-muted">{t("admin.ownerOptional")}</label>
          <input id="inc-owner" name="owner" type="text" class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary" />
        </div>
        {incidentError && (
          <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">{incidentError}</p>
        )}
        <button type="submit" class="rounded-sm bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition hover:opacity-90">
          {t("admin.openIncident")}
        </button>
      </form>

      {incidents.length > 0 ? (
        <ul class="mt-4 space-y-2">
          {incidents.map((i) => (
            <li class="rounded-md border border-border bg-surface p-4">
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full border border-border px-2 py-0.5 text-xs font-semibold">{i.severity}</span>
                <span class="rounded-full border border-border px-2 py-0.5 text-xs">{i.status}</span>
                <span class="text-xs text-foreground-muted">{i.subsystem}</span>
                <span class="ml-auto text-xs text-foreground-muted">{i.startedAt ?? ""}</span>
              </div>
              <p class="mt-2 text-sm">{i.summary}</p>
              {i.resolution && <p class="mt-1 text-sm text-foreground-muted">{t("admin.resolution")}: {i.resolution}</p>}
              {i.status !== "RESOLVED" ? (
                <form method="POST" action={actions.updateIncident} class="mt-3 flex items-center gap-2">
                  <input type="hidden" name="incidentId" value={i.$id} />
                  <select name="status" class="rounded-sm border border-border bg-surface px-2 py-1 text-xs outline-none focus:border-primary">
                    <option value="OPEN">{t("admin.incident.status.open")}</option>
                    <option value="INVESTIGATING">{t("admin.incident.status.investigating")}</option>
                    <option value="RESOLVED">{t("admin.incident.status.resolved")}</option>
                  </select>
                  <input name="resolution" type="text" placeholder={t("admin.resolutionNotes")} class="flex-1 rounded-sm border border-border bg-surface px-2 py-1 text-xs outline-none focus:border-primary" />
                  <button type="submit" class="rounded-sm bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground transition hover:opacity-90">
                    {t("admin.update")}
                  </button>
                </form>
              ) : null}
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 rounded-md border border-dashed border-border px-6 py-6 text-sm text-foreground-muted">{t("admin.noIncidents")}</p>
      )}
    </section>

    <section class="mt-10">
      <h2 class="text-2xl font-bold">{t("admin.alerts")}</h2>
      <p class="mt-1 text-sm text-foreground-muted">{t("admin.alertsDesc")}</p>

      <form method="POST" action={actions.evaluateAlerts} class="mt-4">
        <button type="submit" class="rounded-sm border border-border px-4 py-2 text-sm font-semibold transition hover:bg-surface">
          {t("admin.runEvaluation")}
        </button>
      </form>
      <p class="mt-1 text-xs text-foreground-muted">{t("admin.alertsTriggerNote")}</p>

      <form method="POST" action={actions.createAlert} class="mt-4 max-w-lg space-y-3 rounded-md border border-border bg-surface p-4">
        <div>
          <label for="alert-name" class="mb-1 block text-sm text-foreground-muted">{t("admin.name")}</label>
          <input id="alert-name" name="name" type="text" required placeholder="MCP error rate high" class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary" />
        </div>
        <div class="grid grid-cols-3 gap-3">
          <div>
            <label for="alert-metric" class="mb-1 block text-sm text-foreground-muted">{t("admin.metric")}</label>
            <input id="alert-metric" name="metric" type="text" required placeholder="mcp.errorRate" class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary" />
          </div>
          <div>
            <label for="alert-op" class="mb-1 block text-sm text-foreground-muted">{t("admin.operator")}</label>
            <select id="alert-op" name="operator" required class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary">
              <option value="gt">&gt;</option>
              <option value="gte">&gt;=</option>
              <option value="lt">&lt;</option>
              <option value="lte">&lt;=</option>
            </select>
          </div>
          <div>
            <label for="alert-threshold" class="mb-1 block text-sm text-foreground-muted">{t("admin.threshold")}</label>
            <input id="alert-threshold" name="threshold" type="number" required class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary" />
          </div>
        </div>
        <div>
          <label for="alert-severity" class="mb-1 block text-sm text-foreground-muted">{t("admin.severity")}</label>
          <select id="alert-severity" name="severity" required class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary">
            <option value="LOW">{t("admin.severity.low")}</option>
            <option value="MEDIUM">{t("admin.severity.medium")}</option>
            <option value="HIGH">{t("admin.severity.high")}</option>
            <option value="CRITICAL">{t("admin.severity.critical")}</option>
          </select>
        </div>
        {alertError && (
          <p class="rounded-sm border border-danger bg-danger/15 px-3 py-2 text-sm text-danger" role="alert">{alertError}</p>
        )}
        <button type="submit" class="rounded-sm bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition hover:opacity-90">
          {t("admin.addAlert")}
        </button>
      </form>

      {alerts.length > 0 ? (
        <ul class="mt-4 space-y-2">
          {alerts.map((a) => (
            <li class="flex items-center justify-between rounded-md border border-border bg-surface p-4">
              <div class="min-w-0 flex-1">
                <p class="text-sm font-semibold">{a.name}</p>
                <p class="text-xs text-foreground-muted">
                  {a.metric} {a.operator} {a.threshold} · {a.severity}
                </p>
              </div>
              <form method="POST" action={actions.updateAlert} class="ml-4 shrink-0">
                <input type="hidden" name="alertId" value={a.$id} />
                <button type="submit" name="enabled" value={a.enabled ? "false" : "true"} class="rounded-sm border border-border px-3 py-1 text-xs transition hover:bg-surface">
                  {a.enabled ? t("admin.disable") : t("admin.enable")}
                </button>
              </form>
            </li>
          ))}
        </ul>
      ) : (
        <p class="mt-4 rounded-md border border-dashed border-border px-6 py-6 text-sm text-foreground-muted">{t("admin.noAlerts")}</p>
      )}
    </section>
  </main>
</AdminLayout>
