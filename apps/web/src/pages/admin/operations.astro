---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { fetchAdminOperations } from "@/lib/gateway";

const user = Astro.locals.user;
const ops = user ? await fetchAdminOperations(user.$id) : null;
---

<AdminLayout title="Admin — Operations">
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <header>
      <h1 class="text-3xl font-bold">Operations</h1>
      <p class="mt-1 text-sm text-foreground-muted">Operational health — durable workflow, generation, and event throughput.</p>
    </header>

    {ops ? (
      <>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 md:grid-cols-4">
          <div class="rounded-md border border-border bg-surface p-4">
            <p class="text-2xl font-bold tabular-nums">{ops.domainEvents ?? 0}</p>
            <p class="text-sm text-foreground-muted">Domain events</p>
          </div>
          <div class="rounded-md border border-border bg-surface p-4">
            <p class="text-2xl font-bold tabular-nums">{ops.analyticsEvents ?? 0}</p>
            <p class="text-sm text-foreground-muted">Analytics events</p>
          </div>
          <div class="rounded-md border border-border bg-surface p-4">
            <p class="text-2xl font-bold tabular-nums">{ops.pendingGenerations ?? 0}</p>
            <p class="text-sm text-foreground-muted">Pending generations</p>
          </div>
          <div class="rounded-md border border-border bg-surface p-4">
            <p class="text-2xl font-bold tabular-nums">{ops.failedGenerations ?? 0}</p>
            <p class="text-sm text-foreground-muted">Failed generations</p>
          </div>
        </div>

        {ops.generationsByStatus ? (
          <div class="mt-8 max-w-md">
            <div class="rounded-md border border-border bg-surface p-4">
              <h2 class="font-semibold">Generations by status</h2>
              <ul class="mt-3 space-y-1">
                {Object.entries(ops.generationsByStatus).map(([key, value]) => (
                  <li class="flex justify-between text-sm">
                    <span class="text-foreground-muted">{key}</span>
                    <span class="font-semibold tabular-nums">{value}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ) : null}
      </>
    ) : (
      <p class="mt-8 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
        No operations data available.
      </p>
    )}
  </main>
</AdminLayout>
