---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { fetchAdminAnalytics } from "@/lib/gateway";

const user = Astro.locals.user;
const analytics = user ? await fetchAdminAnalytics(user.$id) : null;

const sections = [
  { title: "Content by type", entries: analytics?.contentByType },
  { title: "Content by status", entries: analytics?.contentByStatus },
  { title: "Subscriptions by status", entries: analytics?.subscriptionsByStatus },
  { title: "Payments by provider", entries: analytics?.paymentsByProvider },
  { title: "Payments by status", entries: analytics?.paymentsByStatus },
  { title: "Creators by status", entries: analytics?.creatorsByStatus },
];
---

<AdminLayout title="Admin — Analytics">
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <header>
      <h1 class="text-3xl font-bold">Analytics</h1>
      <p class="mt-1 text-sm text-foreground-muted">Why? — distributions over the authoritative domain tables.</p>
      <div class="mt-3 flex flex-wrap gap-3 text-sm">
        <a href="/admin/analytics/retention" class="text-link hover:underline">Retention</a>
        <a href="/admin/analytics/funnels" class="text-link hover:underline">Funnels</a>
        <a href="/admin/analytics/acquisition" class="text-link hover:underline">Acquisition</a>
        <a href="/admin/analytics/cohorts" class="text-link hover:underline">Cohorts</a>
      </div>
    </header>

    {analytics ? (
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {sections.map((s) => (
          <div class="rounded-md border border-border bg-surface p-4">
            <h2 class="font-semibold text-foreground">{s.title}</h2>
            <ul class="mt-3 space-y-1">
              {Object.entries(s.entries ?? {}).map(([key, value]) => (
                <li class="flex justify-between text-sm">
                  <span class="text-foreground-muted">{key}</span>
                  <span class="font-semibold tabular-nums">{value}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ) : (
      <p class="mt-8 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
        No analytics available.
      </p>
    )}
  </main>
</AdminLayout>
