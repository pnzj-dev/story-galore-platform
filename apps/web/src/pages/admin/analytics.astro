---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { fetchAdminAnalytics } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);
const user = Astro.locals.user;
const analytics = user ? await fetchAdminAnalytics(user.$id) : null;

const sections = [
  { title: t("admin.section.contentByType"), entries: analytics?.contentByType },
  { title: t("admin.section.contentByStatus"), entries: analytics?.contentByStatus },
  { title: t("admin.section.subscriptionsByStatus"), entries: analytics?.subscriptionsByStatus },
  { title: t("admin.section.paymentsByProvider"), entries: analytics?.paymentsByProvider },
  { title: t("admin.section.paymentsByStatus"), entries: analytics?.paymentsByStatus },
  { title: t("admin.section.creatorsByStatus"), entries: analytics?.creatorsByStatus },
];
---

<AdminLayout title={`${t("admin.label")} — ${t("admin.analytics")}`}>
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <header>
      <h1 class="text-3xl font-bold">{t("admin.analytics")}</h1>
      <p class="mt-1 text-sm text-foreground-muted">{t("admin.analyticsDesc")}</p>
      <div class="mt-3 flex flex-wrap gap-3 text-sm">
        <a href="/admin/analytics/retention" class="text-link hover:underline">{t("admin.analytics.retention")}</a>
        <a href="/admin/analytics/funnels" class="text-link hover:underline">{t("admin.analytics.funnels")}</a>
        <a href="/admin/analytics/acquisition" class="text-link hover:underline">{t("admin.analytics.acquisition")}</a>
        <a href="/admin/analytics/cohorts" class="text-link hover:underline">{t("admin.analytics.cohorts")}</a>
      </div>
    </header>

    {analytics ? (
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {sections.map((s) => (
          <div class="rounded-md border border-border bg-surface p-4">
            <h2 class="font-semibold text-foreground">{s.title}</h2>
            <ul class="mt-3 space-y-1">
              {Object.entries(s.entries ?? {}).map(([key, value]) => (
                <li class="flex justify-between text-sm">
                  <span class="text-foreground-muted">{key}</span>
                  <span class="font-semibold tabular-nums">{value}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ) : (
      <p class="mt-8 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
        {t("admin.noAnalytics")}
      </p>
    )}
  </main>
</AdminLayout>
