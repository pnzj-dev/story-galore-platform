---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { fetchAdminAnalytics, fetchAdminOperations } from "@/lib/gateway";

const user = Astro.locals.user;
const analytics = user ? await fetchAdminAnalytics(user.$id) : null;
const ops = user ? await fetchAdminOperations(user.$id) : null;

const sections = [
  { title: "Content by status", entries: analytics?.contentByStatus },
  { title: "Subscriptions by status", entries: analytics?.subscriptionsByStatus },
  { title: "Payments by status", entries: analytics?.paymentsByStatus },
  { title: "Creators by status", entries: analytics?.creatorsByStatus },
  { title: "Generations by status", entries: ops?.generationsByStatus },
];
---

<AdminLayout title="Admin — State Machine">
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <header>
      <h1 class="text-3xl font-bold">State Machine</h1>
      <p class="mt-1 text-sm text-foreground-muted">Domain lifecycle distributions across the authoritative tables.</p>
    </header>

    {sections.some((s) => s.entries && Object.keys(s.entries).length > 0) ? (
      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {sections.map((s) => (
          <div class="rounded-md border border-border bg-surface p-4">
            <h2 class="font-semibold">{s.title}</h2>
            <ul class="mt-3 space-y-1">
              {Object.entries(s.entries ?? {}).map(([key, value]) => (
                <li class="flex justify-between text-sm">
                  <span class="text-foreground-muted">{key}</span>
                  <span class="font-semibold tabular-nums">{value}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ) : (
      <p class="mt-8 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
        No state-machine data available.
      </p>
    )}
  </main>
</AdminLayout>
