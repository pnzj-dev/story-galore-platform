---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { fetchAdminSecurity } from "@/lib/gateway";

const user = Astro.locals.user;
const sec = user ? await fetchAdminSecurity(user.$id) : null;
---

<AdminLayout title="Admin — Security">
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <header>
      <h1 class="text-3xl font-bold">Security</h1>
      <p class="mt-1 text-sm text-foreground-muted">Audit and access signals across the platform.</p>
    </header>

    {sec ? (
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-md border border-border bg-surface p-4">
          <p class="text-2xl font-bold tabular-nums">{sec.auditEvents ?? 0}</p>
          <p class="text-sm text-foreground-muted">Audit events</p>
        </div>
        <div class="rounded-md border border-border bg-surface p-4">
          <p class="text-2xl font-bold tabular-nums">{sec.domainEvents ?? 0}</p>
          <p class="text-sm text-foreground-muted">Domain events (outbox)</p>
        </div>
      </div>
    ) : (
      <p class="mt-8 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
        No security data available.
      </p>
    )}
  </main>
</AdminLayout>
