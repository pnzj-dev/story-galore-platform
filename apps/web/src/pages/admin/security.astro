---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { fetchAdminSecurity } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);
const user = Astro.locals.user;
const sec = user ? await fetchAdminSecurity(user.$id) : null;
---

<AdminLayout title={`${t("admin.label")} — ${t("admin.security")}`}>
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <header>
      <h1 class="text-3xl font-bold">{t("admin.security")}</h1>
      <p class="mt-1 text-sm text-foreground-muted">{t("admin.securityDesc")}</p>
    </header>

    {sec ? (
      <div class="mt-8 grid gap-4 sm:grid-cols-2">
        <div class="rounded-md border border-border bg-surface p-4">
          <p class="text-2xl font-bold tabular-nums">{sec.auditEvents ?? 0}</p>
          <p class="text-sm text-foreground-muted">{t("admin.auditEvents")}</p>
        </div>
        <div class="rounded-md border border-border bg-surface p-4">
          <p class="text-2xl font-bold tabular-nums">{sec.domainEvents ?? 0}</p>
          <p class="text-sm text-foreground-muted">{t("admin.domainEventsOutbox")}</p>
        </div>
      </div>
    ) : (
      <p class="mt-8 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
        {t("admin.noSecurity")}
      </p>
    )}
  </main>
</AdminLayout>
