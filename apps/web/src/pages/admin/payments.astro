---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { DataTable } from "@storygalore/ui";
import { fetchAdminList } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);
const user = Astro.locals.user;
const payments = user ? await fetchAdminList("admin_payment_list", user.$id) : [];

const columns = [
  { key: "userId", label: t("admin.user") },
  { key: "amount", label: t("admin.amount") },
  { key: "currency", label: t("admin.currency") },
  { key: "provider", label: t("admin.provider") },
  { key: "status", label: t("admin.status") },
  { key: "createdAt", label: t("admin.created") },
];

const rows = payments.map((p) => ({
  $id: String(p.$id ?? ""),
  userId: String(p.userId ?? ""),
  amount: String(p.amount ?? 0),
  currency: String(p.currency ?? ""),
  provider: String(p.provider ?? ""),
  status: String(p.status ?? ""),
  createdAt: String(p.createdAt ?? "").slice(0, 10),
}));
---

<AdminLayout title={`${t("admin.label")} — ${t("admin.payments")}`}>
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <header>
      <h1 class="text-3xl font-bold">{t("admin.payments")}</h1>
      <p class="mt-1 text-sm text-foreground-muted">{payments.length} {t("admin.count.payments")}.</p>
    </header>

    <div class="mt-8">
      <DataTable columns={columns} rows={rows} rowKey="$id" searchable />
    </div>
  </main>
</AdminLayout>
