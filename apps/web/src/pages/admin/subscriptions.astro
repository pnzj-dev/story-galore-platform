---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { DataTable } from "@storygalore/ui";
import { fetchAdminList } from "../../lib/gateway";

const user = Astro.locals.user;
const subs = user ? await fetchAdminList("admin_subscription_list", user.$id) : [];

const columns = [
  { key: "userId", label: "User" },
  { key: "planId", label: "Plan" },
  { key: "status", label: "Status" },
  { key: "createdAt", label: "Created" },
];

const rows = subs.map((s) => ({
  $id: String(s.$id ?? ""),
  userId: String(s.userId ?? ""),
  planId: String(s.planId ?? ""),
  status: String(s.status ?? ""),
  createdAt: String(s.createdAt ?? "").slice(0, 10),
}));
---

<AdminLayout title="Admin — Subscriptions">
  <main class="mx-auto max-w-[1600px] px-6 py-10">
    <header>
      <h1 class="text-3xl font-bold">Subscriptions</h1>
      <p class="mt-1 text-sm text-foreground-muted">{subs.length} subscription(s).</p>
    </header>

    <div class="mt-8">
      <DataTable columns={columns} rows={rows} rowKey="$id" searchable />
    </div>
  </main>
</AdminLayout>
