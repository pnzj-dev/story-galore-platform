---
import Layout from "@/layouts/Layout.astro";
import VideoDetail from "@/components/VideoDetail.svelte";
import Comments from "@/components/Comments.svelte";
import SubscribeUpsell from "@/components/SubscribeUpsell.astro";
import SaveButton from "@/components/SaveButton.svelte";
import { ImageViewer } from "@storygalore/ui";
import type { PlaylistItem } from "@storygalore/ui";
import { fetchSeriesEpisodes, fetchMediaProgress, fetchComments, fetchSavedPublicationIds } from "@/lib/gateway";
import type { PublicationDetail } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

interface Props {
  detail: PublicationDetail | null;
  kind: "video" | "audio" | "post";
  title: string;
}

const { detail, kind, title } = Astro.props;
const pub = detail?.publication;
const allowed = (detail?.media ?? []).filter((m) => m.allowed && m.url);
const locked = Boolean(detail && !detail.entitled);
const cover = detail?.coverUrl;
const rating =
  pub?.contentRating && pub!.contentRating !== "ALL_AGES"
    ? pub!.contentRating === "ADULT_18_PLUS"
      ? t("studio.editor.rating.adult")
      : t("studio.editor.rating.teen")
    : null;

// "Continue watching" cards land on ?autoplay=1 to start playback immediately.
const autoplay = Astro.url.searchParams.get("autoplay") === "1";

// Build the ordered video playlist: series episodes (cross-publication) or
// parts within this publication, plus the resume index from saved progress.
const userId = Astro.locals.user?.$id ?? "";
const pubId = pub?.$id ?? "";
const savedIds = userId ? await fetchSavedPublicationIds(userId) : new Set<string>();
let videoItems: PlaylistItem[] = [];
let videoInitialIndex = 0;
let videoInitialTime = 0;
if (kind === "video" && pubId) {
  if (pub?.seriesId) {
    const episodes = await fetchSeriesEpisodes(pub.seriesId, userId);
    videoItems = episodes
      .filter((e) => e.url)
      .map((e, i) => ({
        id: e.publicationId,
        publicationId: e.publicationId,
        mediaId: e.mediaId,
        episodeId: e.episodeId,
        label: e.title ?? `${t("media.episodeLabel")} ${e.episodeNumber ?? i + 1}`,
        src: e.url!,
      }));
    videoInitialIndex = Math.max(0, videoItems.findIndex((it) => it.publicationId === pubId));
  } else {
    videoItems = allowed.map((m, i) => ({
      id: m.mediaId,
      mediaId: m.mediaId,
      publicationId: pubId,
      label: m.label ?? `${t("media.partLabel")} ${(m.position ?? i) + 1}`,
      src: m.url!,
    }));
    if (userId) {
      const progress = await fetchMediaProgress(userId, pubId);
      if (progress.pageId) {
        const idx = videoItems.findIndex((it) => it.mediaId === progress.pageId);
        if (idx >= 0) {
          videoInitialIndex = idx;
          videoInitialTime = progress.position;
        }
      }
    }
  }
}

const comments = pubId ? await fetchComments(userId, "PUBLICATION", pubId) : [];
const commentLabels = {
  title: t("comments.title"),
  placeholder: t("comments.placeholder"),
  post: t("comments.post"),
  reply: t("comments.reply"),
  replyTo: t("comments.replyTo"),
  cancel: t("comments.cancel"),
  signIn: t("comments.signIn"),
  empty: t("comments.empty"),
  pending: t("comments.pending"),
};
---

<Layout title={pub?.title ?? title}>
  {
    detail ? (
      <main>
        <div class="relative h-[340px] overflow-hidden">
          {cover && <img src={cover} alt="" draggable="false" class="h-full w-full select-none object-cover" style="-webkit-user-drag: none;" />}
          <div class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-transparent"></div>
        </div>

        <div class="mx-auto max-w-[1400px] px-12">
          <div class="-mt-24 grid gap-6 md:grid-cols-[200px_1fr]">
            <div class="hidden aspect-[2/3] overflow-hidden rounded-md border border-border shadow-lg md:block">
              {cover ? (
                <img src={cover} alt={pub!.title ?? ""} draggable="false" class="h-full w-full select-none object-cover" style="-webkit-user-drag: none;" />
              ) : (
                <div class="flex h-full items-center justify-center bg-surface text-3xl font-bold text-foreground-muted">
                  {(pub!.title ?? "?").charAt(0)}
                </div>
              )}
            </div>

            <div class="pt-28">
              <h1 class="font-serif text-4xl font-bold leading-tight tracking-tight">{pub!.title}</h1>

              <div class="mt-3 flex flex-wrap items-center gap-2 text-[13px] text-foreground-muted">
                {rating && (
                  <span class="rounded-full border border-success px-2.5 py-0.5 text-[11px] font-semibold text-success">
                    {rating}
                  </span>
                )}
                {pub!.format && (
                  <span class="rounded-full border border-border bg-surface px-2.5 py-0.5 text-[11px] font-semibold">
                    {pub!.format.replace(/_/g, " ")}
                  </span>
                )}
                {detail.creatorName && <span>{detail.creatorName}</span>}
              </div>

              {pub!.description && (
                <p class="mt-4 max-w-2xl text-sm leading-7 text-foreground-muted">{pub!.description}</p>
              )}

              <div class="mt-5">
                <SaveButton
                  client:load
                  publicationId={pubId}
                  saved={savedIds.has(pubId)}
                  saveLabel={t("library.save")}
                  savedLabel={t("library.saved")}
                />
              </div>

              <div class="mt-6">
                {
                  locked ? (
                    <SubscribeUpsell creatorId={pub?.creatorId} t={t} />
                  ) : allowed.length > 0 ? (
                    kind === "video" ? (
                      <VideoDetail
                        client:load
                        publicationId={pubId}
                        items={videoItems}
                        initialIndex={videoInitialIndex}
                        initialTime={videoInitialTime}
                        autoplay={autoplay}
                      />
                    ) : kind === "audio" ? (
                      <audio
                        controls
                        controlslist="nodownload"
                        preload="metadata"
                        src={allowed[0].url}
                        autoplay={autoplay}
                        class="w-full"
                      />
                    ) : (
                      <div class="grid gap-4 sm:grid-cols-2">
                        {allowed.map((m) => (
                          <ImageViewer
                            client:load
                            src={m.url}
                            alt={pub!.title ?? ""}
                            guarded
                            class="w-full rounded-md"
                          />
                        ))}
                      </div>
                    )
                  ) : (
                    <p class="rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
                      {t("media.unavailable")}
                    </p>
                  )
                }
              </div>
            </div>
          </div>
        </div>

        {pubId && (
          <div class="mx-auto max-w-[1400px] px-12">
            <Comments
              client:load
              targetType="PUBLICATION"
              targetId={pubId}
              initialComments={comments}
              signedIn={Boolean(userId)}
              labels={commentLabels}
            />
          </div>
        )}
      </main>
    ) : (
      <main class="mx-auto max-w-3xl px-6 py-24 text-center">
        <h1 class="text-3xl font-bold">{t("media.notFound")}</h1>
        <a href="/" class="mt-6 inline-block text-link">{t("story.backHome")}</a>
      </main>
    )
  }
</Layout>
