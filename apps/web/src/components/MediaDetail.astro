---
import Layout from "@/layouts/Layout.astro";
import Comments from "@/components/Comments.svelte";
import SubscribeUpsell from "@/components/SubscribeUpsell.astro";
import SaveButton from "@/components/SaveButton.svelte";
import ShareButton from "@/components/ShareButton.svelte";
import GateButton from "@/components/GateButton.svelte";
import { ImageViewer, MediaCarousel } from "@storygalore/ui";
import { fetchSeriesEpisodes, fetchMediaProgress, fetchComments, fetchSavedPublicationIds, fetchRecommendations } from "@/lib/gateway";
import type { PublicationDetail, SeriesEpisode } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const { t } = getTranslations(Astro.currentLocale);

interface Props {
  detail: PublicationDetail | null;
  kind: "video" | "audio" | "post" | "book";
  title: string;
}

const { detail, kind, title } = Astro.props;
const pub = detail?.publication;
const pubId = pub?.$id ?? "";
const allowed = (detail?.media ?? []).filter((m) => m.allowed && m.url);
const locked = Boolean(detail && !detail.entitled);
const cover = detail?.coverUrl;
const backdrop = detail?.backdropUrl ?? cover;
const rating =
  pub?.contentRating && pub.contentRating !== "ALL_AGES"
    ? pub.contentRating === "ADULT_18_PLUS"
      ? t("studio.editor.rating.adult")
      : t("studio.editor.rating.teen")
    : null;

/** Format milliseconds as "2h 14m", "48m", or "30s". */
function formatDuration(ms: number): string {
  if (!ms || ms <= 0) return "";
  const s = Math.floor(ms / 1000);
  const h = Math.floor(s / 3600);
  const m = Math.floor((s % 3600) / 60);
  const rem = s % 60;
  if (h > 0) return `${h}h ${String(m).padStart(2, "0")}m`;
  if (m > 0) return `${m}m`;
  return `${rem}s`;
}

const userId = Astro.locals.user?.$id ?? "";
const savedIds = userId ? await fetchSavedPublicationIds(userId) : new Set<string>();
const progress = userId && pubId ? await fetchMediaProgress(userId, pubId) : { position: 0, pageId: "" };
const resumeLabel = progress.position > 0 ? formatDuration(progress.position * 1000) : "";

const year = detail?.year;
const durationLabel = formatDuration(detail?.durationMs ?? 0);
const qualityRating = pub?.rating;
const genres = pub?.genres ?? [];

// The player route (play button target) for the current kind.
const playHref =
  kind === "video"
    ? `/watch/${pubId}/play`
    : kind === "audio"
      ? `/listen/${pubId}/play`
      : `/posts/${pubId}/play`;

// Episode panel (video, series) shows metadata even when delivery is gated.
let episodes: SeriesEpisode[] = [];
if (kind === "video" && pub?.seriesId && pubId) {
  episodes = await fetchSeriesEpisodes(pub.seriesId, userId);
}

// Related rail below the fold.
const related = pubId ? await fetchRecommendations(pubId) : [];

const comments = pubId ? await fetchComments(userId, "PUBLICATION", pubId) : [];
const commentLabels = {
  title: t("comments.title"),
  placeholder: t("comments.placeholder"),
  post: t("comments.post"),
  reply: t("comments.reply"),
  replyTo: t("comments.replyTo"),
  cancel: t("comments.cancel"),
  signIn: t("comments.signIn"),
  empty: t("comments.empty"),
  pending: t("comments.pending"),
};
---

<Layout title={pub?.title ?? title}>
  {
    detail ? (
      <main>
        <div class="relative h-[380px] overflow-hidden">
          {backdrop && <img src={backdrop} alt="" draggable="false" class="h-full w-full select-none object-cover object-top" style="-webkit-user-drag: none;" />}
          <div class="absolute inset-0 bg-gradient-to-t from-background via-background/40 to-transparent"></div>
        </div>

        <div class="mx-auto max-w-[1400px] px-12">
          <div class="grid gap-6 md:grid-cols-[200px_1fr]">
            <div class="relative z-10 -mt-24 hidden aspect-[2/3] overflow-hidden rounded-md border border-border bg-surface shadow-lg md:block">
              {cover ? (
                <img src={cover} alt={pub!.title ?? ""} draggable="false" class="h-full w-full select-none object-contain" style="-webkit-user-drag: none;" />
              ) : (
                <div class="flex h-full items-center justify-center bg-surface text-3xl font-bold text-foreground-muted">
                  {(pub!.title ?? "?").charAt(0)}
                </div>
              )}
            </div>

            <div class="pt-2">
              <h1 class="font-serif text-4xl font-bold leading-tight tracking-tight">{pub!.title}</h1>

              <div class="mt-3 flex flex-wrap items-center gap-2 text-[13px] text-foreground-muted">
                {qualityRating != null && (
                  <span class="rounded-full border border-border bg-surface px-2.5 py-0.5 text-[11px] font-semibold text-yellow-500">★ {qualityRating}</span>
                )}
                {rating && (
                  <span class="rounded-full border border-success px-2.5 py-0.5 text-[11px] font-semibold text-success">
                    {rating}
                  </span>
                )}
                {pub!.format && (
                  <span class="rounded-full border border-border bg-surface px-2.5 py-0.5 text-[11px] font-semibold">
                    {pub!.format.replace(/_/g, " ")}
                  </span>
                )}
                {year ? <span>{year}</span> : null}
                {durationLabel ? <span>·</span> : null}
                {durationLabel ? <span>{durationLabel}</span> : null}
                {genres.length > 0 ? <span>·</span> : null}
                {genres.length > 0 ? <span>{genres.join(" · ")}</span> : null}
                {detail.creatorName ? <span>·</span> : null}
                {detail.creatorName ? <span>{detail.creatorName}</span> : null}
              </div>

              {pub!.description && (
                <p class="mt-4 max-w-2xl text-sm leading-7 text-foreground-muted">{pub!.description}</p>
              )}

              <div class="mt-5 flex flex-wrap items-center gap-3">
                {
                  kind === "video" && (
                    locked ? (
                      <GateButton
                        client:load
                        dialogId="gate-dialog"
                        label={resumeLabel ? t("media.resumeFrom").replace("{time}", resumeLabel) : t("media.play")}
                      />
                    ) : (
                      <a
                        href={playHref}
                        class="inline-flex items-center gap-2 rounded-sm bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
                      >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M8 5v14l11-7z"></path>
                        </svg>
                        {resumeLabel ? t("media.resumeFrom").replace("{time}", resumeLabel) : t("media.play")}
                      </a>
                    )
                  )
                }
                {
                  kind === "book" && (
                    locked ? (
                      <GateButton client:load dialogId="gate-dialog" label={t("media.readNow")} icon="book" />
                    ) : (
                      <a
                        href={`/read/${pubId}`}
                        class="inline-flex items-center gap-2 rounded-sm bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
                      >
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                        </svg>
                        {t("media.readNow")}
                      </a>
                    )
                  )
                }
                <SaveButton
                  client:load
                  publicationId={pubId}
                  saved={savedIds.has(pubId)}
                  signedIn={Boolean(userId)}
                  saveLabel={t("media.myList")}
                  savedLabel={t("library.saved")}
                />
                <ShareButton client:load label={t("media.share")} copiedLabel={t("media.copied")} />
              </div>

              <div class="mt-6">
                {
                  kind === "audio" && !locked && allowed.length > 0 ? (
                    <audio
                      controls
                      controlslist="nodownload"
                      preload="metadata"
                      src={allowed[0].url}
                      class="w-full"
                    />
                  ) : kind === "post" && !locked && allowed.length > 0 ? (
                    <div class="grid gap-4 sm:grid-cols-2">
                      {allowed.map((m) => (
                        <ImageViewer
                          client:load
                          src={m.url}
                          alt={pub!.title ?? ""}
                          guarded
                          class="w-full rounded-md"
                        />
                      ))}
                    </div>
                  ) : kind !== "video" && kind !== "book" && !locked && allowed.length === 0 ? (
                    <p class="rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
                      {t("media.unavailable")}
                    </p>
                  ) : null
                }
              </div>
            </div>
          </div>

          {
            locked && (kind === "video" || kind === "book") && (
              <dialog
                id="gate-dialog"
                class="m-auto w-full max-w-lg rounded-md border border-border bg-surface p-6 shadow-xl backdrop:bg-black/60"
              >
                <div class="mb-3 flex justify-end">
                  <form method="dialog">
                    <button
                      type="submit"
                      aria-label="Close"
                      class="grid h-8 w-8 place-items-center rounded-full border border-border bg-surface text-foreground transition hover:bg-surface-elevated"
                    >
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 6L6 18M6 6l12 12"></path>
                      </svg>
                    </button>
                  </form>
                </div>
                <SubscribeUpsell creatorId={pub?.creatorId} t={t} />
              </dialog>
            )
          }

          {
            kind === "video" && !locked && episodes.length > 0 && (
              <div class="mt-10">
                <h3 class="text-lg font-bold tracking-tight">{t("media.episodes")} · {t("media.season").replace("{n}", "1")}</h3>
                <ul class="mt-3 grid gap-2">
                  {episodes.map((e, i) => (
                    <li>
                      <a
                        href={`/watch/${e.publicationId}`}
                        class="flex items-center gap-3 rounded-md border border-border bg-surface p-2 transition hover:bg-surface-elevated"
                      >
                        <div class="h-12 w-20 shrink-0 overflow-hidden rounded">
                          {e.coverUrl ? (
                            <img src={e.coverUrl} alt="" class="h-full w-full object-cover" />
                          ) : (
                            <div class="flex h-full w-full items-center justify-center bg-surface-elevated text-xs text-foreground-muted">
                              E{e.episodeNumber ?? i + 1}
                            </div>
                          )}
                        </div>
                        <div class="min-w-0 flex-1">
                          <div class="truncate text-sm font-medium">
                            E{e.episodeNumber ?? i + 1} · {e.title ?? `${t("media.episodeLabel")} ${e.episodeNumber ?? i + 1}`}
                          </div>
                          <div class="text-xs text-foreground-muted">{e.durationMs ? formatDuration(e.durationMs) : ""}</div>
                        </div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>

        {
          related.length > 0 && (
            <div class="mx-auto max-w-[1400px] px-12 py-12">
              <MediaCarousel client:load title={t("media.related")} items={related} />
            </div>
          )
        }

        {pubId && (
          <div class="mx-auto max-w-[1400px] px-12 pb-12">
            <Comments
              client:load
              targetType="PUBLICATION"
              targetId={pubId}
              initialComments={comments}
              signedIn={Boolean(userId)}
              labels={commentLabels}
            />
          </div>
        )}
      </main>
    ) : (
      <main class="mx-auto max-w-3xl px-6 py-24 text-center">
        <h1 class="text-3xl font-bold">{t("media.notFound")}</h1>
        <a href="/" class="mt-6 inline-block text-link">{t("story.backHome")}</a>
      </main>
    )
  }
</Layout>
