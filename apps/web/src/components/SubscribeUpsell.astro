---
import { actions } from "astro:actions";
import { fetchPlans } from "@/lib/gateway";
import type { MessageKey } from "@/i18n";

interface Props {
  /** The gated publication's creator, so the subscription is bound correctly. */
  creatorId?: string;
  t: (key: MessageKey) => string;
}

const { creatorId, t } = Astro.props;
const user = Astro.locals.user;
// plan_list is a public catalog (no auth required).
const plans = await fetchPlans("");
---

<div class="rounded-md border border-dashed border-border px-6 py-8">
  <p class="text-lg font-semibold">{t("media.locked")}</p>
  <p class="mt-1 text-sm text-foreground-muted">{t("media.subscribeTitle")}</p>

  {
    plans.length === 0 ? (
      <p class="mt-3 text-sm text-foreground-muted">{t("account.noPlans")}</p>
    ) : (
      <div class="mt-4 flex flex-wrap gap-4">
        {plans.map((plan) => (
          <div class="flex min-w-0 flex-1 flex-col rounded-sm border border-border bg-surface p-4">
            <h3 class="font-semibold">{plan.name}</h3>
            {plan.description && <p class="mt-1 text-sm text-foreground-muted">{plan.description}</p>}
            <p class="mt-2 text-lg font-bold">
              {((plan.amount ?? 0) / 100).toFixed(2)} {plan.currency}
              <span class="text-sm font-normal text-foreground-muted">
                {" "}
                / {(plan.billingInterval ?? "month").toLowerCase()}
              </span>
            </p>

            {
              user ? (
                <form method="POST" action={actions.subscribe} class="mt-auto space-y-3 pt-4">
                  <input type="hidden" name="planId" value={plan.$id} />
                  {creatorId && <input type="hidden" name="creatorId" value={creatorId} />}
                  <div>
                    <label for={`provider-${plan.$id}`} class="mb-1 block text-sm text-foreground-muted">
                      {t("account.payWith")}
                    </label>
                    <select
                      name="provider"
                      id={`provider-${plan.$id}`}
                      class="w-full rounded-sm border border-border bg-surface px-3 py-2 text-sm outline-none focus:border-primary"
                    >
                      <option value="STRIPE">{t("account.cardStripe")}</option>
                      <option value="NOWPAYMENTS">{t("account.cryptoNowPayments")}</option>
                    </select>
                  </div>
                  <button
                    type="submit"
                    class="rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
                  >
                    {t("account.subscribe")}
                  </button>
                </form>
              ) : (
                <button
                  type="button"
                  data-auth="signin"
                  class="mt-4 rounded-sm bg-primary px-4 py-2 font-semibold text-primary-foreground transition hover:opacity-90"
                >
                  {t("media.signInToSubscribe")}
                </button>
              )
            }
          </div>
        ))}
      </div>
    )
  }
</div>
