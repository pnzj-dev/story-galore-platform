---
import type { MessageKey } from "@/i18n";

interface Props {
  t: (key: MessageKey) => string;
}

interface NavItem {
  label: string;
  href: string;
  icon: "home" | "search" | "shorts" | "library" | "profile";
  active: boolean;
  requiresAuth?: boolean;
}

const { t } = Astro.props;
const pathname = Astro.url.pathname;
const user = Astro.locals.user;

const items: NavItem[] = [
  { label: t("nav.home"), href: "/", icon: "home", active: pathname === "/" },
  { label: t("mobile.search"), href: "/discover", icon: "search", active: pathname.startsWith("/discover") },
  { label: t("nav.shorts"), href: "/shorts", icon: "shorts", active: pathname.startsWith("/shorts") },
  { label: t("menu.library"), href: "/library", icon: "library", requiresAuth: true, active: pathname.startsWith("/library") },
  { label: t("mobile.profile"), href: "/account", icon: "profile", requiresAuth: true, active: pathname.startsWith("/account") || pathname.startsWith("/settings") },
];
---

<nav
  class="fixed inset-x-0 bottom-0 z-50 flex items-center justify-around border-t border-border bg-background/85 px-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] pt-2 backdrop-blur lg:hidden"
>
  {
    items.map((item) => {
      const cls = `flex flex-col items-center gap-0.5 rounded-md px-3 py-1 text-[9px] font-semibold transition ${
        item.active ? "text-brand-400" : "text-foreground-tertiary"
      }`;

      const icon = (
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          {item.icon === "home" && (
            <>
              <path d="M3 10.5 12 3l9 7.5"></path>
              <path d="M5 9.5V21h14V9.5"></path>
            </>
          )}
          {item.icon === "search" && (
            <>
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m20 20-3.5-3.5"></path>
            </>
          )}
          {item.icon === "shorts" && <path d="M8 5v14l11-7z"></path>}
          {item.icon === "library" && (
            <>
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </>
          )}
          {item.icon === "profile" && (
            <>
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M4 21c0-4 3.6-6 8-6s8 2 8 6"></path>
            </>
          )}
        </svg>
      );

      if (item.requiresAuth && !user) {
        return (
          <button type="button" data-auth="signin" class={cls}>
            {icon}
            {item.label}
          </button>
        );
      }

      return (
        <a href={item.href} aria-current={item.active ? "page" : undefined} class={cls}>
          {icon}
          {item.label}
        </a>
      );
    })
  }
</nav>
