---
import Layout from "@/layouts/Layout.astro";
import { MediaCard, mediaHref } from "@storygalore/ui";
import { fetchMediaByType, fetchAd } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

interface Props {
  title: string;
  description: string;
  type: string;
  format?: string;
  excludeFormat?: string;
}

const { title, description, type, format, excludeFormat } = Astro.props;
const { t } = getTranslations(Astro.currentLocale);

const LIMIT = 24;
const page = Math.max(1, parseInt(Astro.url.searchParams.get("page") ?? "1", 10) || 1);
const offset = (page - 1) * LIMIT;
const { items, hasMore } = await fetchMediaByType(type, { format, excludeFormat, limit: LIMIT, offset });
const ad = await fetchAd("DISCOVERY_FEED_BETWEEN_ITEMS", Astro.locals.user?.$id ?? "");

// Locale-aware pagination URL preserving the optional format filter.
function pageHref(p: number): string {
  const params = new URLSearchParams();
  if (p > 1) params.set("page", String(p));
  if (format) params.set("format", format);
  const qs = params.toString();
  return qs ? `${Astro.url.pathname}?${qs}` : Astro.url.pathname;
}
---

<Layout title={title}>
  <main class="mx-auto max-w-[1400px] px-12 py-12">
    <h1 class="text-3xl font-bold">{title}</h1>
    <p class="mt-2 text-foreground-muted">{description}</p>

    {ad?.url && (
      <div class="mt-6 rounded-md border border-border bg-surface/40 p-4">
        <span class="block pb-2 text-xs uppercase tracking-widest text-foreground-muted">{t("home.sponsored")}</span>
        <a href="#" class="block overflow-hidden rounded-sm border border-border">
          <img src={ad.url} alt={ad.name ?? "Sponsored"} class="h-32 w-full object-cover" />
        </a>
      </div>
    )}

    {
      items.length > 0 ? (
        <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
          {items.map((item) => (
            <MediaCard publication={item} href={mediaHref(item)} />
          ))}
        </div>
      ) : (
        <p class="mt-8 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
          {t("browse.noContent")}
        </p>
      )
    }

    {
      (page > 1 || hasMore) && (
        <nav class="mt-10 flex items-center justify-between">
          {page > 1 ? (
            <a
              href={pageHref(page - 1)}
              class="inline-flex items-center gap-1.5 rounded-sm border border-border bg-surface px-4 py-2 text-sm font-semibold transition hover:bg-surface-elevated"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"></path></svg>
              {t("nav.prev")}
            </a>
          ) : (
            <span></span>
          )}
          {hasMore ? (
            <a
              href={pageHref(page + 1)}
              class="inline-flex items-center gap-1.5 rounded-sm border border-border bg-surface px-4 py-2 text-sm font-semibold transition hover:bg-surface-elevated"
            >
              {t("nav.next")}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6"></path></svg>
            </a>
          ) : (
            <span></span>
          )}
        </nav>
      )
    }
  </main>
</Layout>
