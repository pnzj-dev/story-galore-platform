---
import Layout from "../layouts/Layout.astro";
import { MediaCard } from "@storygalore/ui";
import type { MediaCardData } from "@storygalore/ui";
import { fetchMediaByType } from "../lib/gateway";

interface Props {
  title: string;
  description: string;
  type: string;
  format?: string;
}

const { title, description, type, format } = Astro.props;
const items = await fetchMediaByType(type, format);

function hrefFor(item: MediaCardData): string {
  switch (item.type) {
    case "VIDEO":
      return `/watch/${item.id}`;
    case "AUDIO":
      return `/listen/${item.id}`;
    case "POST":
      return `/posts/${item.id}`;
    default:
      return `/read/${item.id}`;
  }
}
---

<Layout title={title}>
  <main class="mx-auto max-w-7xl px-6 py-12">
    <h1 class="text-3xl font-bold">{title}</h1>
    <p class="mt-2 text-foreground-muted">{description}</p>

    {
      items.length > 0 ? (
        <div class="mt-8 flex flex-wrap gap-4">
          {items.map((item) => (
            <MediaCard publication={item} href={hrefFor(item)} />
          ))}
        </div>
      ) : (
        <p class="mt-8 rounded-xl border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
          No content yet. Check back soon.
        </p>
      )
    }
  </main>
</Layout>
