---
import { getTranslations } from "@/i18n";

interface Props {
  projectId: string;
  active?: string;
}

const { projectId, active = "" } = Astro.props;
const { t } = getTranslations(Astro.currentLocale);

const TABS = [
  { key: "", label: t("studio.tab.overview") },
  { key: "story-bible", label: t("studio.tab.storyBible") },
  { key: "characters", label: t("studio.tab.characters") },
  { key: "world", label: t("studio.tab.world") },
  { key: "assets", label: t("studio.tab.assets") },
  { key: "prompts", label: t("studio.tab.prompts") },
  { key: "ai", label: t("studio.tab.ai") },
  { key: "drafts", label: t("studio.tab.drafts") },
  { key: "publications", label: t("studio.tab.publications") },
  { key: "analytics", label: t("studio.tab.analytics") },
];
---

<nav class="flex flex-wrap gap-1 border-b border-border pb-2">
  {
    TABS.map((tab) => (
      <a
        href={tab.key ? `/studio/projects/${projectId}/${tab.key}` : `/studio/projects/${projectId}`}
        class={`rounded-sm px-3 py-1.5 text-sm transition ${
          active === tab.key
            ? "bg-surface-elevated font-medium text-foreground"
            : "text-foreground-muted hover:bg-surface-elevated hover:text-foreground"
        }`}
      >
        {tab.label}
      </a>
    ))
  }
</nav>
