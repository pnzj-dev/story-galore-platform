---
import { createServerClient } from "@storygalore/appwrite-client";
import { OAuthProvider } from "@storygalore/appwrite-client";
import { getTranslations } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

const { t } = getTranslations(Astro.currentLocale);
const endpoint = import.meta.env.PUBLIC_APPWRITE_ENDPOINT;
const projectId = import.meta.env.PUBLIC_APPWRITE_PROJECT_ID;

const success = new URL(
  getRelativeLocaleUrl(Astro.currentLocale!, "auth/callback"),
  Astro.site ?? Astro.url.origin,
).toString();
const failure = new URL(
  getRelativeLocaleUrl(Astro.currentLocale!, "auth/login"),
  Astro.site ?? Astro.url.origin,
).toString();

const { account } = createServerClient({ endpoint, projectId });

const providers = [
  { id: OAuthProvider.Google, label: t("auth.oauthGoogle") },
  { id: OAuthProvider.Github, label: t("auth.oauthGithub") },
  { id: OAuthProvider.Discord, label: t("auth.oauthDiscord") },
];

const links = providers.map((p) => ({
  id: p.id,
  label: p.label,
  url: account.createOAuth2Session(p.id, success, failure) as string,
}));
---

<div class="mt-6">
  <p class="text-center text-xs text-foreground-muted">{t("auth.continueWith")}</p>
  <div class="mt-3 space-y-2">
    {links.map((p) => (
      <a
        href={p.url}
        class="flex w-full items-center justify-center rounded-sm border border-border px-4 py-2 text-sm font-medium transition hover:bg-surface"
      >
        {p.label}
      </a>
    ))}
  </div>
</div>
