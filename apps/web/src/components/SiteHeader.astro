---
import { ThemeToggle } from "@storygalore/ui";
import NotificationCenter from "@/components/NotificationCenter.svelte";
import UserMenu from "@/components/UserMenu.svelte";
import LocaleSwitcher from "@/components/LocaleSwitcher.astro";
import { fetchNotifications, fetchCreator } from "@/lib/gateway";
import { getRelativeLocaleUrl } from "astro:i18n";
import { stripLocalePrefix } from "@/i18n";
import { DEFAULT_LOCALE } from "@/i18n/languages";
import type { MessageKey } from "@/i18n";

interface Props {
  t: (key: MessageKey) => string;
}

const { t } = Astro.props;

const user = Astro.locals.user;
const currentLocale = Astro.currentLocale ?? DEFAULT_LOCALE;
const pathname = Astro.url.pathname;
const path = stripLocalePrefix(pathname);

const notifications = user ? await fetchNotifications(user.$id) : [];
const isCreator = user ? Boolean(await fetchCreator(user.$id)) : false;

const navItems = [
  { label: t("nav.home"), href: getRelativeLocaleUrl(currentLocale, "/"), active: path === "/" },
  { label: t("nav.videos"), href: getRelativeLocaleUrl(currentLocale, "/videos"), active: path.startsWith("/videos") },
  { label: t("nav.shorts"), href: getRelativeLocaleUrl(currentLocale, "/shorts"), active: path.startsWith("/shorts") },
  { label: t("nav.books"), href: getRelativeLocaleUrl(currentLocale, "/books"), active: path.startsWith("/books") },
  { label: t("nav.images"), href: getRelativeLocaleUrl(currentLocale, "/images"), active: path.startsWith("/images") },
  { label: t("nav.audio"), href: getRelativeLocaleUrl(currentLocale, "/audio"), active: path.startsWith("/audio") },
];

const initial = (user?.name ?? user?.email ?? "A").trim().charAt(0).toUpperCase();
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-[20px]">
  <nav class="mx-auto flex max-w-[1400px] items-center gap-6 px-6 py-4">
    <a href={getRelativeLocaleUrl(currentLocale, "/")} class="flex shrink-0 items-center gap-2 text-lg font-extrabold tracking-tight">
      <span
        class="grid h-[26px] w-[26px] place-items-center rounded-[7px] bg-gradient-to-br from-brand-500 to-accent text-[13px] font-black text-white"
      >
        SG
      </span>
      StoryGalore
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            class={`rounded-sm px-3 py-2 text-[13px] font-medium transition ${
              item.active
                ? "bg-surface text-foreground"
                : "text-foreground-muted hover:bg-surface hover:text-foreground"
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="ml-auto flex items-center gap-3">
      <a
        href={getRelativeLocaleUrl(currentLocale, "/discover")}
        class="hidden w-60 items-center gap-2 whitespace-nowrap rounded-full border border-border bg-surface px-4 py-2 text-[13px] text-foreground-tertiary transition hover:border-border-strong lg:flex"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        {t("nav.search")}
      </a>

      {user && (
        <NotificationCenter
          client:load
          items={notifications}
          title={t("notif.title")}
          markAllReadLabel={t("notif.markAllRead")}
          allLabel={t("notif.all")}
          unreadLabel={t("notif.unread")}
          emptyLabel={t("notif.noNotifications")}
          preferencesLabel={t("notif.preferences")}
        />
      )}

      <LocaleSwitcher />

      <ThemeToggle client:load />

      {
        user ? (
          <UserMenu
            client:load
            initial={initial}
            name={user.name ?? undefined}
            email={user.email ?? undefined}
            isCreator={isCreator}
            accountLabel={t("menu.account")}
            libraryLabel={t("menu.library")}
            settingsLabel={t("menu.settings")}
            billingLabel={t("menu.billing")}
            studioLabel={t("menu.creatorStudio")}
            signOutLabel={t("menu.signOut")}
          />
        ) : (
          <>
            <button
              type="button"
              data-auth="signin"
              class="text-sm text-foreground-muted transition hover:text-foreground"
            >
              {t("nav.signIn")}
            </button>
            <button
              type="button"
              data-auth="register"
              class="rounded-sm bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
            >
              {t("nav.getStarted")}
            </button>
          </>
        )
      }
    </div>
  </nav>
</header>
