---
import { ThemeToggle } from "@storygalore/ui";
import { actions } from "astro:actions";

const user = Astro.locals.user;
const pathname = Astro.url.pathname;

const navItems = [
  { label: "Home", href: "/", active: pathname === "/" },
  { label: "Videos", href: "/videos", active: pathname.startsWith("/videos") },
  { label: "Shorts", href: "/shorts", active: pathname.startsWith("/shorts") },
  { label: "Books", href: "/books", active: pathname.startsWith("/books") },
  { label: "Images", href: "/images", active: pathname.startsWith("/images") },
  { label: "Audio", href: "/audio", active: pathname.startsWith("/audio") },
];

const initial = (user?.name ?? user?.email ?? "A").trim().charAt(0).toUpperCase();
---

<header class="sticky top-0 z-50 border-b border-border bg-background/80 backdrop-blur-[20px]">
  <nav class="mx-auto flex max-w-[1400px] items-center gap-6 px-6 py-4">
    <a href="/" class="flex shrink-0 items-center gap-2 text-lg font-extrabold tracking-tight">
      <span
        class="grid h-[26px] w-[26px] place-items-center rounded-[7px] bg-gradient-to-br from-brand-500 to-accent text-[13px] font-black text-white"
      >
        SG
      </span>
      StoryGalore
    </a>

    <div class="hidden items-center gap-1 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={item.active ? "page" : undefined}
            class={`rounded-sm px-3 py-2 text-[13px] font-medium transition ${
              item.active
                ? "bg-surface text-foreground"
                : "text-foreground-muted hover:bg-surface hover:text-foreground"
            }`}
          >
            {item.label}
          </a>
        ))
      }
    </div>

    <div class="ml-auto flex items-center gap-3">
      <a
        href="/discover"
        class="hidden w-60 items-center gap-2 whitespace-nowrap rounded-full border border-border bg-surface px-4 py-2 text-[13px] text-foreground-tertiary transition hover:border-border-strong lg:flex"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
        >
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        Search…
      </a>

      {user && (
        <a
          href="/account"
          aria-label="Notifications"
          class="relative grid h-[38px] w-[38px] place-items-center rounded-full border border-border bg-surface text-foreground transition hover:bg-surface-elevated"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M6 8a6 6 0 1 1 12 0c0 7 3 9 3 9H3s3-2 3-9"></path>
            <path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"></path>
          </svg>
        </a>
      )}

      <ThemeToggle client:load />

      {
        user ? (
          <>
            <a
              href="/account/billing"
              class="grid h-[38px] w-[38px] place-items-center rounded-full border border-border bg-gradient-to-br from-brand-500 to-accent text-sm font-bold text-white"
              aria-label="Account"
            >
              {initial}
            </a>
            <form method="POST" action={actions.logout}>
              <button type="submit" class="text-sm text-foreground-muted transition hover:text-foreground">
                Sign out
              </button>
            </form>
          </>
        ) : (
          <>
            <button
              type="button"
              data-auth="signin"
              class="text-sm text-foreground-muted transition hover:text-foreground"
            >
              Sign in
            </button>
            <button
              type="button"
              data-auth="register"
              class="rounded-sm bg-primary px-4 py-2 text-sm font-semibold text-primary-foreground transition hover:opacity-90"
            >
              Get started
            </button>
          </>
        )
      }
    </div>
  </nav>
</header>
