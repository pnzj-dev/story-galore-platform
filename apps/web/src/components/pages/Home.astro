---
import Layout from "@/layouts/Layout.astro";
import { MediaRail, ShortCard } from "@storygalore/ui";
import { fetchContinueItems, fetchMediaByType, fetchAd, fetchRecommendations, fetchEnabledFlagKeys } from "@/lib/gateway";
import { getTranslations } from "@/i18n";

const title = "StoryGalore";
const description =
  "Read, watch, and listen to serialized stories from independent creators — books first, and every other medium too.";

const { t } = getTranslations(Astro.currentLocale);

const user = Astro.locals.user;
const continueItems = user ? await fetchContinueItems(user.$id) : [];

const videoItems = (await fetchMediaByType("VIDEO")).filter((i) => i.format !== "SHORT_FILM");
const bookItems = await fetchMediaByType("BOOK");
const shortItems = await fetchMediaByType("VIDEO", "SHORT_FILM");
const recommendedItems = await fetchRecommendations();
const enabledFlags = await fetchEnabledFlagKeys(user?.$id ?? "");
const showShorts = enabledFlags.has("video.shorts");
const homeAd = await fetchAd("HOME_FEED_BETWEEN_RAILS", user?.$id ?? "");

function hrefFor(item: { id: string; type: string }): string {
  switch (item.type) {
    case "VIDEO":
      return `/watch/${item.id}`;
    case "AUDIO":
      return `/listen/${item.id}`;
    case "POST":
      return `/posts/${item.id}`;
    default:
      return `/read/${item.id}`;
  }
}

// Continue-watching cards go straight to the player (auto-play + resume).
function playHrefFor(item: { id: string; type: string }): string {
  switch (item.type) {
    case "VIDEO":
      return `/watch/${item.id}?autoplay=1`;
    case "AUDIO":
      return `/listen/${item.id}?autoplay=1`;
    case "POST":
      return `/posts/${item.id}?autoplay=1`;
    default:
      return `/read/${item.id}`;
  }
}

const featured = videoItems[0] ?? bookItems[0];
const featuredHref = featured ? hrefFor(featured) : "/discover";
const featuredRating =
  featured && featured.contentRating && featured.contentRating !== "ALL_AGES"
    ? featured.contentRating
    : null;
---

<Layout title={`${title} — Read. Create. Discover.`} description={description}>
  <main>
    <!-- Cinematic hero billboard -->
    {
      featured ? (
        <section class="relative h-[62vh] min-h-[320px] overflow-hidden md:h-[420px]">
          <div
            class="absolute inset-0 bg-cover bg-[center_30%]"
            style={`background-image:url('${featured.coverUrl}')`}
          ></div>
          <div class="absolute inset-0 bg-gradient-to-r from-background via-background/75 to-background/10"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-background via-background/60 to-transparent"></div>

          <div class="relative z-10 mx-auto flex h-full max-w-[1400px] items-end px-12 pb-12">
            <div class="max-w-[620px]">
              <span
                class="mb-4 inline-flex items-center gap-2 rounded-full bg-brand-500/15 px-2.5 py-[5px] text-[11px] font-bold uppercase tracking-widest text-brand-400"
              >
                <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z"></path>
                </svg>
                Featured {featured.type === "VIDEO" ? t("home.featuredFilm") : t("home.featuredStory")}
              </span>

              <h1 class="font-serif text-5xl font-bold leading-[1.05] tracking-tight">{featured.title}</h1>

              <div class="mt-4 flex flex-wrap items-center gap-3 text-[13px] text-foreground-muted">
                {featuredRating && (
                  <span class="rounded border border-border-strong px-1.5 py-0.5 text-[11px] font-semibold">
                    {featuredRating === "ADULT_18_PLUS" ? "18+" : featuredRating === "TEEN" ? "Teen" : featuredRating}
                  </span>
                )}
                {featured.format && <span>{featured.format.replace(/_/g, " ")}</span>}
                {featured.creatorName && (
                  <>
                    <span class="h-0.5 w-0.5 rounded-full bg-foreground-tertiary"></span>
                    <span>{featured.creatorName}</span>
                  </>
                )}
              </div>

              <p class="mt-4 max-w-[520px] text-sm leading-6 text-foreground-muted">{description}</p>

              <div class="mt-5 flex gap-3">
                <a
                  href={featuredHref}
                  class="inline-flex items-center gap-2 rounded-sm bg-primary px-5 py-3 text-[13px] font-semibold text-primary-foreground transition hover:opacity-90"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"></path>
                  </svg>
                  {t("home.play")}
                </a>
                {
                  user ? (
                    <a
                      href="/library"
                      class="inline-flex items-center gap-2 rounded-sm border border-border-strong bg-surface-raised px-5 py-3 text-[13px] font-semibold text-foreground transition hover:bg-surface"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 5v14M5 12h14"></path>
                      </svg>
                      {t("home.myList")}
                    </a>
                  ) : (
                    <button
                      type="button"
                      data-auth="signin"
                      class="inline-flex items-center gap-2 rounded-sm border border-border-strong bg-surface-raised px-5 py-3 text-[13px] font-semibold text-foreground transition hover:bg-surface"
                    >
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 5v14M5 12h14"></path>
                      </svg>
                      {t("home.myList")}
                    </button>
                  )
                }
              </div>
            </div>
          </div>
        </section>
      ) : (
        <section class="border-b border-border">
          <div class="mx-auto max-w-[1400px] px-12 py-16">
            <h1 class="font-serif text-4xl font-bold tracking-tight">Stories that pull you in.</h1>
            <p class="mt-3 text-foreground-muted">{description}</p>
          </div>
        </section>
      )
    }

    <section class="mx-auto max-w-[1400px] space-y-12 px-12 py-12">
      {
        user && continueItems.length > 0 && (
          <MediaRail
            client:load
            title={t("home.continueWatching")}
            items={continueItems}
            getHref={playHrefFor}
          />
        )
      }

      {homeAd?.url && (
        <div class="rounded-md border border-border bg-surface/40 p-4">
          <span class="block pb-2 text-xs uppercase tracking-widest text-foreground-muted">{t("home.sponsored")}</span>
          <a href="#" class="block overflow-hidden rounded-sm border border-border">
            <img src={homeAd.url} alt={homeAd.name ?? "Sponsored"} class="h-32 w-full object-cover" />
          </a>
        </div>
      )}

      <MediaRail client:load title={t("home.trendingMovies")} items={videoItems} />
      <MediaRail client:load title={t("home.trendingBooks")} items={bookItems} />

      {recommendedItems.length > 0 && (
        <MediaRail client:load title={t("home.recommended")} items={recommendedItems} />
      )}

      {showShorts && shortItems.length > 0 && (
        <section class="space-y-4">
          <div class="flex items-baseline justify-between">
            <h3 class="text-lg font-bold tracking-tight">{t("home.shorts")}</h3>
            <a href="/shorts" class="text-[12px] font-semibold text-foreground-muted transition hover:text-brand-400">
              {t("home.seeAll")}
            </a>
          </div>
          <div class="grid grid-cols-3 gap-4 sm:grid-cols-4 lg:grid-cols-6">
            {shortItems.map((item) => (
              <ShortCard publication={item} href={`/shorts/play/${item.id}`} />
            ))}
          </div>
        </section>
      )}
    </section>
  </main>
</Layout>
