---
import { SUPPORTED_LOCALES, LANGUAGES, DEFAULT_LOCALE } from "@/i18n/languages";
import { stripLocalePrefix } from "@/i18n";
import { getRelativeLocaleUrl } from "astro:i18n";

const current = Astro.currentLocale ?? DEFAULT_LOCALE;
const path = stripLocalePrefix(Astro.url.pathname);
const currentRecord = LANGUAGES[current] ?? LANGUAGES[DEFAULT_LOCALE];
---

<details class="group relative">
  <summary
    class="flex cursor-pointer list-none items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-2 text-[13px] font-semibold text-foreground transition hover:bg-surface-elevated [&::-webkit-details-marker]:hidden"
    aria-label="Change language"
  >
    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18"></path>
      <path d="M12 3a15 15 0 0 1 0 18"></path>
      <path d="M12 3a15 15 0 0 0 0 18"></path>
    </svg>
    {currentRecord.nativeName}
  </summary>

  <div class="absolute end-0 top-full z-50 mt-2 w-40 overflow-hidden rounded-md border border-border bg-surface shadow-lg">
    {
      SUPPORTED_LOCALES.map((loc) => {
        const rec = LANGUAGES[loc];
        const active = loc === current;
        return (
          <a
            href={getRelativeLocaleUrl(loc, path)}
            aria-current={active ? "true" : undefined}
            class={`block px-4 py-2 text-sm transition hover:bg-surface-elevated ${
              active ? "font-semibold text-brand-400" : "text-foreground"
            }`}
          >
            {rec.nativeName}
          </a>
        );
      })
    }
  </div>
</details>
