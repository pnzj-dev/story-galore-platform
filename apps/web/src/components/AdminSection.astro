---
interface Metric {
  label: string;
  value: string | number;
}

interface Section {
  title: string;
  entries: Record<string, number>;
}

interface Props {
  title: string;
  metrics: Metric[];
  sections: Section[];
  empty?: boolean;
  emptyText?: string;
}

const { title, metrics = [], sections = [], empty = false, emptyText } = Astro.props;
---

<main class="mx-auto max-w-[1600px] px-6 py-10">
  <header>
    <h1 class="text-3xl font-bold">{title}</h1>
  </header>

  {metrics.length > 0 && (
    <div class="mt-8 grid gap-4 sm:grid-cols-2 md:grid-cols-4">
      {metrics.map((m) => (
        <div class="rounded-md border border-border bg-surface p-4">
          <p class="text-2xl font-bold tabular-nums">{m.value}</p>
          <p class="text-sm text-foreground-muted">{m.label}</p>
        </div>
      ))}
    </div>
  )}

  {sections.length > 0 && (
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {sections.map((s) => (
        <div class="rounded-md border border-border bg-surface p-4">
          <h2 class="font-semibold text-foreground">{s.title}</h2>
          <ul class="mt-3 space-y-1">
            {Object.entries(s.entries).map(([key, value]) => (
              <li class="flex justify-between text-sm">
                <span class="text-foreground-muted">{key}</span>
                <span class="font-semibold tabular-nums">{value}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  )}

  {empty && metrics.length === 0 && sections.length === 0 && (
    <p class="mt-8 rounded-md border border-dashed border-border px-6 py-8 text-sm text-foreground-muted">
      {emptyText ?? "No data available yet."}
    </p>
  )}
</main>
