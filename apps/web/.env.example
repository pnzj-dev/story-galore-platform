# StoryGalore web app (apps/web) runtime configuration.
# Copy to .env and fill in real values. .env is git-ignored.

# Public Appwrite endpoint + project ID (browser-visible; NOT secret)
PUBLIC_APPWRITE_ENDPOINT=
PUBLIC_APPWRITE_PROJECT_ID=

# Appwrite API key (server-side only) used to invoke the `api` gateway function.
# Must have the `executions.write` scope. Never exposed to the browser.
APPWRITE_API_KEY=
