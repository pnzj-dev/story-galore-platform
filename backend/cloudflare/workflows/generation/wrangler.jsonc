{
  "name": "storygalore-generation",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["enable_ctx_exports"],
  "observability": { "enabled": true },
  "ai": {
    "binding": "AI"
